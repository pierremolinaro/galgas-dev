syntax LL1_expression_syntax : LL1_expression_lexique, #translatable {

rule <StartSymbol> () {
  <Expression> (?let @cExpression expressionTree, ?let @u32 value)
  println (expressionTree.description)
  println (value)
}

rule <Constant>
  (!@cExpression outExpressionTree,
  !@u32 outValue ) {
  $number$ (?let @lu32 cst)
  send " "
  outExpressionTree = @cConst ( cst)
  outValue = cst.u32
}

rule <Expression>
  (!@cExpression outExpressionTree,
  !@u32 outValue ) {
  <Terme> (?outExpressionTree, ?outValue)
  repeat
  while
    $+$ :> (?let @string sep) (?let @string token)
    send sep
    <Terme> (?let @cExpression rightOperand, ?let @u32 v)
    send token
    outExpressionTree = @cAdd (  outExpressionTree , rightOperand)
    outValue = outValue + v
  end
}

rule <Terme>
  (!@cExpression outExpressionTree,
  !@u32 outValue ) {
  <Facteur> (?outExpressionTree, ?outValue)
  repeat
  while
    $*$ :> (?let @string sep) (?let @string token)
    send sep
    <Facteur> (?let @cExpression rightOperand, ?let @u32 v)
    send token
    outExpressionTree = @cMult (  outExpressionTree , rightOperand)
    outValue = outValue * v
  end
}

rule <Facteur> (!@cExpression outExpressionTree,
                !@u32 outValue) {
  select
    $($ :> (?*) (?*)
    <Expression> (?outExpressionTree, ?outValue)
    $)$ :> (?*) (?*)
  or
    <Constant> (?outExpressionTree, ?outValue)
  end
}

}
