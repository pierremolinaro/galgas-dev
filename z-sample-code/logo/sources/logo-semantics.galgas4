//--------------------------------------------------------------------------------------------------

filewrapper @generationTemplate : "." {
  template svg : "logo-svg.galgasTemplate" (
    ?@string TITLE,
    ?@string DRAWINGS
  )
}

//--------------------------------------------------------------------------------------------------

map @routineMap {
  public let [@instruction] mInstructionList
  #insertSetter insertKey #errorMessage "the '%K' routine has been already declared"
  #searchMethod searchKey #errorMessage "the '%K' routine is not declared"
}

//--------------------------------------------------------------------------------------------------

abstract class @instruction {

  abstract proc codeDisplay (?!@bool ioPenDown,
                             ?!@f64 _ioX,
                             ?!@f64 _ioY,
                             ?!@f64 _ioAngle,
                             ?!@string _SVG)

}

//--------------------------------------------------------------------------------------------------

final class @penUp : @instruction {
}

//--------------------------------------------------------------------------------------------------

override proc @penUp.codeDisplay
  (?!@bool ioPenDown,
  ?!@f64 _ioX,
  ?!@f64 _ioY,
  ?!@f64 _ioAngle,
  ?!@string _SVG
) {
  ioPenDown = false
}

//--------------------------------------------------------------------------------------------------

final class @penDown : @instruction {
}

//--------------------------------------------------------------------------------------------------

override proc @penDown.codeDisplay
  (?!@bool ioPenDown,
  ?!@f64 _ioX,
  ?!@f64 _ioY,
  ?!@f64 _ioAngle,
  ?!@string _SVG
) {
  ioPenDown = true
}

//--------------------------------------------------------------------------------------------------

final class @rotate : @instruction {
  public let @lu32 mAngle
}

//--------------------------------------------------------------------------------------------------

override proc @rotate.codeDisplay
  (?!@bool _ioPenDown,
  ?!@f64 _ioX,
  ?!@f64 _ioY,
  ?!@f64 ioAngle,
  ?!@string _SVG
) {
  ioAngle = ioAngle + self.mAngle.u32.f64
}

//--------------------------------------------------------------------------------------------------

final class @forward : @instruction {
  public let @lu32 mLength
}

//--------------------------------------------------------------------------------------------------

override proc @forward.codeDisplay
  (?!@bool ioPenDown,
  ?!@f64 ioX,
  ?!@f64 ioY,
  ?!@f64 ioAngle,
  ?!@string SVG
) {
  let @f64 x = ioX + self.mLength.f64 () * ioAngle.cosDegree
  let @f64 y = ioY + self.mLength.f64 () * ioAngle.sinDegree
  if ioPenDown then
    SVG += "<line x1=\"" + ioX + "\" y1=\"" + ioY + "\" x2=\"" + x + "\" y2=\""
        + y + "\" style=\"stroke:#1F56D2\" stroke-linecap=\"round\" />\n"
  end
  ioX = x
  ioY = y
}

//--------------------------------------------------------------------------------------------------
