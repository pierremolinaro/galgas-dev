syntax SLR_expression_syntax : SLR_expression_lexique {

rule <StartSymbol> ()

rule <Expression>
  (!@cExpression outExpressionTree,
  !@u32 outValue)

rule <Terme>
  (!@cExpression outExpressionTree,
  !@u32 outValue)

rule <Facteur>
  (!@cExpression outExpressionTree,
  !@u32 outValue)

rule <Constant>
  (!@cExpression outExpressionTree,
  !@u32 outValue)

rule <StartSymbol> () {
  <Expression> (?let _expressionTree, ?let value)
  println (value)
}

rule <Constant>
  (!@cExpression outExpressionTree,
  !@u32 outValue ) {
  $number$ (?let cst)
  outExpressionTree = @cConst ( cst)
  outValue = cst.u32
}

rule <Expression>
  (!@cExpression outExpressionTree,
  !@u32 outValue ) {
  select
    <Terme> (?outExpressionTree, ?outValue)
  or
    <Expression> (?outExpressionTree, ?outValue)
    $+$
    <Terme> (?let rightOperand, ?let v)
    outExpressionTree = @cAdd (  outExpressionTree , rightOperand)
    outValue = outValue + v
  end
}

rule <Terme>
  (!@cExpression outExpressionTree,
  !@u32 outValue ) {
  select
    <Facteur> (?outExpressionTree, ?outValue)
  or
    <Terme> (?outExpressionTree, ?outValue)
    $*$
    <Facteur> (?let rightOperand, ?let v)
    outExpressionTree = @cAdd (  outExpressionTree , rightOperand)
    outValue = outValue * v
  end
}

rule <Facteur>
  (!@cExpression outExpressionTree,
  !@u32 outValue ) {
  select
    $($
    <Expression> (?outExpressionTree, ?outValue)
    $)$
  or
    <Constant> (?outExpressionTree, ?outValue)
  end
}

}
