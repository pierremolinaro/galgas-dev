//-----------------------------------------------------------------------------------------------

class @classeA {
  public let @u32 x
}

//-----------------------------------------------------------------------------------------------

final class @classeB {
  private let @u32 x

  init (?@u32 inX) { self.x = inX }
  init (?x: let @u32 inX) { self.x = inX }
}

//-----------------------------------------------------------------------------------------------

class @classeC {
  public var @u32 x = 7
}

//-----------------------------------------------------------------------------------------------

final class @classeD {
  public let @u32 x = 9

  init (?let @u32 inX) { self.x = inX }
  init (?x: let @u32 inX) { self.x = inX }
}

//-----------------------------------------------------------------------------------------------

class @classeE : @classeA {
  private let @u32 y

}

//-----------------------------------------------------------------------------------------------

final class @classeF : @classeC {
  private let @u32 y
}

//-----------------------------------------------------------------------------------------------

final class @classeG : @classeC {
  private let @u32 y = 67
}

//-----------------------------------------------------------------------------------------------

final class @classeH : @classeA {
  public let @u32 y

  init (?let @u32 inX, ?let @u32 inY) {
    self.y = inY
    super.init (inX)
  }
}

//-----------------------------------------------------------------------------------------------

final class @classeI : @classeC {
  public let @u32 y
  public var @classeH? z = nil

  init (let @u32 inY) {
    self.y = inY
    super.init ()
  }
}

//-----------------------------------------------------------------------------------------------

proc testsuite_reference_class () {
  println ("*************************************** begin of reference classe test")
  var a = @classeI (5)
  println (a.x)
  println (a.y)
  a.z = @classeH (9, 11)
  var @classeH? b = @classeH (13, 17)
  a.z = b
  a.z = nil
  b = a.z
  println ("*************************************** end of reference classe test")
}

//-----------------------------------------------------------------------------------------------
