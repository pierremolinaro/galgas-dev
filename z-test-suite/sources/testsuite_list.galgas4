

extern proc testsuite_hand_coded ()

extension [@string] : #equatable {
}

proc testsuite_list() {
  var strList = [@string] []
  !?strList.append ("a")
  !?strList.append ("b")
  !?strList.append ("c")
  !?strList.append ("d")
  println ("*************************************** begin of list direct access")
  var @string s = strList [0]
  println (s.description)
  s = strList [1]
  println (s.description)
  s = strList [2]
  println (s.description)
  s = strList [3]
  println (s.description)
  !?strList.set ("z", !at: 3)
  println (strList.description)
  println ("--- test .= operator on list")
  strList += strList
  println (s.description)
  println ("*************************************** begin of list compare")
  let aList = [@string] ["az"]
  let bList = [@string] ["az"]
  let @bool comp = aList == bList
  println (comp.description)
  println ("*************************************** begin of collection value")
  var s1 = [@string] ["a"]
  !?s1.append ("b")
  var s2 = [@string] ["c"]
  !?s2.append ("d")
  s2 += ["e"]
  let str = s1 + s2
  println (str.description)
  let str2 = [@string] ["a", "b", "c", "d", "e"]
  println (str2.description)
}

