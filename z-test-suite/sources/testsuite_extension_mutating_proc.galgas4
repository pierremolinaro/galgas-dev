

proc testsuite_extension_mutating_proc () {
  println ("*************************************** begin of mutating proc test")
  var @u32 v = 12
  !?v.initialize (179)
  println ("v = " + v + "")
  !?v.autreInit (183)
  println ("v = " + v + "")
  !?v.init3 (752)
  println ("v = " + v + "")
}

mutating proc @u32.initialize (let @u32 inValue) {
  self = inValue
}

mutating proc @u32.autreInit (let @u32 inValue) {
  !?self.initialize (inValue)
}

mutating proc @u32.init3 (let @u32 inValue) {
  myInitProc (?self, inValue)
}

proc myInitProc (!@u32 outValue, let @u32 inValue) {
  outValue = inValue
}

