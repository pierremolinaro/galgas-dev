

final class @TestExtensionMethod { }

proc @TestExtensionMethod.method1() {
}

func @TestExtensionMethod.reader1() -> @u32 {
  result = 2
}

proc @TestExtensionMethod.method2 (!@u32 result) {
  result = self.reader1
}

proc testsuite_extension_methods () {
  println ("*************************************** begin of extension procs")
  let c = @TestExtensionMethod ()
  c.method1 ()
  c.method2 (?let v)
  println (v.string)
}
