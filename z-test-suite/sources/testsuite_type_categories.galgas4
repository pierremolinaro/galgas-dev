

proc testsuite_type_categories() {
  println ("*************************************** begin of type extension test")
  print ("Square of 7") ; println (7 .u64.square.description)
  var aList = [@uint] []
  !?aList.append (1)
  !?aList.append (2)
  !?aList.append (3)
  !?aList.append (4)
  print ("Sum 1 + 2 + 3 + 4") ; println (aList.sum.description)
  print ("Hello !") ; println (@lstring ("Hello", .here).op.description)
  let @u64 v
  let cst = 7
  cst.u64.square (?v)
  println (v.description)
  let @uint u
  aList.sum (?u)
  println (u.description)
  let @string s
  let strcst = @lstring ("Hello", .here) ; strcst.op (?s)
  println (s.description)
  var ls = @lstring ("Hello", .here)
  !?ls.appendInt (3)
  println (ls.description)
  !?aList.appendSquare (9)
  println (aList.description)
  var aList64 = [@u64] [7]
  !?aList64.prependSquare (5)
}

//---------- Extension readers
func @u64.square() -> @u64 {
  result = self * self
}

func [@uint].sum() -> @uint {
  result = 0
  for value in self do
    result = result + value
  end
}

func @lstring.op() -> @string {
  result = self.string + " !"
}

//----------- Extension methods
proc @u64.square (!@u64 outResult) {
  outResult = self * self
}

proc [@uint].sum (!@uint outResult) {
  outResult = 0
  for value in self do
    outResult = outResult + value
  end
}

proc @lstring.op (!@string outResult) {
  outResult = self.string + " !"
}

//----------- Extension setters
mutating proc @lstring.appendInt (let@uint inValue) {
  self.string += inValue.string
}

mutating proc [@uint].appendSquare (let@uint inValue) {
  !?self.append (inValue * inValue)
}

mutating proc [@u64].prependSquare (let @u64 inValue) {
  !?self.insert (inValue.square, !at: 0)
}

mutating proc @string.concatList (let [@string] inList) {
  for value in inList do
    self += value
  end
}

mutating proc @u64.increment() {
  self += 1
}

//---------------------------------------------------------------------------*

