

proc testsuite_foreach_instruction() {
  var strList = [@string] []
  !?strList.append ("a")
  !?strList.append ("b")
  !?strList.append ("c")
  !?strList.append ("d")
  println ("*************************************** begin of foreach instruction test 1")
  for s in strList
  before
    println ("  before")
  do
    println ("  do '" + s + "'")
  between
    println ("  between")
  after
    println ("  after")
  end
  println ("--- begin of foreach instruction test 2")
  for s in strList
  while false
  before
    println ("  before")
  do
    println ("  do '" + s + "'")
  between
    println ("  between")
  after
    println ("  after")
  end
  println ("--- begin of foreach instruction test 3")
  var @u32 n = 0
  for s in strList
  while n < 2
  before
    println ("  before")
  do
    println ("  do '" + s + "', n: " + n.string)
    n += 1
  between
    println ("  between")
  after
    println ("  after")
  end
  println ("--- begin of foreach instruction test 4")
  for value in strList while value != "c"
  before
    println ("  before")
  do
    println ("  do '" + value + "'")
  between
    println ("  between")
  after
    println ("  after")
  end
  println ("--- begin of foreach instruction test 5")
  for s in strList
  before
    println ("  before")
  do (idx)
    println ("  do '" + s + "' (idx: " + idx.string + ")")
  between
    println ("  between")
  after
    println ("  after")
  end
  println ("--- begin of foreach instruction test 6")
  for s in strList
  do (idx)
    println ("  do '" + s + "' (idx: " + idx.string + ")")
  end
  println ("--- begin of foreach instruction test 7")
  var @stringset set = []
  !?set.insert ("A")
  !?set.insert ("B")
  !?set.insert ("C")
  !?set.insert ("D")
  !?set.insert ("E")
  !?set.insert ("F")
  !?set.insert ("G")
  !?set.insert ("H")
  for (key) in set
  do (idx)
    println ("  do '" + key + "' (idx: " + idx.string + ")")
  end
  println ("--- begin of foreach instruction test 8")
  for > (key) in set
  do (idx)
    println ("  do '" + key + "' (idx: " + idx.string + ")")
  end
  println ("--- begin of foreach instruction test 9")
  var myData = @data.emptyData
  !?myData.appendU8 (1)
  !?myData.appendU8 (2)
  !?myData.appendU8 (3)
  !?myData.appendU8 (4)
  !?myData.appendU8 (5)
  !?myData.appendU8 (6)
  !?myData.appendU8 (7)
  !?myData.appendU8 (8)
  for byte in myData
  do (idx)
    println ("  do '" + byte + "' (idx: " + idx.string + ")")
  end
}

