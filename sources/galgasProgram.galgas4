before { //--- Generate project
  let creationProjectName = @buildOptionValue.create_project
  projectCreation (creationProjectName)
}

//--------------------------------------------------------------------------------------------------

before { //--- Print predefined lexical action
  if @buildOptionValue.printPredefinedLexicalActions then
    printPredefinedLexicalActions ()
  end
}

//--------------------------------------------------------------------------------------------------

before { //--- Extract LIBPM
  if @buildOptionValue.extractLIBPMOption != "" then
    updateLIBPMatPath (@buildOptionValue.extractLIBPMOption)
  end
}

//--------------------------------------------------------------------------------------------------

extern proc checkBigInteger ()

before { //--- Extract LIBPM
  if @buildOptionValue.check_big_int then
    checkBigInteger ()
  end
}

//--------------------------------------------------------------------------------------------------

extern proc displayUnicodeLexicalTestFunctions ()

before {
  if @buildOptionValue.displayUnicodeLexicalTestFunctions then
    displayUnicodeLexicalTestFunctions ()
  end
}

//--------------------------------------------------------------------------------------------------
//
//          galgas4
//
//--------------------------------------------------------------------------------------------------

case . "galgas4"
#errorMessage "a GALGAS 4 source file"
grammar galgas4Grammar ?sourceFilePath: @lstring inSourceFile {
//--- Search for a project file in parent directory
  let parentDirectory = inSourceFile.string.deletingLastPathComponent.deletingLastPathComponent
  let candidateProjectFiles = parentDirectory.regularFilesWithExtensions (!recursive: false, ["galgas4project"])
  if candidateProjectFiles.count == 0 then
    error inSourceFile : "no project file in parent directory of source file"
  elsif candidateProjectFiles.count > 1 then
    var s = "several project files in source file parent directory:"
    for value in candidateProjectFiles do
      s += "\n  - " + value
    end
    error inSourceFile : s
  else
    let projectFilePath = parentDirectory + "/" + candidateProjectFiles.first
    parseAndAnalyzeProject (@(projectFilePath, inSourceFile.location), inSourceFile.string)
  end
}

//--------------------------------------------------------------------------------------------------
//
//          Template
//
//--------------------------------------------------------------------------------------------------

case . "galgasTemplate"
#errorMessage "a GALGAS Template source file"
grammar templateGrammar
?sourceFilePath:@lstring inSourceFile {
  grammar templateGrammar (?*) in inSourceFile
}

//--------------------------------------------------------------------------------------------------
//
//          galgas Project
//
//--------------------------------------------------------------------------------------------------

case . "galgas4project"
#errorMessage "a GALGAS4 project source file"
grammar projectComponentGrammar
?sourceFilePath: @lstring inProjectSourceFile {
  parseAndAnalyzeProject (inProjectSourceFile, "")
}

//--------------------------------------------------------------------------------------------------
//
//          compileProject
//
//--------------------------------------------------------------------------------------------------

