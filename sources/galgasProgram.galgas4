//--------------------------------------------------------------------------------------------------

private proc compileProject (let @lstring inProjectSourceFilePath,
                             let @string inSourceToAnalyze,
                             let @projectSettings inProjectSettings) {
  var @galgasDeclarationAST declarationAST = @()
  appendPredefinedTypesASTs (!?declarationAST)
  declarationAST.mDeclarationList ++= @buildOptionValueDeclarationAST (!isPredefined: true, "buildOptionValue".nowhere)
  declarationAST.mDeclarationList ++= @buildOptionInvocationStringDeclarationAST (
    !isPredefined: true,
    !buildOptionStringName: "buildOptionInvocationString".nowhere,
    !buildOptionValueName: "buildOptionValue"
  )
//--- Parse predefined type definitions
  grammar galgas4Grammar (!?declarationAST) on
    @typeGenerationTemplate.contents ().textFileContentsAtPath ("galgas-predefined-entities.txt")
  : "GALGAS predefined types"
//--- Enumerate sources directory for getting all source files
  let sourceDirectory = inProjectSourceFilePath.string.deletingLastPathComponent + "/sources"
  let projectSourceList = sourceDirectory.regularFilesWithExtensions (!recursive: true, ["galgas4"])
  for partialPath in projectSourceList do
    let absoluteSourcePath = partialPath.absolutePathFromPath (sourceDirectory)
    grammar galgas4Grammar (!?declarationAST) in @lstring (absoluteSourcePath, .nowhere)
  end
//--- Enumerate hand coded source files
  let toolCppDirectory = sourceDirectory + "/tool-sources"
  let [@string] handCodedSourceToolFileList = toolCppDirectory.regularFilesWithExtensions (!recursive: true, ["cpp", "h"])
//--------------------------------- Display result
//  if @application.errorCount == 0 then
//    message "  Declarations: " + declarationAST.mDeclarationList.count + "\n"
//    message "  Syntax components: " + declarationAST.mSyntaxComponentList.count + "\n" ;
//    message "  GUI components: " + declarationAST.mGUIComponentList.count + "\n"
//    message "  Source rules: " + declarationAST.mSourceRuleList.count + "\n" ;
//    message "  Prologue procs: " + declarationAST.mPrologueDeclarationList.count + "\n"
//    message "  Epilogue procs: " + declarationAST.mEpilogueDeclarationList.count + "\n"
//  end
//--------------------------------- Group syntax components and their extensions
  groupSyntaxComponentsGalgas3 (
    declarationAST.mSyntaxComponentList,
    declarationAST.mSyntaxExtensions,
    !?declarationAST.mDeclarationList
  )
//--------------------------------- Compile semantic declarations
  var usefulEntitiesGraph = @usefulEntitiesGraph ()
  let @string buildDirectoryName = "build"
  let absoluteBuildDirectory = inProjectSourceFilePath.string.deletingLastPathComponent + "/" + buildDirectoryName
  let productDirectory = absoluteBuildDirectory + "/output"
  let [@string] appProductFileList = @()
  var [@lstring] usefulnessRootEntities = @()
  let @semanticContext semanticContext
  var @unifiedTypeMap typeMap
  var [@semanticDeclarationForGeneration] semanticDeclarationSortedListForGeneration
  if @application.errorCount == 0 then
    compileSemanticDeclarationsGalgas (
      !?usefulnessRootEntities,
      !?usefulEntitiesGraph,
      productDirectory,
      declarationAST,
      inProjectSettings,
      ?semanticContext,
      ?typeMap,
      ?semanticDeclarationSortedListForGeneration
    )
  else
    semanticDeclarationSortedListForGeneration = @()
    semanticContext = @semanticContext (inProjectSettings)
    typeMap = @()
  end
//--------------------------------- Compile GUI components
  let @optionComponentMapForGeneration optionComponentMapForGeneration
  if @application.errorCount == 0 then
    compileAllGuiComponentFromASTGalgas3 (
      declarationAST.mGUIComponentList,
      semanticContext,
      ?optionComponentMapForGeneration
    )
  else
    optionComponentMapForGeneration = @()
  end
//--------------------------------- Compile program declarations
  if @application.errorCount == 0 then
    let projectVersionString = inProjectSettings.majorVersion.bigint.string
      + "." + inProjectSettings.minorVersion.bigint
      + "." + inProjectSettings.revision.bigint
    compileProgramComponentGalgas3 (
      !?usefulnessRootEntities,
      !?usefulEntitiesGraph,
      declarationAST.mPrologueDeclarationList,
      declarationAST.mSourceRuleList,
      declarationAST.mEpilogueDeclarationList,
      semanticContext,
      !?typeMap,
      projectVersionString,
      ?let @programComponentForGeneration programComponentForGeneration
    )
    semanticDeclarationSortedListForGeneration ++= programComponentForGeneration
  end
//----------------------------------- Check entity usefulness
  checkUsefulEntities (usefulEntitiesGraph, usefulnessRootEntities, productDirectory)
//----------------------------------- Build an HTML file that contains all declared types
  let typeDumpFilePath = productDirectory + "/../helpers/" + inProjectSourceFilePath.string.lastPathComponent + ".html"
  if @buildOptionValue.outputHTMLTypeListFile then
    var @stringset firstLetterSet = @()
    for entry in typeMap do
      firstLetterSet ++= entry.lkey.string.characterAtIndex(0).string
    end
    var @string tableOfTypeString = ""
    var @char currentFirstLetter = ' '
    for entry in typeMap do
      if currentFirstLetter != entry.lkey.string.characterAtIndex (0) then
        currentFirstLetter = entry.lkey.string.characterAtIndex (0)
        tableOfTypeString += "<br><a name=\"" + currentFirstLetter.u32
        tableOfTypeString += "\"><b>" + currentFirstLetter + "</b></a><br>"
      end
      tableOfTypeString += linkForType (entry.lkey.string) + "<br>"
    end
    let typeDumpString = @typeDumpGenerationTemplate.typeDump (
      inProjectSourceFilePath.string.lastPathComponent,
      typeMap,
      firstLetterSet,
      tableOfTypeString
    )
    typeDumpString.writeToFileWhenDifferentContents (typeDumpFilePath, ?*)
  else
    @string.deleteFileIfExists (typeDumpFilePath)
  end
//--------------------------------- Perform global checkings
  if (0 == @application.errorCount) & (inSourceToAnalyze == "") then
    performGalgas3ProjectGlobalCheckings (
      !?typeMap,
      declarationAST.mDeclarationList
    )
  end
//--------------------------------- File generation
  if (0 == @application.errorCount) & (inSourceToAnalyze == "") then
    projectGeneration (
      typeMap,
      !absoluteBuildDir: absoluteBuildDirectory,
      !buildDirName: buildDirectoryName,
      optionComponentMapForGeneration,
      appProductFileList,
      semanticDeclarationSortedListForGeneration,
      declarationAST.mSourceRuleList,
      inProjectSettings,
      inProjectSourceFilePath.string,
      "../sources/tool-sources",
      handCodedSourceToolFileList
    )
  end
}

//--------------------------------------------------------------------------------------------------
//          projectGeneration
//--------------------------------------------------------------------------------------------------

private proc projectGeneration (let @unifiedTypeMap inTypeMap,
                                ?absoluteBuildDir: let @string inAbsoluteBuildDirectory,
                                ?buildDirName: let @string inBuildDirectoryName,
                                let @optionComponentMapForGeneration inOptionComponentMapForGeneration,
                                let [@string] inAppProductFileList,
                                let [@semanticDeclarationForGeneration] inSemanticDeclarationSortedListForGeneration,
                                let [@programRuleAST] inSourceRuleList,
                                let @projectSettings inProjectSettings,
                                let @string inProjectSourceFilePath,
                                let @string inHandCodedSourceDirectory,
                                let [@string] inHandCodedSourceToolFileList) {
  let appProductFileList = inAppProductFileList
//--------------------------------- File generation
  if not @buildOptionValue.quiet then
    println ("*** Generating files")
  end
  var @stringset allProductFileSet = @()
//--------------------------------- Create build/user-headers if does not exist
  let userHeadersDir = inAbsoluteBuildDirectory + "/user-headers"
  userHeadersDir.makeDirectory ()
//--------------------------------- Generate GUI components
  let productDirectory = inAbsoluteBuildDirectory + "/output"
  var [@string] swiftAppProductFileList = @()
  if @application.errorCount == 0 then
    generateAllGuiComponentsGalgas3 (
      inOptionComponentMapForGeneration,
      productDirectory,
      !?swift: swiftAppProductFileList
    )
  end
//--------------------------------- Lexical Style Name Sorted Array
  var @sortedLexicalStyleArray sortedLexicalStyleArray = @()
  for (name, comment, index) in inProjectSettings.lexicalStyleMap do
    sortedLexicalStyleArray ++= @(name.string, comment.string, index)
  end
//----------------------------------------------------------------- find last predefined type index
  var @u32 lastPredefinedTypeIndex = inSemanticDeclarationSortedListForGeneration.count
  var looping = true
  loop while lastPredefinedTypeIndex > 0, looping do
    lastPredefinedTypeIndex -= 1
    let element = inSemanticDeclarationSortedListForGeneration [lastPredefinedTypeIndex]
    if element.isPredefined then
      looping = false
    end 
  end
  print (lastPredefinedTypeIndex)
  print (" --- ")
  println (inSemanticDeclarationSortedListForGeneration.count)
//--------------------------------- Generate semantic files
//  message "*** Generate semantic\n" ;
  var [@string] toolCppFileList = @()
  var [@string] toolHeaderFileList = @()
  generatePredefinedTypeFiles (
    productDirectory,
    inSemanticDeclarationSortedListForGeneration,
    sortedLexicalStyleArray,
    !?toolHeaderFileList,
    !?toolCppFileList,
    !?allProductFileSet
  )
  generateSemanticDeclarationsGalgas3 (
    inTypeMap,
    productDirectory,
    inSemanticDeclarationSortedListForGeneration,
    !?swift: swiftAppProductFileList,
    !?toolCppFileList,
    !?toolHeaderFileList,
    !?allProductFileSet
  )
//--------------------------------- Update targets
//  message "*** update targets\n" ;
  if 0 == @application.errorCount then
    var @stringset handledExtensionSet = @()
    for aRule in inSourceRuleList do
      handledExtensionSet ++= aRule.mSourceFileExtension.string
    end
    updateGalgasTargets (
      !absoluteBuildDir: inAbsoluteBuildDirectory,
      !buildDirName: inBuildDirectoryName,
      inProjectSourceFilePath,
      inProjectSettings,  
      toolCppFileList,
      toolHeaderFileList,
      !appProductFileList: appProductFileList,
      !swiftAppProductFileList: swiftAppProductFileList,
      inHandCodedSourceToolFileList,
      inHandCodedSourceDirectory,
      handledExtensionSet,
      !?allProductFileSet
    )
  end
//--------------------------------- Remove useless files
  if 0 == @application.errorCount then
    var @stringset allActualFileSet = @()
    for value in productDirectory.regularFiles (false) do
      allActualFileSet ++= value
    end
    let uselessFileSet = allActualFileSet - allProductFileSet
    for (key) in uselessFileSet do
      @string.deleteFile (productDirectory + "/" + key)
    end
  end
}

//--------------------------------------------------------------------------------------------------
//           G E N E R A T I O N    F I L E W R A P P E R S
//--------------------------------------------------------------------------------------------------

filewrapper @typeDumpGenerationTemplate : "+generation-templates/target_generation" {
  template typeDump : "typeDump.html.galgasTemplate" (
    ?@string PROJECT_NAME,
    ?@unifiedTypeMap UNIFIED_TYPE_MAP,
    ?@stringset FIRST_LETTER_SET,
    ?@string TABLE_OF_TYPES_STRING
  )
}

//--------------------------------------------------------------------------------------------------

func linkForType (?let @string inTypeName ) -> @string {
  result = "<a class=\"header_link\" href=\"#" + inTypeName + "\">@" + inTypeName + "</a>"
}

