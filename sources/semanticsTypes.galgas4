func #once generateFewHeaderFiles () -> @bool {
  result = true
}

//--------------------------------------------------------------------------------------------------

struct @functionSignatureElement {
  public let @lstring mFormalSelector
  public let @unifiedTypeMapEntry mFormalArgumentType
  public let @string mFormalArgumentName
  public let @bool isConstant
}

func [@functionSignatureElement].initializerSignature () -> @string {
  result = "init"
  for parameter in self do
    result += "!" + parameter.mFormalSelector
  end
}

func [@functionSignatureElement].subcriptSignature () -> @string {
  result = ""
  for parameter in self do
    result += "?" + parameter.mFormalSelector
  end
}

//--------------------------------------------------------------------------------------------------
//  CLASS FUNCTION MAP
//--------------------------------------------------------------------------------------------------

map @classFunctionMap {
  public let [@functionSignatureElement] mArgumentTypeList
  public let @bool mHasCompilerArgument
  public let @unifiedTypeMapEntry mReturnedType
  #insertOrReplaceSetter
  #insertSetter insertKey #errorMessage "the '%K' class function has been already defined"
  #searchMethod searchKey #errorMessage "the '%K' class function is not declared"
}

//--------------------------------------------------------------------------------------------------
//  INITIALIZER MAP
//--------------------------------------------------------------------------------------------------

map @initializerMap { // Key is argument signature
  public let [@functionSignatureElement] mArgumentTypeList
  #insertSetter insertKey #errorMessage "the '%K' initializer has been already defined"
  #searchMethod searchKey #errorMessage "the '%K' initializer is not declared"
}

//--------------------------------------------------------------------------------------------------

enum @methodQualifier #comparable { // NE PAS CHANGER L'ORDRE
  case isVirtual
  case isVirtualAbstract
  case isBasic
  case isBasicFinal
  case isInherited
  case isVirtualOverriding
  case isVirtualOverridingAbstract
}

//--------------------------------------------------------------------------------------------------

enum @methodKind #equatable {
  case definedAsMember
  case definedAsExtension
}

//--------------------------------------------------------------------------------------------------
//
//  OPTIONAL METHOD MAP
//
//--------------------------------------------------------------------------------------------------

struct @optionalMethodSignatureElement {
  public let @bool mInputArgument // true -> input, false -> output
  public let @lstring mFormalSelector
  public let @unifiedTypeMapEntry mFormalArgumentType
  public let @string mFormalArgumentName
}

//--------------------------------------------------------------------------------------------------
//
//  R E A D E R    M A P
//
//--------------------------------------------------------------------------------------------------

map @getterMap {
  public let @methodKind mKind
  public let [@functionSignatureElement] mArgumentTypeList
  public let @location mDeclarationLocation
  public let @bool mHasCompilerArgument
  public let @unifiedTypeMapEntry mReturnedType
  public let @methodQualifier mQualifier
  public let @string mGetterNameThatObsoletesInvokationName // If not empty, this func is the one actually called

  #insertSetter insertKey #errorMessage "the '%K' func is already declared"
  #searchMethod searchKey #errorMessage "the '%K' func is not declared"

  #insertOrReplaceSetter
}

//--------------------------------------------------------------------------------------------------
//
//  M O D I F I E R    M A P
//
//--------------------------------------------------------------------------------------------------

struct @formalParameterSignatureElement {
  public let @lstring mFormalSelector
  public let @unifiedTypeMapEntry mFormalArgumentType
  public let @formalArgumentPassingModeAST mFormalArgumentPassingMode
  public let @string mFormalArgumentName
}

//--------------------------------------------------------------------------------------------------

map @setterMap {
  public let @methodKind mKind
  public let [@formalParameterSignatureElement] mParameterList
  public let @bool mHasCompilerArgument
  public let @methodQualifier mQualifier
  public let @string mErrorMessage // If not empty, calling the mutating proc raises an error ith this message
  #insertOrReplaceSetter
  #insertSetter insertKey #errorMessage "the '%K' mutating proc is already declared"
  #searchMethod searchKey #errorMessage "the '%K' mutating proc is not declared"
}

//--------------------------------------------------------------------------------------------------
//
//  M E T H O D    M A P
//
//--------------------------------------------------------------------------------------------------

map @instanceMethodMap {
  public let @methodKind mKind
  public let [@formalParameterSignatureElement] mParameterList
  public let @location mDeclarationLocation
  public let @bool mHasCompilerArgument
  public let @methodQualifier mQualifier
  public let @string mErrorMessage // If not empty, calling the proc raises an error with this message
  #insertSetter insertKey #errorMessage "the '%K' instance proc is already declared"
  #searchMethod searchKey #errorMessage "the '%K' instance proc is not declared"
  #searchMethod searchInheritedKey #errorMessage "as the '%K' proc is tagged as 'override', it should be declared in the super class"
}

//--------------------------------------------------------------------------------------------------
//
//  C L A S S    M E T H O D    M A P
//
//--------------------------------------------------------------------------------------------------

map @classMethodMap {
  public let [@formalParameterSignatureElement] mParameterList
  public let @bool mHasCompilerArgument
  #insertOrReplaceSetter
  #insertSetter insertKey #errorMessage "the '%K' type proc is already declared"
  #searchMethod searchKey #errorMessage "the '%K' type proc is not declared"
}

//--------------------------------------------------------------------------------------------------
//
//  E N U M E R A T I O N    D E S C R I P T O R    L I S T
//
//--------------------------------------------------------------------------------------------------

struct @enumerationDescriptor {
  public let @unifiedTypeMapEntry mEnumeratedType
  public let @string mEnumerationName
}

//--------------------------------------------------------------------------------------------------
//
//  T Y P E D    P R O P E R T Y    L I S T
//
//--------------------------------------------------------------------------------------------------

struct @typedProperty {
  public let @unifiedTypeMapEntry typeEntry
  public let @lstring name
  public let @propertyInCollectionInitializationAST initialization
  public let @bool hasSetter #initArgLabel
  public let @bool hasSelector #initArgLabel
}

func [@typedProperty].initializerSignature () -> @string {
  result = "init"
  for property in self do
    if property.initialization == .none then
      result += "!"
      if property.hasSelector then
        result += property.name
      end
    end
  end
}

//--------------------------------------------------------------------------------------------------

map @propertyMap {
  public let @AccessControl mAccessControl
  public let @bool mIsConstant
  public let @unifiedTypeMapEntry mPropertyType
  #insertSetter insertKey #errorMessage "the '%K' property has been already declared in %L"
  #searchMethod searchKey #errorMessage "the '%K' property is not declared"
}

//--------------------------------------------------------------------------------------------------

enum @headerKind #equatable {
  case noHeader
  case oneHeader
  case twoHeaders
}

//--------------------------------------------------------------------------------------------------

struct @associatedValueDescriptor #equatable {
  let @unifiedTypeMapEntry type
  let @string name
}

extension [@associatedValueDescriptor] : #equatable {
}

//--------------------------------------------------------------------------------------------------

map @constantIndexMap #equatable {
  public let @uint mIndex
  public let [@associatedValueDescriptor] mAssociatedTypeList
  #insertSetter insertKey #errorMessage "the '%K' constant is already declared"
  #searchMethod searchKey #errorMessage "the '%K' constant is not declared"
}

//--------------------------------------------------------------------------------------------------

