//--------------------------------------------------------------------------------------------------
//   SYNTAX
//--------------------------------------------------------------------------------------------------

syntax galgasTemplateInstructionSyntax : galgasScanner4 {

  rule <expression> (?!@galgasDeclarationAST ioDeclarations,
                     !@semanticExpressionAST outExpression)

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <template_instruction_list> (?!@galgasDeclarationAST ioDeclarations,
                                    ![@templateAbstractInstructionAST] outInstructionList) {
    outInstructionList = []
    repeat
      enterTemplateString (!?outInstructionList)
    while
      <template_instruction> (!?ioDeclarations, ?let instruction)
      outInstructionList ++= instruction
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

abstract class @templateAbstractInstructionAST {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  abstract proc templateInstructionAnalysis (let @lstring inUsefulnessCallerEntityName,
                                             ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
                                             let @analysisContext inAnalysisContext,
                                             ?!@unifiedTypeMap ioTypeMap,
                                             ?!@localVarManager ioVariableMap,
                                             ?![@templateInstructionForGeneration] ioInstructionList)

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
