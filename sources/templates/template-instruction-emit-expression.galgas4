//   SYNTAX
//--------------------------------------------------------------------------------------------------

syntax extension galgasTemplateInstructionSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <template_instruction> (?!@galgasDeclarationAST ioDeclarations,
                               !@templateAbstractInstructionAST outInstruction) {
    $!$
    let loc = @location.here
    <expression> (!?ioDeclarations, ?let expression)
    outInstruction = @templateSendInstructionAST (expression, loc)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

final class @templateSendInstructionAST : @templateAbstractInstructionAST {
  private let @semanticExpressionAST mExpression
  private let @location mLocation

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc templateInstructionAnalysis (let @lstring inUsefulnessCallerEntityName,
                                             ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
                                             let @analysisContext inAnalysisContext,
                                             ?!@unifiedTypeMap ioTypeMap,
                                             ?!@localVarManager ioVariableMap,
                                             ?![@templateInstructionForGeneration] ioInstructionList) {
    self.mExpression.analyzeSemanticExpression (
      !usefulnessCallerEntityName: inUsefulnessCallerEntityName,
      !?ioUsefulEntitiesGraph,
      !inferenceType: inAnalysisContext.predefinedTypes.mStringType,
      inAnalysisContext,
      !?ioTypeMap,
      !?ioVariableMap,
      ?let @semanticExpressionForGeneration expression
    )
//    self.mExpression.expressionAnalysis (
//      inUsefulnessCallerEntityName,
//      !?ioUsefulEntitiesGraph,
//      inAnalysisContext,
//      !?ioTypeMap,
//      ?let expression
//    )
    if expression.mResultType.definition.typeName.string != "string" then
      error self.mLocation : "expression type should be '@string' (it is '@" + expression.mResultType.definition.typeName.string + "')"
    end
    ioInstructionList ++= @templateInstructionExpressionForGeneration (expression)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

final class @templateInstructionExpressionForGeneration : @templateInstructionForGeneration {
  private let @semanticExpressionForGeneration mExpression

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc templateCodeGeneration (?!@string ioGeneratedCode,
                                        ?!@stringset ioInclusionSet,
                                        ?!@u32 ioTemporaryVariableIndex,
                                        ?!@stringset ioUnusedVariableCppNameSet,
                                        ?!@bool _ioUseColumnMarker) {
    self.mExpression.generateExpression (
      !?ioGeneratedCode,
      !?ioInclusionSet,
      !?ioTemporaryVariableIndex,
      !?ioUnusedVariableCppNameSet,
      ?let cppName
    )
    ioGeneratedCode += "result.appendString (" + cppName + ".stringValue ()) ;\n"
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

