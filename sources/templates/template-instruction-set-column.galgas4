//--------------------------------------------------------------------------------------------------
//   SYNTAX
//--------------------------------------------------------------------------------------------------

syntax extension galgasTemplateInstructionSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <template_instruction> (?!@galgasDeclarationAST _ioDeclarations,
                               !@templateAbstractInstructionAST outInstruction) {
    $!^$
    outInstruction = @templateInstructionSetColumnAST ()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
// AST
//--------------------------------------------------------------------------------------------------

final class @templateInstructionSetColumnAST : @templateAbstractInstructionAST {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc templateInstructionAnalysis (let @lstring _inUsefulnessCallerEntityName,
                                             ?!@usefulEntitiesGraph _ioUsefulEntitiesGraph,
                                             let @analysisContext _inAnalysisContext,
                                             ?!@unifiedTypeMap _ioTypeMap,
                                             ?!@localVarManager _ioVariableMap,
                                             ?![@templateInstructionForGeneration] ioInstructionList) {
    ioInstructionList ++= @templateInstructionSetColumnForGeneration ()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
// CODE GENERATION
//--------------------------------------------------------------------------------------------------

final class @templateInstructionSetColumnForGeneration : @templateInstructionForGeneration {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc templateCodeGeneration (?!@string ioGeneratedCode,
                                        ?!@stringset _ioInclusionSet,
                                        ?!@u32 _ioTemporaryVariableIndex,
                                        ?!@stringset _ioUnusedVariableCppNameSet,
                                        ?!@bool ioUseColumnMarker) {
    ioUseColumnMarker = true
    ioGeneratedCode += "result.appendSpacesUntilColumn (columnMarker) ;\n"
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------


