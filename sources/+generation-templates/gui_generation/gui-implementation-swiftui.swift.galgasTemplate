
import SwiftUI
import UniformTypeIdentifiers

//--------------------------------------------------------------------------------------------------

extension UTType {
%for (lkey 2*) in GUI_CONTEXT.mExtensionMap do
%  nonisolated static let %![lkey identifierRepresentation]% = UTType (exportedAs: Bundle.main.bundleIdentifier! + ".%![lkey lowercased]%")\n%
end
%}

//--------------------------------------------------------------------------------------------------

extension ProjectDocument {
  static let readableContentTypes : [UTType] = [%
for (lkey 2*) in GUI_CONTEXT.mExtensionMap
  do %.%![lkey identifierRepresentation]
  between %, %
end
%]
}

//--------------------------------------------------------------------------------------------------
//    Project file extensions
//--------------------------------------------------------------------------------------------------

let projectFileExtensions = Set ([%
for (lkey 2*) in GUI_CONTEXT.mExtensionMap
  do ![[lkey lowercased] utf8RepresentationEscapingQuestionMark]
  between %, %
end
%])

//--------------------------------------------------------------------------------------------------
//   Scanner for a given extension
//--------------------------------------------------------------------------------------------------

@MainActor func scannerFor (extension inExtension : String) -> AbstractScanner? {
  var result : AbstractScanner? = nil
  let fileExtension = inExtension.lowercased ()\n%
for (lkey mLexiqueName *) in GUI_CONTEXT.mExtensionMap
  before %  if%
  do % fileExtension == %![[lkey lowercased] utf8RepresentationEscapingQuestionMark]% {\n%
     %    result = ScannerFor_%!mLexiqueName% ()\n%
  between %  }else if%
  after %  }\n%
end
%  return result
}

//--------------------------------------------------------------------------------------------------
// Setting View
//--------------------------------------------------------------------------------------------------

struct SettingsView : View {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  enum SidebarItem {
    case commandLineOptions
%for (aLexique) in GUI_CONTEXT.mWithLexiqueList
  do %    case %!aLexique.mLexiqueClassName%_%![aLexique.mIndex string]%\n%
end
%    case allocationDebugView
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  @State private var mSelection : SidebarItem = .commandLineOptions

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  @ViewBuilder var body : some View {
    NavigationSplitView {
      List(selection: self.$mSelection) {
        Text ("Options").tag (SidebarItem.commandLineOptions)\n
%for (aLexique) in GUI_CONTEXT.mWithLexiqueList
  do %        Text ("%!aLexique.mTitle%").tag (SidebarItem.%!aLexique.mLexiqueClassName%_%![aLexique.mIndex string]%)\n%
end
%        Text ("Allocation Debug").tag (SidebarItem.allocationDebugView)
      }
      .toolbar (removing: .sidebarToggle)
    } detail: {
      switch self.mSelection {
        case .commandLineOptions : OptionView ()
%for (aLexique) in GUI_CONTEXT.mWithLexiqueList
  do %        case .%!aLexique.mLexiqueClassName%_%![aLexique.mIndex string]% : SettingViewFor_%!aLexique.mLexiqueClassName% ()\n%
end
%        case .allocationDebugView : AllocationDebugView ()
      }
    }
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}


%for (aLexique) in GUI_CONTEXT.mWithLexiqueList do
%//--------------------------------------------------------------------------------------------------
//   Popup list data for '%!aLexique.mLexiqueClassName%' lexique
//--------------------------------------------------------------------------------------------------

let gPopUpData_%!aLexique.mLexiqueClassName% : [[UInt16]] = [
%  for (aLabel) in aLexique.mLabels do
%  [%![aLabel.mLeadingCharacterStrippedCount string]%, // Leading character count to strip\n%
      for (entry) in aLabel.mTerminalList
      do %    %!aLexique.mLexiqueClassName%_1_%![entry.mTerminal identifierRepresentation]%, %![entry.mDisplayFlags string]
      between %,\n%
      end    
    %\n  ]%
  between %,\n%
  end
%
]

//--------------------------------------------------------------------------------------------------
//   Block Comment for '%!aLexique.mLexiqueClassName%' lexique
//--------------------------------------------------------------------------------------------------

let gLineComment_%!aLexique.mLexiqueClassName% : String? = %if [aLexique.mBlockComment count] == 0 then %nil% else ![aLexique.mBlockComment utf8Representation] end%

%end%
