import SwiftUI

//--------------------------------------------------------------------------------------------------

fileprivate let SELECTED_COMPILER_TOOL_INDEX_PREFKEY = "selected.compiler.tool.index"
%for (sortedOption) in BOOL_OPTION_ARRAY do
  %fileprivate let %!sortedOption.mIdentifier.string%_PREFKEY = %!["build-option:" + sortedOption.mIdentifier utf8RepresentationEscapingQuestionMark]%\n%
end
for (sortedOption) in UINT_OPTION_ARRAY do
  %fileprivate let %!sortedOption.mIdentifier.string%_PREFKEY = %!["build-option:" + sortedOption.mIdentifier utf8RepresentationEscapingQuestionMark]%\n%
end
for (sortedOption) in STRING_OPTION_ARRAY do
  %fileprivate let %!sortedOption.mIdentifier.string%_PREFKEY = %!["build-option:" + sortedOption.mIdentifier utf8RepresentationEscapingQuestionMark]%\n%
end%
//--------------------------------------------------------------------------------------------------
//   Options View
//--------------------------------------------------------------------------------------------------

struct OptionView : View {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  private let mCompilerTools : [CompilerTool] = compilerTools ()
  @AppStorage(SELECTED_COMPILER_TOOL_INDEX_PREFKEY) private var mSelectedCompilerIndex = 0
  @State private var mCommandLine = compilerCommandExplained ()

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Bool options
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

%for (sortedOption) in BOOL_OPTION_ARRAY do
  %  @AppStorage(%!sortedOption.mIdentifier.string%_PREFKEY) private var %!sortedOption.mIdentifier.string% : Bool = false\n%
end%
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // UInt options
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

%for (sortedOption) in UINT_OPTION_ARRAY do
  %  @AppStorage(%!sortedOption.mIdentifier.string%_PREFKEY) private var %!sortedOption.mIdentifier.string% : UInt = 0\n%
end%
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // String options
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

%for (sortedOption) in STRING_OPTION_ARRAY do
  %  @AppStorage(%!sortedOption.mIdentifier.string%_PREFKEY) private var %!sortedOption.mIdentifier.string% : String = ""\n%
end%
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  // Body
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  @ViewBuilder var body : some View {
    VStack {
      HStack {
        Picker("Compiler", selection: self.$mSelectedCompilerIndex) {
          ForEach (self.mCompilerTools, id: \.id) { tool in
            Text (tool.url.lastPathComponent).tag (tool.id)
          }
        }.pickerStyle (.automatic)
        Spacer ()
      }
      ScrollView {
        VStack (alignment: .leading) {
%for (sortedOption) in BOOL_OPTION_ARRAY do
  %          Toggle (%![sortedOption.mExplanationString utf8RepresentationEscapingQuestionMark]%, isOn: self.$%!sortedOption.mIdentifier.string%)\n%
end
for (sortedOption) in UINT_OPTION_ARRAY do
  %          HStack { Text (%![sortedOption.mExplanationString utf8RepresentationEscapingQuestionMark]%) ; TextField ("", value: self.$%!sortedOption.mIdentifier.string%, format: .number.precision (.fractionLength (0)))\n%
end
for (sortedOption) in STRING_OPTION_ARRAY do
  %          HStack { Text (%![sortedOption.mExplanationString utf8RepresentationEscapingQuestionMark]%) ; TextField ("", text: self.$%!sortedOption.mIdentifier.string%) }\n%
end
%        }.padding ()
      }.background (.white)
      HStack { Text ("Build Command") ; Spacer () }
      TextEditor (text: .constant (self.mCommandLine))
      .font (.system (size: 12).monospaced())
      .frame (height: 64)
    }.padding ()
    .onReceive (NotificationCenter.default.publisher (for: UserDefaults.didChangeNotification)) { _ in
      self.mCommandLine = compilerCommandExplained ()
    }
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

private func compilerCommandExplained () -> String {
  let command : CommandLineToolInvocation = commandLineToolInvocation ()
  var result = command.tool.lastPathComponent
  for arg in command.arguments {
    result += " " + arg
  }
  return result
}

//--------------------------------------------------------------------------------------------------

struct CommandLineToolInvocation {
  let tool : URL
  let arguments : [String]
}

//--------------------------------------------------------------------------------------------------

func commandLineToolInvocation () -> CommandLineToolInvocation {
  let ud = UserDefaults.standard
  let compilerTools : [CompilerTool] = compilerTools ()
  let selectedCompilerIndex : Int = ud.integer (forKey: SELECTED_COMPILER_TOOL_INDEX_PREFKEY)
  let tool = compilerTools [selectedCompilerIndex].url
  var arguments = [String] ()
%for (sortedOption) in BOOL_OPTION_ARRAY do
    %  if ud.bool (forKey: %!sortedOption.mIdentifier.string%_PREFKEY) {\n%
    %    arguments.append (%!["--" + sortedOption.mInvocationString utf8RepresentationEscapingQuestionMark]%)\n%
    %  }\n%
end
for (sortedOption) in UINT_OPTION_ARRAY do
    %  do{\n%
    %    let v : Int = ud.integer (forKey: %!sortedOption.mIdentifier.string%_PREFKEY)\n%
    %    if v != 0 {\n%
    %      arguments.append (%!["--" + sortedOption.mInvocationString + "=" utf8RepresentationEscapingQuestionMark]% + String (v))\n%
    %    }\n%
    %  }\n%
end
for (sortedOption) in STRING_OPTION_ARRAY do
    %  do{\n%
    %    let v : String = ud.string (forKey: %!sortedOption.mIdentifier.string%_PREFKEY) ?? ""\n%
    %    if v != "" {\n%
    %      arguments.append (%!["--" + sortedOption.mInvocationString + "=" utf8RepresentationEscapingQuestionMark]% + v)\n%
    %    }\n%
    %  }\n%
end
%  return CommandLineToolInvocation (tool: tool, arguments: arguments)
}

