#include "all-predefined-types.h"

//--------------------------------------------------------------------------------------------------
// Lexical styles
//--------------------------------------------------------------------------------------------------

String styleNameForIndex (const uint32_t inStyleIndex) {
  const char * array [%![[LEXICAL_STYLE_SORTED_ARRAY count] + 3 string]%] = {
    "", // 0 (default style is denoted by an empty string)
%
for (aStyle) in LEXICAL_STYLE_SORTED_ARRAY do
  %    %![aStyle.name cStringRepresentation]%, // %![aStyle.index string]%\n%
end
%    "LexicalError", // %![[LEXICAL_STYLE_SORTED_ARRAY count] + 1 string]%
    "Template" // %![[LEXICAL_STYLE_SORTED_ARRAY count] + 2 string]%
  } ;
  return (inStyleIndex < %![[LEXICAL_STYLE_SORTED_ARRAY count] + 3 string]%) ? array [inStyleIndex] : "" ;
}
