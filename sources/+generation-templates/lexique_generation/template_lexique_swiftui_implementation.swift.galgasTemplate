
import SwiftUI

//--------------------------------------------------------------------------------------------------
//                           Template Replacements
//--------------------------------------------------------------------------------------------------

%if [TEMPLATE_REPLACEMENT_LIST count] > 0 then
%fileprivate let kTemplateReplacementArray_%![LEXIQUE_CLASS_NAME identifierRepresentation]% : [String] = [
%
for (rep) in TEMPLATE_REPLACEMENT_LIST
  do %  %![rep.mMatchString utf8RepresentationEscapingQuestionMark]
  between %,\n%
end%
]
%end%
//--------------------------------------------------------------------------------------------------
//                           Template Delimiters
//--------------------------------------------------------------------------------------------------

%if [TEMPLATE_DELIMITOR_LIST count] > 0 then
%fileprivate let kTemplateDefinitionArray_%![LEXIQUE_CLASS_NAME identifierRepresentation]% : [TemplateDelimiter] = [
%
for (delimitor) in TEMPLATE_DELIMITOR_LIST
  do  %  TemplateDelimiter (startString: %![delimitor.mStartString utf8RepresentationEscapingQuestionMark]%, endString: %
      if [delimitor.mEndString count] == 0 then
        %nil%
      else
        ![delimitor.mEndString utf8RepresentationEscapingQuestionMark]
      end
      %, discardStartString: %
      ![not delimitor.mPreservesStartDelimiter cString]
      %)%
  between %,\n%
end%
]
%end%
//--------------------------------------------------------------------------------------------------
//            Terminal Symbols as end of script in template mark
//--------------------------------------------------------------------------------------------------

% for (terminal) in TERMINAL_LIST
    before %fileprivate let kEndOfScriptInTemplateArray_%![LEXIQUE_CLASS_NAME identifierRepresentation]% : [Bool] = [\n%
    do %  %![terminal.isEndOfTemplateMark cString]% /* %!terminal.mTerminalName.string% */%
    between %,\n%
    after %\n]\n%
  end
%

