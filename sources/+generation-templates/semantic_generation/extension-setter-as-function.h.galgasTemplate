//--------------------------------------------------------------------------------------------------
//
//%!"Extension mutating proc '@" + TYPE_NAME + " " + MODIFIER_NAME + "'"%
//
//--------------------------------------------------------------------------------------------------

void extensionSetter_%![MODIFIER_NAME identifierRepresentation]% (%?^%class GGS_%![TYPE_NAME identifierRepresentation]% & ioObject%
  for (formalArg) in FORMAL_ARGUMENT_LIST do
    %,\n%!^
    if formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentConstantIn] then
      %const class GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% constin_%![formalArg.mFormalArgumentName identifierRepresentation]
    elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentInOut] then
      %class GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% & io_%![formalArg.mFormalArgumentName identifierRepresentation]
    elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentOut] then
      %class GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% & out_%![formalArg.mFormalArgumentName identifierRepresentation]
    else // argumentIn
      %class GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% in_%![formalArg.mFormalArgumentName identifierRepresentation]
    end
  end
  %,\n%!^%class Compiler * inCompiler%
  %\n%!^%COMMA_LOCATION_ARGS) ;

