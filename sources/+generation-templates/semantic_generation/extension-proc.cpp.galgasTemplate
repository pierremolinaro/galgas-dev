//--------------------------------------------------------------------------------------------------

void callExtensionMethod_%![METHOD_NAME identifierRepresentation]% (%?^%cPtr_%![CLASS_NAME identifierRepresentation]% * inObject%
  for (formalArg) in FORMAL_ARGUMENT_LIST do
    %,\n%!^
    if formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentConstantIn] then
      %const GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% constin_%![formalArg.mFormalArgumentName identifierRepresentation]
    elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentInOut] then
      %GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% & io_%![formalArg.mFormalArgumentName identifierRepresentation]
    elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentOut] then
      %GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% & out_%![formalArg.mFormalArgumentName identifierRepresentation]
    else // argumentIn
      %GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% in_%![formalArg.mFormalArgumentName identifierRepresentation]
    end
  end
  %,\n%!^%Compiler * inCompiler%
  %\n%!^%COMMA_LOCATION_ARGS) {
%
  for (formalArg) in FORMAL_ARGUMENT_LIST do
    if formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentOut] then
      %  out_%![formalArg.mFormalArgumentName identifierRepresentation]%.drop () ;\n%
    end
  end
%  if (nullptr != inObject) {
    macroValidSharedObject (inObject, cPtr_%![CLASS_NAME identifierRepresentation]%) ;
    inObject->method_%![METHOD_NAME identifierRepresentation]% (%
    for (formalArg) in FORMAL_ARGUMENT_LIST do
      if formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentConstantIn] then
        %constin_%![formalArg.mFormalArgumentName identifierRepresentation]
      elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentInOut] then
        %io_%![formalArg.mFormalArgumentName identifierRepresentation]
      elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentOut] then
        %out_%![formalArg.mFormalArgumentName identifierRepresentation]
      else // argumentIn
        %in_%![formalArg.mFormalArgumentName identifierRepresentation]
      end
      %, %
    end
    %inCompiler COMMA_THERE) ;
  }
}

