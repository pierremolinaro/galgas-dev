class GGS_%!RETURN_TYPE_IDENTIFIER% extensionGetter_%![GETTER_NAME identifierRepresentation]% (%?^%const class GGS_%![TYPE_NAME identifierRepresentation]% & inObject%
  for (formalArg) in FORMAL_ARGUMENT_LIST do (IDX)
    %,\n%!^
    if formalArg.mIsConstant then
      %const class GGS_% ![formalArg.mFormalArgumentType identifierRepresentation] % & constinArgument% ![IDX string]
    else
      %class GGS_% ![formalArg.mFormalArgumentType identifierRepresentation] % inArgument% ![IDX string]
    end
  end
  %,\n%!^
  %class Compiler * inCompiler\n%
  !^%COMMA_LOCATION_ARGS) ;

