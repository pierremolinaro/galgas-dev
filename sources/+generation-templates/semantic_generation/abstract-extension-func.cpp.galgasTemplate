//%!"Abstract extension func '@" + CLASS_NAME + " " + GETTER_NAME + "'"%
//
//--------------------------------------------------------------------------------------------------

GGS_%![RETURN_TYPE identifierRepresentation]% callExtensionGetter_%![GETTER_NAME identifierRepresentation]% (%?^%const cPtr_%![CLASS_NAME identifierRepresentation]% * inObject%
  for (formalArg) in FORMAL_ARGUMENT_LIST do
    %,\n%!^
    if formalArg.mIsConstant then
      %const GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% in_%![formalArg.mFormalArgumentName identifierRepresentation]
    else
      %GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% in_%![formalArg.mFormalArgumentName identifierRepresentation]
    end
  end
  %,\n%!^%Compiler * inCompiler%
  %\n%!^%COMMA_LOCATION_ARGS) {
  GGS_%![RETURN_TYPE identifierRepresentation]% result ;
  if (nullptr != inObject) {
    result = inObject->getter_%![GETTER_NAME identifierRepresentation]% (%
  for (formalArg) in FORMAL_ARGUMENT_LIST do
    %in_%![formalArg.mFormalArgumentName identifierRepresentation]%, %
  end
  %inCompiler COMMA_THERE) ;
  }
  return result ;
}

