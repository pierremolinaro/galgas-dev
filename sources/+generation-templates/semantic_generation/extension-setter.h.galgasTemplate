//--------------------------------------------------------------------------------------------------
//
//%!"Extension mutating proc '@" + CLASS_NAME + " " + MODIFIER_NAME + "'"%
//
//--------------------------------------------------------------------------------------------------

typedef void (*extensionSetterSignature_%![CLASS_NAME identifierRepresentation]%_%![MODIFIER_NAME identifierRepresentation]%) (%?^
%class cPtr_%![CLASS_NAME identifierRepresentation]% * inObject%
  for (formalArg) in FORMAL_ARGUMENT_LIST do (IDX)
    %,\n%!^
    if formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentConstantIn] then
      %const class GGS_% ![formalArg.mFormalArgumentType identifierRepresentation] % constinArgument% ![IDX string]
    elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentInOut] then
      %class GGS_% ![formalArg.mFormalArgumentType identifierRepresentation] % & ioArgument% ![IDX string]
    elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentOut] then
      %class GGS_% ![formalArg.mFormalArgumentType identifierRepresentation] % & outArgument% ![IDX string]
    else // argumentIn
      %class GGS_% ![formalArg.mFormalArgumentType identifierRepresentation] % inArgument% ![IDX string]
    end
  end
  %,\n%!^%class Compiler * inCompiler%
  %\n %!^%COMMA_LOCATION_ARGS) ;

//--------------------------------------------------------------------------------------------------

void enterExtensionSetter_%![MODIFIER_NAME identifierRepresentation]% (%?^%const int32_t inClassIndex,
               %!^%extensionSetterSignature_%![CLASS_NAME identifierRepresentation]%_%![MODIFIER_NAME identifierRepresentation]% inModifier) ;

//--------------------------------------------------------------------------------------------------

void callExtensionSetter_%![MODIFIER_NAME identifierRepresentation]% (%?^%class cPtr_%![CLASS_NAME identifierRepresentation]% * inObject%
  for (formalArg) in FORMAL_ARGUMENT_LIST do
    %,\n%!^
    if formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentConstantIn] then
      %const GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% constin_%![formalArg.mFormalArgumentName identifierRepresentation]
    elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentInOut] then
      %GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% & io_%![formalArg.mFormalArgumentName identifierRepresentation]
    elsif formalArg.mFormalArgumentPassingMode == [@formalArgumentPassingModeAST argumentOut] then
      %GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% & out_%![formalArg.mFormalArgumentName identifierRepresentation]
    else // argumentIn
      %GGS_%![formalArg.mFormalArgumentType identifierRepresentation]% in_%![formalArg.mFormalArgumentName identifierRepresentation]
    end
  end
  %,\n%!^%Compiler * inCompiler%
  %\n%!^%COMMA_LOCATION_ARGS) ;

