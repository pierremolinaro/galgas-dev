//--------------------------------------------------------------------------------------------------
//!   AST
//--------------------------------------------------------------------------------------------------

final class @literalStringExpressionAST : @semanticExpressionAST {
  private let @location mLocation
  private let [@string] mStringSequence
}

//--------------------------------------------------------------------------------------------------
//! SYNTAX
//--------------------------------------------------------------------------------------------------

syntax extension galgas4ExpressionSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <primary> (?!@galgasDeclarationAST _ioDeclarations,
                 !@semanticExpressionAST outExpression ) {
    var [@string] literalStringList = @()
    repeat
      $"string"$ (?let literalString)
      literalStringList ++= literalString.string
    while
    end
    outExpression = @literalStringExpressionAST (@location.here, literalStringList)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! SEMANTICS
//--------------------------------------------------------------------------------------------------

override proc @literalStringExpressionAST.enterExpressionInSemanticContext
  (?!@unifiedTypeMap _ioTypeMap
) {
}

//································································································

override proc @literalStringExpressionAST.analyzeSemanticExpression
  (?usefulnessCallerEntityName: let @lstring _inUsefulnessCallerEntityName,
  ?!@usefulEntitiesGraph _ioUsefulEntitiesGraph,
  ?inferenceType: let @unifiedTypeMapEntry _inType,
  let @analysisContext inAnalysisContext,
                                ?!@unifiedTypeMap _ioTypeMap,
  ?!@localVarManager _ioVariableMap,
  !@semanticExpressionForGeneration outExpression
) {
  var @string s = ""
  for value in self.mStringSequence do
    s += value
  end
  outExpression = @literalStringExpressionForGeneration (inAnalysisContext.predefinedTypes.mStringType, self.mLocation, s)
}

//--------------------------------------------------------------------------------------------------
//! CODE GENERATION
//--------------------------------------------------------------------------------------------------

final class @literalStringExpressionForGeneration : @semanticExpressionForGeneration {
  private let @string mString
}

//································································································

override proc @literalStringExpressionForGeneration.generateExpression
  (?!@string _ioGeneratedCode,
  ?!@stringset _ioInclusionSet,
  ?!@uint _ioTemporaryVariableIndex,
  ?!@stringset _ioUnusedVariableCppNameSet,
  !@string outCppExpression ) {
  if self.mString == "" then
    outCppExpression = "GGS_string::makeEmptyString ()"
  else
    outCppExpression = "GGS_string (" + self.mString.utf8RepresentationEscapingQuestionMark + ")"
  end
}

//--------------------------------------------------------------------------------------------------
