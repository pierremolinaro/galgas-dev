syntax extension galgas4ExpressionSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <primary> (?!@galgasDeclarationAST _ioDeclarations,
                 !@semanticExpressionAST outExpression ) {
    $identifier$ (?let identifier)
    outExpression = @varInExpressionAST (identifier)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//!   AST
//--------------------------------------------------------------------------------------------------

final class @varInExpressionAST : @semanticExpressionAST {
  private let @lstring mVarName

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterExpressionInSemanticContext (?!@unifiedTypeMap _ioTypeMap ) {
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc analyzeSemanticExpression (
        ?usefulnessCallerEntityName: let @lstring inUsefulnessCallerEntityName,
        ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
        ?inferenceType: let @unifiedTypeMapEntry _inType,
        let @analysisContext _inAnalysisContext,
        ?!@unifiedTypeMap _ioTypeMap,
        ?!@localVarManager ioVariableMap,
        !@semanticExpressionForGeneration outExpression ) {
    !?ioVariableMap.searchForReadAccess (
      self.mVarName,
      ?let @unifiedTypeMapEntry type,
      ?let @string sourceVariableCppName,
      ?let @string nameForCheckingFormalParameterUsing
    )
    outExpression = @varInExpressionForGeneration (
      type,
      self.mVarName.location,
      sourceVariableCppName,
      nameForCheckingFormalParameterUsing
    )
  //--- Global constant ? Enter edge in useful entities graph
    if nameForCheckingFormalParameterUsing == gCompilerCppName then
      let usefulnessName = functionNameForUsefulEntitiesGraph (self.mVarName)
      !?ioUsefulEntitiesGraph.addEdge (!from: inUsefulnessCallerEntityName, !to: usefulnessName)
    end
  }

  //································································································

}

//--------------------------------------------------------------------------------------------------
//! CODE GENERATION
//--------------------------------------------------------------------------------------------------

final class @varInExpressionForGeneration : @semanticExpressionForGeneration {
  public let @string mCppVarName
  public let @string mNameForCheckingFormalParameterUsing

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc generateExpression (?!@string _ioGeneratedCode,
                                    ?!@stringset ioInclusionSet,
                                    ?!@u32 _ioTemporaryVariableIndex,
                                    ?!@stringset ioUnusedVariableCppNameSet,
                                    !@string outCppExpression) {
    self.mResultType.addHeaderFileName (!?ioInclusionSet)
    !?ioUnusedVariableCppNameSet.removeKey (self.mNameForCheckingFormalParameterUsing)
  //--- Global constant ?
    if self.mNameForCheckingFormalParameterUsing == gCompilerCppName then
      ioInclusionSet ++= "func-" + self.mCppVarName.fileNameRepresentation
      outCppExpression = "function_" + self.mCppVarName + " (inCompiler COMMA_HERE)"
    else
      outCppExpression = self.mCppVarName
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

final class @globalConstantInExpressionForGeneration : @semanticExpressionForGeneration {
  public let @string mGlobalConstantName

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc generateExpression (?!@string _ioGeneratedCode,
                                    ?!@stringset ioInclusionSet,
                                    ?!@u32 _ioTemporaryVariableIndex,
                                    ?!@stringset ioUnusedVariableCppNameSet,
                                    !@string outCppExpression) {
  //--- Add return type header
    self.mResultType.addHeaderFileName (!?ioInclusionSet)
  //--- Add function header
    ioInclusionSet ++= "func-" + self.mGlobalConstantName.fileNameRepresentation
  //---
    outCppExpression = "function_" + self.mGlobalConstantName + " (inCompiler COMMA_HERE)"
    !?ioUnusedVariableCppNameSet.removeKey (gCompilerCppName)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}


