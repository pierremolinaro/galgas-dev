//! SYNTAX
//--------------------------------------------------------------------------------------------------

syntax extension galgas4ExpressionSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <primary> (?!@galgasDeclarationAST _ioDeclarations,
                 !@semanticExpressionAST outExpression ) {
    $filewrapper$
    $@type$ (?let filewrapperName) indexing (filewrapperReference)
    $[$
    $"string"$ (?let @lstring filePath)
    $]$
    outExpression = @filewrapperInExpressionAST (
      filewrapperName,
      filePath
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//!   AST
//--------------------------------------------------------------------------------------------------

final class @filewrapperInExpressionAST : @semanticExpressionAST {
  private let @lstring mFilewrapperName
  private let @lstring mFilewrapperPath

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterExpressionInSemanticContext (?!@unifiedTypeMap _ioTypeMap) {
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc analyzeSemanticExpression (?usefulnessCallerEntityName: let @lstring _inUsefulnessCallerEntityName,
                                           ?!@usefulEntitiesGraph _ioUsefulEntitiesGraph,
                                           ?inferenceType: let @unifiedTypeMapEntry _inType,
                                           let @analysisContext inAnalysisContext,
                                           ?!@unifiedTypeMap ioTypeMap,
                                           ?!@localVarManager _ioVariableMap,
                                           !@semanticExpressionForGeneration outExpression) {
  //--- Parse filewrapper path (à améliorer avec une meilleure implémentation des types)
    var [@string] directoryList
    let @string fileName
    if self.mFilewrapperPath.count() == 0 then
      error self.mFilewrapperPath : "path is empty" spoil directoryList, fileName
    elsif self.mFilewrapperPath.string.firstCharacterOrNul == '/' then
      error self.mFilewrapperPath : "the path should not begin with '/'" spoil directoryList, fileName
    else
      directoryList = self.mFilewrapperPath.componentsSeparatedByString ("/")
      !?directoryList.removeLast (?fileName)
    end
  //--- Get filewrapper features
    inAnalysisContext.semanticContext.mFilewrapperMap.searchKey (
      self.mFilewrapperName,
      ?*,
      ?*,
      ?var @wrapperFileMap filewrapperFileMap,
      ?var @wrapperDirectoryMap filewrapperDirectoryMap,
      ?let @bool isInternal
    )
  //--- Check internal
    if isInternal then
      let filewrapperDeclarationLocation = inAnalysisContext.semanticContext.mFilewrapperMap.locationForKey (self.mFilewrapperName.string)
      if self.mFilewrapperName.location.file != filewrapperDeclarationLocation.file then
        error self.mFilewrapperName : "this filewrapper is internal to '" + filewrapperDeclarationLocation.file + "' file"
      end
    end
  //--- Search for file
    var @string builtPath = ""
    loop (filewrapperDirectoryMap.count + 1) while directoryList.count > 0 do
      !?directoryList.removeFirst (?let directoryName)
      builtPath += directoryName + "/"
      if filewrapperDirectoryMap.contains (directoryName) then
        filewrapperDirectoryMap.searchKey (
          directoryName.here,
          ?filewrapperFileMap,
          ?filewrapperDirectoryMap,
          ?*
        )
      else
        error self.mFilewrapperPath : "the '" + builtPath + "' path does not exists for the '" + self.mFilewrapperName + "' filewrapper" spoil filewrapperFileMap
        directoryList = [] // For exiting loop
      end
    end
    let @u32 fileIndex
    let @bool isTextFile
    if filewrapperFileMap.contains (fileName) then
      filewrapperFileMap.searchKey (@lstring (fileName, @location.here), ?*, ?isTextFile, ?*, ?fileIndex)
    else
      error self.mFilewrapperPath
      : "the '" + fileName + "' file does not exist in the '" + builtPath + "' directory of '" + self.mFilewrapperName + "' filewrapper"
      spoil fileIndex, isTextFile
    end
  //----- Self type
    let @unifiedTypeMapEntry fileWrapperType = ioTypeMap.typeMapEntryForLKey (self.mFilewrapperName)
  //---
    outExpression = @filewrapperStaticPathInExpressionForGeneration (
      if isTextFile
        then inAnalysisContext.predefinedTypes.mStringType
        else ioTypeMap.typeMapEntryForLKey ("data".here)
       end,
      self.mFilewrapperName.location,
      fileWrapperType,
      self.mFilewrapperName.string,
      fileIndex,
      isTextFile
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! CODE GENERATION
//--------------------------------------------------------------------------------------------------

final class @filewrapperStaticPathInExpressionForGeneration : @semanticExpressionForGeneration {
  private let @unifiedTypeMapEntry filewrapperType
  private let @string mFilewrapperName
  private let @u32 mFilewrapperFileIndex
  private let @bool mIsTextFile

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc generateExpression (?!@string _ioGeneratedCode,
                                    ?!@stringset ioInclusionSet,
                                    ?!@u32 _ioTemporaryVariableIndex,
                                    ?!@stringset _ioUnusedVariableCppNameSet,
                                    !@string outCppExpression) {
  //---
    self.filewrapperType.addHeaderFileName (!?ioInclusionSet)
    outCppExpression = if self.mIsTextFile then "GGS_string" else "GGS_data" end
    outCppExpression += " (gWrapperFileContent_" + self.mFilewrapperFileIndex.string + "_" + self.mFilewrapperName.identifierRepresentation + ")"
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
