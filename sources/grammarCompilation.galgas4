func transformLabelMap
  (?let @nonTerminalLabelListAST inLabels
  ) -> @nonterminalSymbolLabelMapForGrammarAnalysis
{
  result = @()
  for aLabel in inLabels do
    var @signatureForGrammarAnalysis formalParametersList = @()
    for formalArg in aLabel.mFormalArgumentList do
      formalParametersList ++= @(formalArg.mFormalArgumentPassingMode, formalArg.mFormalArgumentTypeName)
    end
    !?result.insertKey (aLabel.mLabelName, formalParametersList)
  end
}

//--------------------------------------------------------------------------------------------------

proc checkLabelMap
  (?let @location inNonTerminalLocation,
  ?let @nonTerminalLabelListAST inLabels,
  ?let @location inOriginalNonTerminalLocation,
  ?let @nonterminalSymbolLabelMapForGrammarAnalysis inNonterminalSymbolLabelMapForGrammarAnalysis
) {
  var @stringset labelStringSet = @()
  for aLabel in inLabels do
    labelStringSet ++= aLabel.mLabelName.string
    inNonterminalSymbolLabelMapForGrammarAnalysis.searchKey (!aLabel.mLabelName, ?let formalParametersList)
    if aLabel.mFormalArgumentList.count != formalParametersList.count then
      error (aLabel.mLabelName: aLabel.mFormalArgumentList.count.string
        + " formal parameter"
        + if aLabel.mFormalArgumentList.count > 1 then "s" else "" end
        + " declared here, but declaration at "
        + inNonterminalSymbolLabelMapForGrammarAnalysis.locationForKey (aLabel.mLabelName.string).startLocationString
        + " names " + formalParametersList.count.string + " parameter"
        + if formalParametersList.count > 1 then "s" else "" end
      )
    else
      for labelFormalArg in aLabel.mFormalArgumentList, formalArgForGrammarAnalysis in formalParametersList do
        if formalArgForGrammarAnalysis.mFormalArgumentPassingModeForGrammarAnalysis != labelFormalArg.mFormalArgumentPassingMode then
          error (formalArgForGrammarAnalysis.mGalgasTypeNameForGrammarAnalysis :
            " this formal parameter is declared with '"
          + formalArgForGrammarAnalysis.mFormalArgumentPassingModeForGrammarAnalysis
          + "' passing mode, but declaration at "
          + inNonterminalSymbolLabelMapForGrammarAnalysis.locationForKey (aLabel.mLabelName.string).startLocationString
          + " is declared with '" + labelFormalArg.mFormalArgumentPassingMode + "' passing mode"
          )
        end
        if formalArgForGrammarAnalysis.mGalgasTypeNameForGrammarAnalysis.string != labelFormalArg.mFormalArgumentTypeName.string then
          error (formalArgForGrammarAnalysis.mGalgasTypeNameForGrammarAnalysis :
            " this formal parameter is declared of '@"
          + formalArgForGrammarAnalysis.mGalgasTypeNameForGrammarAnalysis
          + "' type, but declaration at "
          + inNonterminalSymbolLabelMapForGrammarAnalysis.locationForKey (aLabel.mLabelName.string).startLocationString
          + " is declared with '@" + labelFormalArg.mFormalArgumentTypeName + "' type"
          )
        end
      end
    end
  end
//---
  for entry in inNonterminalSymbolLabelMapForGrammarAnalysis do
    if not labelStringSet.hasKey (entry.lkey.string) then
      error (inNonTerminalLocation :
        "this non terminal does not declare the '" + entry.lkey + "' label, but declaration at "
          + inOriginalNonTerminalLocation.startLocationString
          + " does"
      )
    end
  end
}

//--------------------------------------------------------------------------------------------------

proc handleNonTerminalDeclarations
  (?!@nonTerminalSymbolMapForGrammarAnalysis ioNonTerminalMapForGrammarAnalysis,
  ?let @nonterminalDeclarationListAST inNonterminalDeclarationList ) {
  for nonTerminal in inNonterminalDeclarationList do
    if let entry = ioNonTerminalMapForGrammarAnalysis [nonTerminal.mNonterminalName.string] then
      checkLabelMap (
        !nonTerminal.mNonterminalName.location,
        !nonTerminal.mLabels,
        !ioNonTerminalMapForGrammarAnalysis.locationForKey (!nonTerminal.mNonterminalName.string),
        !entry.mNonterminalSymbolParametersMap
      )
    else
      !?ioNonTerminalMapForGrammarAnalysis.insertKey (
        nonTerminal.mNonterminalName,
        ioNonTerminalMapForGrammarAnalysis.count,
        transformLabelMap (nonTerminal.mLabels)
      )
    end
  end
}

//--------------------------------------------------------------------------------------------------

proc handleNonTerminalDeclarationsFromRuleList (
  ?!@nonTerminalSymbolMapForGrammarAnalysis ioNonTerminalMapForGrammarAnalysis,
  ?let @syntaxRuleListAST inRuleList
) {
  for aRule in inRuleList do
    var nonTerminalLabelListAST = @nonTerminalLabelListAST ()
    for aLabel in aRule.mLabelList do
      nonTerminalLabelListAST ++= @(
        !aLabel.mLabelName,
        !aLabel.mFormalArguments,
        !aLabel.mEndOfArgumentLocation
      )
    end
    if let entry = ioNonTerminalMapForGrammarAnalysis [aRule.mNonterminalName.string] then
      checkLabelMap (
        !aRule.mNonterminalName.location,
        !nonTerminalLabelListAST,
        !ioNonTerminalMapForGrammarAnalysis.locationForKey (aRule.mNonterminalName.string),
        !entry.mNonterminalSymbolParametersMap
      )
    else
      !?ioNonTerminalMapForGrammarAnalysis.insertKey (
        aRule.mNonterminalName,
        !ioNonTerminalMapForGrammarAnalysis.count,
        !transformLabelMap (!nonTerminalLabelListAST)
      )
    end
  end
}

//--------------------------------------------------------------------------------------------------
//                     transformInstructionList
//--------------------------------------------------------------------------------------------------

abstract proc @syntaxInstructionAST.transformInstructionForGrammarAnalysis
  (?!usedTerminalMap:@terminalSymbolsMapForGrammarAnalysis ioActuallyUsedTerminalSymbolMap,
  ?nonTerminalSymbolMap:let @nonTerminalSymbolMapForGrammarAnalysis inNonTerminalSymbolMap,
  ?!addedTerminalIndex:@uint ioAddedNonTerminalIndex,
  ?!@syntaxInstructionListForGrammarAnalysis ioSyntaxInstructionList)

//--------------------------------------------------------------------------------------------------

override proc @semanticInstructionAST.transformInstructionForGrammarAnalysis
  (?!usedTerminalMap:@terminalSymbolsMapForGrammarAnalysis unused ioActuallyUsedTerminalSymbolMap,
  ?nonTerminalSymbolMap:let @nonTerminalSymbolMapForGrammarAnalysis unused inNonTerminalSymbolMap,
  ?!addedTerminalIndex:@uint unused ioAddedNonTerminalIndex,
  ?!@syntaxInstructionListForGrammarAnalysis unused ioSyntaxInstructionList ) {
}

//--------------------------------------------------------------------------------------------------

proc transformInstructionListForGrammarAnalysis
  (?let @syntaxInstructionList inInstructionList,
  ?!usedTerminalMap:@terminalSymbolsMapForGrammarAnalysis ioActuallyUsedTerminalSymbolMap,
  ?nonTerminalSymbolMap:let @nonTerminalSymbolMapForGrammarAnalysis inNonTerminalSymbolMap,
  ?!addedTerminalIndex:@uint ioAddedNonTerminalIndex,
  ?!@syntaxInstructionListForGrammarAnalysis ioSyntaxInstructionList ) {
  for instr in inInstructionList do
    instr.mInstruction.transformInstructionForGrammarAnalysis (
      !?usedTerminalMap:ioActuallyUsedTerminalSymbolMap,
      !nonTerminalSymbolMap:inNonTerminalSymbolMap,
      !?addedTerminalIndex:ioAddedNonTerminalIndex,
      !?ioSyntaxInstructionList
   )
  end
}

//--------------------------------------------------------------------------------------------------

proc buildRuleList (
  ?let @nonTerminalSymbolMapForGrammarAnalysis inNonTerminalMapForGrammarAnalysis,
  ?let @lstring inSyntaxComponentName,
  ?let @syntaxRuleListAST inRuleList,
  ?!@terminalSymbolsMapForGrammarAnalysis ioActuallyUsedTerminalSymbolMap,
  ?!@syntaxComponentListForGrammarAnalysis ioSyntaxComponentListForGrammarAnalysis,
  ?!@uint ioAddedNonTerminalCount
) {
  var productionRulesList = @productionRuleListForGrammarAnalysis ()
  for aRule in inRuleList do
    inNonTerminalMapForGrammarAnalysis.searchKey (aRule.mNonterminalName, ?let nonTerminalIndex, ?*)
  //--- Retrieve instruction list from first label
    let @syntaxInstructionList parsedSyntaxInstructionList
    aRule.mLabelList.first (?*, ?*, ?*, ?parsedSyntaxInstructionList, ?*)
  //--- Transform instruction list
    var instructionList = @syntaxInstructionListForGrammarAnalysis ()
    transformInstructionListForGrammarAnalysis (
      !parsedSyntaxInstructionList,
      !?usedTerminalMap:ioActuallyUsedTerminalSymbolMap,
      !nonTerminalSymbolMap:inNonTerminalMapForGrammarAnalysis,
      !?addedTerminalIndex:ioAddedNonTerminalCount,
      !?instructionList
    )
  //---
    productionRulesList ++= @(
      !aRule.mNonterminalName,
      !nonTerminalIndex,
      !instructionList,
      !productionRulesList.count
    )
  end
  ioSyntaxComponentListForGrammarAnalysis ++= @(
    !productionRulesList,
    !inSyntaxComponentName)
}

