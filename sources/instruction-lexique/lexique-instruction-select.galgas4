//--------------------------------------------------------------------------------------------------
//! AST
//--------------------------------------------------------------------------------------------------

final class @lexicalSelectInstructionAST : @lexicalInstructionAST {
  private let [@lexicalSelectBranchAST] mLexicalSelectBranchList
  private let [@lexicalInstructionAST] mDefaultInstructionList
}

//--------------------------------------------------------------------------------------------------

syntax extension galgas4LexiqueComponentSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <lexical_instruction> (?![@lexicalInstructionAST] ioInstructionList) {
    $select$
    var [@lexicalSelectBranchAST] lexicalWhileBranchList = @()
    repeat
      $case$
      <lexical_expression> (?let @lexicalExpressionAST selectExpression)
      $:$
      var [@lexicalInstructionAST] selectInstructionList = @()
      repeat
      while
        <lexical_instruction> (!?selectInstructionList)
      end
      lexicalWhileBranchList ++= @(selectExpression, selectInstructionList)
    while
    end
    $default$
    var [@lexicalInstructionAST] defaultInstructionList = @()
    repeat
    while
      <lexical_instruction> (!?defaultInstructionList)
    end
    $end$
    ioInstructionList ++= @lexicalSelectInstructionAST (
      lexicalWhileBranchList,
      defaultInstructionList
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! CHECK LEXICAL INSTRUCTION
//--------------------------------------------------------------------------------------------------

override proc @lexicalSelectInstructionAST.checkLexicalInstruction (
                         ?!@lexiqueAnalysisContext ioLexiqueAnalysisContext,
                         ?!@lexicalTagMap ioTagMap)  {
  for lexicalSelectBranch in self.mLexicalSelectBranchList do
    lexicalSelectBranch.mSelectExpression.checkLexicalExpression (!?ioLexiqueAnalysisContext)
    var tagMap = @lexicalTagMap.mapWithMapToOverride(ioTagMap)
    for entry in lexicalSelectBranch.mSelectInstructionList do
      entry.checkLexicalInstruction (!?ioLexiqueAnalysisContext, !?tagMap)
    end
  end
  var tagMap = @lexicalTagMap.mapWithMapToOverride(ioTagMap)
  for entry in self.mDefaultInstructionList do
    entry.checkLexicalInstruction (!?ioLexiqueAnalysisContext, !?tagMap)
  end
}

//--------------------------------------------------------------------------------------------------

override func @lexicalSelectInstructionAST.generateSwiftCocoaInstructionCode
  (?let @string inScannerClassName,
  ?let @lexiqueAnalysisContext inLexiqueAnalysisContext
  ) -> @string outGeneratedCode {
  outGeneratedCode = ""
//---
  for lexicalSelectBranch in self.mLexicalSelectBranchList
  do
    outGeneratedCode += "if scanningOk && ("
    outGeneratedCode += lexicalSelectBranch.mSelectExpression.generateSwiftCocoaConditionCode (inLexiqueAnalysisContext)
    outGeneratedCode += ") {\n"
    !?outGeneratedCode.incIndentation (2)
    for entry in lexicalSelectBranch.mSelectInstructionList do
      outGeneratedCode += entry.generateSwiftCocoaInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
    end
    !?outGeneratedCode.decIndentation (2)
  between
    outGeneratedCode += "}else "
  end
//--- Default branch
  if self.mDefaultInstructionList.count > 0 then
    outGeneratedCode += "}else{\n"
    !?outGeneratedCode.incIndentation (2)
    for entry in self.mDefaultInstructionList do
      outGeneratedCode += entry.generateSwiftCocoaInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
    end
    !?outGeneratedCode.decIndentation (2)
  end
  outGeneratedCode += "}\n"
}

//--------------------------------------------------------------------------------------------------
//! C++ CODE GENERATION
//--------------------------------------------------------------------------------------------------

override func @lexicalSelectInstructionAST.lexicalInstructionUsesLoopLocalVariable () -> @bool {
  result = false
  for entry in self.mLexicalSelectBranchList while not result do
    for inst in entry.mSelectInstructionList while not result do
      result = inst.lexicalInstructionUsesLoopLocalVariable
    end
  end
  for instr in self.mDefaultInstructionList while not result do
    result = instr.lexicalInstructionUsesLoopLocalVariable
  end
}

//·································································································

override func @lexicalSelectInstructionAST.generateLexicalInstructionCode
  (?let @string inScannerClassName,
  ?let @lexiqueAnalysisContext inLexiqueAnalysisContext
  ) -> @string {
  result = ""
//---
  for lexicalSelectBranch in self.mLexicalSelectBranchList
  do
    result += "if ("
    result += lexicalSelectBranch.mSelectExpression.generateConditionCode (!context:inLexiqueAnalysisContext)
    result += ") {\n"
    !?result.incIndentation (2)
    for instr in lexicalSelectBranch.mSelectInstructionList do
      result += instr.generateLexicalInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
    end
    !?result.decIndentation (2)
  between
    result += "}else "
  end
//--- Default branch
  if self.mDefaultInstructionList.count > 0 then
    result += "}else{\n"
    !?result.incIndentation (2)
    for instr in self.mDefaultInstructionList do
      result += instr.generateLexicalInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
    end
    !?result.decIndentation (2)
  end
  result += "}\n"
}

