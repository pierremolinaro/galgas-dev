//--------------------------------------------------------------------------------------------------
//! SYNTAX
//--------------------------------------------------------------------------------------------------

syntax extension galgas4LexiqueComponentSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <lexical_instruction> (?![@lexicalInstructionAST] ioInstructionList) {
    $repeat$
    let location = @location.here
    var [@lexicalInstructionAST] repeatedInstructionList = @()
    repeat
    while
      <lexical_instruction> (!?repeatedInstructionList)
    end
    var [@lexicalWhileBranchAST] lexicalWhileBranchList = @()
    repeat
      <repeat_while_branch> (!?lexicalWhileBranchList)
    while
    end
    $end$
    ioInstructionList ++= @lexicalRepeatInstructionAST (
      repeatedInstructionList,
      lexicalWhileBranchList,
      location
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! AST
//--------------------------------------------------------------------------------------------------

final class @lexicalRepeatInstructionAST : @lexicalInstructionAST {
  private let [@lexicalInstructionAST] mRepeatedInstructionList
  private let [@lexicalWhileBranchAST] mLexicalWhileBranchList
  private let @location mLocation

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc checkLexicalInstruction (?!@lexiqueAnalysisContext ioLexiqueAnalysisContext,
                                         ?!@lexicalTagMap ioTagMap)  {
    for lexicalWhileBranch in self.mLexicalWhileBranchList do
      lexicalWhileBranch.mWhileExpression.checkLexicalExpression (!?ioLexiqueAnalysisContext)
      var tagMap = @lexicalTagMap.mapWithMapToOverride(ioTagMap)
      for instr in lexicalWhileBranch.mWhileInstructionList do
        instr.checkLexicalInstruction (!?ioLexiqueAnalysisContext, !?tagMap)
      end
    end
    var tagMap = @lexicalTagMap.mapWithMapToOverride(ioTagMap)
    for entry in self.mRepeatedInstructionList do
      entry.checkLexicalInstruction (!?ioLexiqueAnalysisContext, !?tagMap)
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func generateSwiftCocoaInstructionCode (?let @string inScannerClassName,
                                                   ?let @lexiqueAnalysisContext inLexiqueAnalysisContext) -> @string {
    result = "while (loop && scanningOk) {\n"
    !?result.incIndentation (2)
  //--- Repeated instruction
    for entry in self.mRepeatedInstructionList do
      result += entry.generateSwiftCocoaInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
    end
  //---
    for lexicalWhileBranch in self.mLexicalWhileBranchList
    do
      result += "if scanningOk && ("
      result += lexicalWhileBranch.mWhileExpression.generateSwiftCocoaConditionCode (inLexiqueAnalysisContext)
      result += ") {\n"
      !?result.incIndentation (2)
      for entry in lexicalWhileBranch.mWhileInstructionList do
        result += entry.generateSwiftCocoaInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
      end
      !?result.decIndentation (2)
    between
      result += "}else "
    end
    result += "}else{\n"
                        "  loop = false\n"
                        "}\n"
    !?result.decIndentation (2)
    result += "}\n"
              "loop = true\n"
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func lexicalInstructionUsesLoopLocalVariable () -> @bool {
    result = true
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func generateLexicalInstructionCode (?let @string inScannerClassName,
                                ?let @lexiqueAnalysisContext inLexiqueAnalysisContext) -> @string {
    result = "do {\n"
    !?result.incIndentation (2)
  //--- Repeated instruction
    for entry in self.mRepeatedInstructionList do
      result += entry.generateLexicalInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
    end
  //---
    for lexicalWhileBranch in self.mLexicalWhileBranchList
    do
      result += "if ("
      result += lexicalWhileBranch.mWhileExpression.generateConditionCode (!context:inLexiqueAnalysisContext)
      result += ") {\n"
      !?result.incIndentation (2)
      for entry in lexicalWhileBranch.mWhileInstructionList do
        result += entry.generateLexicalInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
      end
      !?result.decIndentation (2)
    between
      result += "}else "
    end
    result += "}else{\n"
                        "  loop = false ;\n"
                        "}\n"
    !?result.decIndentation (2)
    result += "}while (loop) ;\n"
              "loop = true ;\n"
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

