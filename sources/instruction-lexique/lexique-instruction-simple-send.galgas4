//! SYNTAX

syntax extension galgas4LexiqueComponentSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <lexical_send_instruction> (!@lexicalInstructionAST outInstruction) {
    $\$terminal\$$ (?let @lstring sentTerminal)
    outInstruction = @lexicalSimpleSendInstructionAST (sentTerminal)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! AST
//--------------------------------------------------------------------------------------------------

final class @lexicalSimpleSendInstructionAST : @lexicalInstructionAST {
  private let @lstring mSentTerminal

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc checkLexicalInstruction (?!@lexiqueAnalysisContext ioLexiqueAnalysisContext,
                                         ?!@lexicalTagMap _ioTagMap)  {
    ioLexiqueAnalysisContext.mTerminalMap.searchKey (self.mSentTerminal, ?*)
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  override func generateSwiftCocoaInstructionCode (?let @string inScannerClassName,
                                  ?let @lexiqueAnalysisContext _inLexiqueAnalysisContext) -> @string {
    result = "tokenCode = " + inScannerClassName + "_1_" + self.mSentTerminal.string.identifierRepresentation + "\n"
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  override func lexicalInstructionUsesLoopLocalVariable () -> @bool {
    result = false
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  override func generateLexicalInstructionCode (?let @string _inScannerClassName,
                                  ?let @lexiqueAnalysisContext _inLexiqueAnalysisContext) -> @string {
    result  = "token.mTokenCode = kToken_" + self.mSentTerminal.string.identifierRepresentation + " ;\n"
    result += "enterToken (token) ;\n"
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
