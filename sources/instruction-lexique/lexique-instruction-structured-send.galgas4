//--------------------------------------------------------------------------------------------------
//! SYNTAX
//--------------------------------------------------------------------------------------------------

syntax extension galgas4LexiqueComponentSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <lexical_send_instruction> (!@lexicalInstructionAST outInstruction) {
    var [@lexicalSendSearchAST] lexicalSendSearchList = @()
    $#searchString$
    repeat
      $identifier$ (?let @lstring attributeName)
      $in$
      $identifier$ (?let @lstring searchListName)
      lexicalSendSearchList ++= @(attributeName, searchListName)
      $default$
    while
      $#searchString$
    end
    let @lexicalSendDefaultActionAST lexicalSendDefaultAction
    select
      $\$terminal\$$ (?let @lstring defaultSentTerminal)
      lexicalSendDefaultAction = @lexicalSendTerminalByDefaultAST (defaultSentTerminal)
    or
      $error$
      $identifier$ (?let @lstring defaultErrorMessageName)
      lexicalSendDefaultAction = @lexicalErrorByDefaultAST (defaultErrorMessageName)
    end
    outInstruction = @lexicalStructuredSendInstructionAST (
      lexicalSendSearchList,
      lexicalSendDefaultAction
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! AST
//--------------------------------------------------------------------------------------------------

final class @lexicalStructuredSendInstructionAST : @lexicalInstructionAST {
  private let [@lexicalSendSearchAST] mLexicalSendSearchList
  private let @lexicalSendDefaultActionAST mLexicalSendDefaultAction

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc checkLexicalInstruction (?!@lexiqueAnalysisContext ioLexiqueAnalysisContext,
                                         ?!@lexicalTagMap _ioTagMap) {
    for lexicalSendSearch in self.mLexicalSendSearchList do
      !?ioLexiqueAnalysisContext.mLexicalTokenListMap.setMShouldBeGeneratedForKey (true, lexicalSendSearch.mSearchListName.string)
      ioLexiqueAnalysisContext.mLexicalAttributeMap.searchKey (lexicalSendSearch.mAttributeName, ?*)
    end
    self.mLexicalSendDefaultAction.checkLexicalDefaultAction (!?ioLexiqueAnalysisContext)
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  override func generateSwiftCocoaInstructionCode (?let @string inScannerClassName,
                                 ?let @lexiqueAnalysisContext _inLexiqueAnalysisContext) -> @string {
    result = ""
    for lexicalSendSearch in self.mLexicalSendSearchList do
      result += "if (tokenCode == 0) {\n"
      result += "  tokenCode = search_into_" + inScannerClassName.identifierRepresentation
      result += "_" + lexicalSendSearch.mSearchListName + " (mLexicalAttribute_" + lexicalSendSearch.mAttributeName + ") ;\n"
      result += "}\n"
    end
    result += "if tokenCode == 0 {\n"
    result += "  " + self.mLexicalSendDefaultAction.generateSwiftCocoaDefaultSendCode (inScannerClassName)
    result += "}\n"
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  override func lexicalInstructionUsesLoopLocalVariable () -> @bool {
    result = false
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  
  override func generateLexicalInstructionCode (?let @string inScannerClassName,
                               ?let @lexiqueAnalysisContext _inLexiqueAnalysisContext) -> @string {
    result = ""
    for lexicalSendSearch in self.mLexicalSendSearchList do
      result += "if (token.mTokenCode == -1) {\n"
      result += "  token.mTokenCode = search_into_" + lexicalSendSearch.mSearchListName + " (token.mLexicalAttribute_" + lexicalSendSearch.mAttributeName.string.identifierRepresentation + ") ;\n"
      result += "}\n"
    end
    result += "if (token.mTokenCode == -1) {\n"
    result += "  " + self.mLexicalSendDefaultAction.generateDefaultSendCode (inScannerClassName)
    result += "}\n"
    result += "enterToken (token) ;\n"
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

