//--------------------------------------------------------------------------------------------------
//   SYNTAX
//--------------------------------------------------------------------------------------------------

syntax extension galgas4DeclarationsSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //! Filewrapper Declaration
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <declaration> (?!@galgasDeclarationAST ioDeclarations) {
    $filewrapper$
    <filewrapper_declaration> (!private: false, !?ioDeclarations)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <declaration> (?!@galgasDeclarationAST ioDeclarations) {
    $private$
    $filewrapper$
    <filewrapper_declaration> (!private: true, !?ioDeclarations)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <filewrapper_declaration> (?private: @bool inIsPrivate, ?!@galgasDeclarationAST ioDeclarations) {
    $@type$ (?let @lstring filewrapperName) indexing (filewrapperDefinition)
    $:$
    $"string"$ (?let @lstring filewrapperPath)
    var [@lstring] filewrapperTextFileExtensionList = []
    var [@lstring] filewrapperBinaryFileExtensionList = []
    var [@filewrapperTemplateAST] filewrapperTemplateList = []
    ${$
    repeat
    while
      $#textFileExtension$
      $"string"$ (?let @lstring pathExtension)
      filewrapperTextFileExtensionList ++= pathExtension
    while
      $#binaryFileExtension$
      $"string"$ (?let @lstring pathExtension)
      filewrapperBinaryFileExtensionList ++= pathExtension
    while
      $template$
      $identifier$ (?let mFilewrapperTemplateName)
      $:$
      $"string"$ (?let mFilewrapperTemplatePath)
      var [@formalTemplateInputParameterAST] filewrapperTemplateFormalInputParameters = @()
      $($
      select
      or
        repeat
          let @lstring selector
          select
            selector = "".nowhere
          or
            $?$
            selector = "".nowhere
          or
            $?selector:$ (?selector)
          end
          <type_definition> (!?ioDeclarations, ?let typeName)
          $identifier$ (?let argumentName)
          let isUnused = argumentName.hasPrefix ("_")
          filewrapperTemplateFormalInputParameters ++= @(selector, typeName, argumentName, isUnused)
        while
          $,$
        end
      end
      $)$
      filewrapperTemplateList ++= @(
        mFilewrapperTemplateName,
        mFilewrapperTemplatePath,
        filewrapperTemplateFormalInputParameters
      )
    end
    $}$
    ioDeclarations.mDeclarationList ++= @filewrapperDeclarationAST (
      !isPredefined: false, // Is not predefined
      inIsPrivate,
      @string.stringWithSourceFilePath,
      filewrapperName,
      filewrapperPath,
      filewrapperTextFileExtensionList,
      filewrapperBinaryFileExtensionList,
      filewrapperTemplateList
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//  AST
//--------------------------------------------------------------------------------------------------

struct @formalTemplateInputParameterAST {
  public let @lstring mFormalTemplateSelector
  public let @lstring mFormalArgumentTypeName
  public let @lstring mFormalArgumentName
  public let @bool mIsUnused
}

//--------------------------------------------------------------------------------------------------

struct @filewrapperTemplateAST {
  public let @lstring mFilewrapperTemplateName
  public let @lstring mFilewrapperTemplatePath
  public let [@formalTemplateInputParameterAST] mFilewrapperTemplateFormalInputParameters
}

//--------------------------------------------------------------------------------------------------

map @filewrapperMap {
  public let @lstring mFilewrapperPath
  public let [@lstring] mFilewrapperExtensionList
  public let @wrapperFileMap mFilewrapperFileMap
  public let @wrapperDirectoryMap mFilewrapperDirectoryMap
  public let @bool mIsInternal
  #insertSetter insertKey #errorMessage "the '%K' filewrapper has been already declared in %L"
  #searchMethod searchKey #errorMessage "the '%K' filewrapper is not declared"
}

//--------------------------------------------------------------------------------------------------

map @wrapperExtensionMap {
  #insertSetter insertKey #errorMessage "the '%K' extension has been already declared"
}

//--------------------------------------------------------------------------------------------------

struct @filewrapperTemplateForGeneration {
  public let @string mFilewrapperTemplateName
  public let [@formalInputParameterForGeneration] mFilewrapperTemplateFormalInputParameters
  public let [@templateInstructionForGeneration] mTemplateInstructionListForGeneration
}

//--------------------------------------------------------------------------------------------------

final class @filewrapperDeclarationAST : @semanticDeclarationAST {
  public let @bool mIsInternal
  public let @string mSourceFileAbsolutePath
  public let @lstring mFilewrapperName
  public let @lstring mFilewrapperPath
  public let [@lstring] mFilewrapperTextFileExtensionList
  public let [@lstring] mFilewrapperBinaryFileExtensionList
  public let [@filewrapperTemplateAST] mFilewrapperTemplateList

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func keyRepresentation () -> @string {
    result = "filewrapper @" + self.mFilewrapperName
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -


  override proc enterDeclarationInGraph (?!@semanticTypePrecedenceGraph ioSemanticTypePrecedenceGraph,
                                         ?!@equatableExtensionMap _ioEquatableExtensionMap,
                     ?!@extensionInitializerForBuildingContext _ioExtensionInitializerForBuildingContext,
                     ?!@extensionMethodMapForBuildingContext _ioExtensionMethodMapForBuildingContext,
                     ?!@extensionGetterMapForBuildingContext _ioExtensionGetterMapForBuildingContext,
                     ?!@extensionSetterMapForBuildingContext _ioExtensionSetterMapForBuildingContext,
                     ?![@semanticDeclarationAST] _ioExtensionOverrideDefinitionList) {
    let key = @lstring ("@" + self.mFilewrapperName, self.mFilewrapperName.location)
    !?ioSemanticTypePrecedenceGraph.addNode (key, self)
    for templ in self.mFilewrapperTemplateList do
      for formal in templ.mFilewrapperTemplateFormalInputParameters do
        let argKey = @lstring ("@" + formal.mFormalArgumentTypeName, formal.mFormalArgumentTypeName.location)
        !?ioSemanticTypePrecedenceGraph.noteNode (argKey)
      end
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterDeclarationInSemanticContext (?!@equatableExtensionMap _ioEquatableExtensionMap,
                                  let @extensionInitializerForBuildingContext inExtensionInitializerMapForBuildingContext,
                                  let @extensionMethodMapForBuildingContext inExtensionMethodMapForBuildingContext,
                                  let @extensionGetterMapForBuildingContext inExtensionGetterMapForBuildingContext,
                                  let @extensionSetterMapForBuildingContext inExtensionSetterMapForBuildingContext,
                                  ?!@unifiedTypeMap ioTypeMap,
                                  ?!@semanticContext ioSemanticContext) {
  //--- Build text file extension map
    var @wrapperExtensionMap textExtensionMap = @()
    for value in self.mFilewrapperTextFileExtensionList do
      !?textExtensionMap.insertKey (value)
    end
  //--- Build binary file extension map
    var @wrapperExtensionMap binaryFileExtensionMap = @()
    for value in self.mFilewrapperBinaryFileExtensionList do
      if textExtensionMap.contains (value.string) then
        error value: "the '" + value + "' extension is already used for text files"
      else
      !?binaryFileExtensionMap.insertKey (value)
      end
    end
  //--- Enumerate filewrapper files
    let @wrapperFileMap regularRootFileMap
    let @wrapperDirectoryMap wrapperDirectoryMap
    let absoluteSourcePath = self.mSourceFileAbsolutePath.deletingLastPathComponent + "/" + self.mFilewrapperPath.string
    if not absoluteSourcePath.directoryExists then
      error self.mFilewrapperPath: "The '" + absoluteSourcePath + "' directory does not exist"
      spoil regularRootFileMap, wrapperDirectoryMap
    else
    //--- Enumerate paths
      var @uint wrapperFileIndex = 0
      var @uint wrapperDirectoryIndex = 0
      recursivelyEnumerateDirectories (
       absoluteSourcePath,
       "/",
       textExtensionMap,
       binaryFileExtensionMap,
       ?regularRootFileMap,
       ?wrapperDirectoryMap,
       !?wrapperFileIndex,
       !?wrapperDirectoryIndex
     )
    end
  //--- Insert filewrapper
    !?ioSemanticContext.mFilewrapperMap.insertKey (
      self.mFilewrapperName,
      self.mFilewrapperPath,
      self.mFilewrapperTextFileExtensionList,
      regularRootFileMap,
      wrapperDirectoryMap,
      self.mIsInternal
    )
  //--- Getters
    commonGetterMapForAllTypes (!?ioTypeMap, ?var @getterMap getterMap)
  //--- Class function 'contents': returns a @filewrapper instance
    var @classFunctionMap classFunctionMap = @()
    !?ioTypeMap.makeEntryFromString ("filewrapper", ?let filewrapperType)
    !?classFunctionMap.insertKey (
       @("contents", self.mFilewrapperName.location),
       !argumentTypeList: [],
       !hasCompilerArgument: false,
       !returnedType: filewrapperType
    )
  //--- Templates are class functions
    !?ioTypeMap.makeEntryFromString ("string", ?let stringType)
    for aTemplate in self.mFilewrapperTemplateList do
      var formalArgumentList = [@functionSignatureElement] ()
      for formalInputArgument in aTemplate.mFilewrapperTemplateFormalInputParameters do
        !?ioTypeMap.makeEntry (formalInputArgument.mFormalArgumentTypeName, ?let typeIndex)
        formalArgumentList ++= @(
          formalInputArgument.mFormalTemplateSelector,
          typeIndex,
          formalInputArgument.mFormalArgumentName.string,
          true
        )
      end
      !?classFunctionMap.insertKey (
         aTemplate.mFilewrapperTemplateName,
         !argumentTypeList: formalArgumentList,
         !hasCompilerArgument: true,
         !returnedType: stringType
      )
    end
  //--- Add extensions
    var @setterMap setterMap = @()
    var @instanceMethodMap instanceMethodMap = @()
    var @initializerMap initializerMap = @()
    addExtensions (
      inExtensionInitializerMapForBuildingContext,
      inExtensionMethodMapForBuildingContext,
      inExtensionGetterMapForBuildingContext,
      inExtensionSetterMapForBuildingContext,
      !?ioSemanticContext,
      !?ioTypeMap,
      self.mFilewrapperName,
      !isClass: false,
      !?initializerMap,
      !?getterMap,
      !?setterMap,
      !?instanceMethodMap,
      !acceptSetters: true
    )
    let features = @typeFeatures.generateDescriptionGetterUtilityMethod 
 //--- Enter in type map
    let typeDefinition = @unifiedTypeDefinition (
      !typeName: self.mFilewrapperName,
      !isPredefined: false,
      !isConcrete: true,
      !isFinal: true,
      !superType: .null,
      !typeKind: .packageType,
      !supportArrayLiteral: false,
      !allTypedPropertyList: [],
      !propertyMap: @(),
      !currentTypedPropertyList: [],
      !initializerMap: @(),
      !classFunctionMap: classFunctionMap,
      !getterMap: getterMap,
      !setterMap: setterMap,
      !instanceMethodMap: instanceMethodMap,
      !classMethodMap: @(),
      !unwrappedType: .null,
      !readSubscriptMap: @(),
      !writeSubscriptMap: @(),
      !enumerationDescriptorList: @(),
      !features: features,
      !generateHeaderInSeparateFile: false,
      !typeForEnumeratedElement: .null,
      !headerFileName: "filewrapper-" + self.mFilewrapperName.string.fileNameRepresentation,
      !headerKind: .oneHeader
    )
    !?ioTypeMap.insertType (typeDefinition.typeName, typeDefinition)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc semanticAnalysis (?![@lstring] _ioUsefulnessRootEntities,
                                  ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
                                  let @string _inProductDirectory,
                                  let @semanticContext inSemanticContext,
                                  ?!@unifiedTypeMap ioTypeMap,
                                  let @predefinedTypes inPredefinedTypes,
                                  ?![@semanticDeclarationForGeneration] ioSemanticDeclarationListForGeneration) {
  //--- Useful entities graph
    let filewrapperNameForUsefulness = typeNameForUsefulEntitiesGraph (self.mFilewrapperName)
    !?ioUsefulEntitiesGraph.addNode (filewrapperNameForUsefulness, filewrapperNameForUsefulness)
  //--- Build absolute path
    let absoluteSourcePath = self.mSourceFileAbsolutePath.deletingLastPathComponent + "/" + self.mFilewrapperPath.string
    if not absoluteSourcePath.directoryExists then
      error self.mFilewrapperPath: "The '" + absoluteSourcePath + "' directory does not exist"
    else
    //--- Build text file extension map
      var @wrapperExtensionMap textExtensionMap = @()
      for value in self.mFilewrapperTextFileExtensionList do
        !?textExtensionMap.insertKey (value)
      end
    //--- Build binary file extension map
      var @wrapperExtensionMap binaryFileExtensionMap = @()
      for value in self.mFilewrapperBinaryFileExtensionList do
        if textExtensionMap.contains (value.string) then
          error value: "the '" + value + "' extension is already used for text files"
        else
        !?binaryFileExtensionMap.insertKey (value)
        end
      end
    //--- Enumerate filewrapper files
      let @wrapperFileMap regularRootFileMap
      let @wrapperDirectoryMap wrapperDirectoryMap
      let absoluteSourcePath = self.mSourceFileAbsolutePath.deletingLastPathComponent + "/" + self.mFilewrapperPath.string
      if not absoluteSourcePath.directoryExists then
        error self.mFilewrapperPath: "The '" + absoluteSourcePath + "' directory does not exist"
        spoil regularRootFileMap, wrapperDirectoryMap
      else
      //--- Enumerate paths
        var @uint wrapperFileIndex = 0
        var @uint wrapperDirectoryIndex = 0
        recursivelyEnumerateDirectories (
         absoluteSourcePath,
         "/",
         textExtensionMap,
         binaryFileExtensionMap,
         ?regularRootFileMap,
         ?wrapperDirectoryMap,
         !?wrapperFileIndex,
         !?wrapperDirectoryIndex
       )
      end
    //-------------------------------- Analyze filewrapper templates
      var [@filewrapperTemplateForGeneration] filewrapperTemplateListForGeneration = []
      for filewrapperTemplate in self.mFilewrapperTemplateList do
        if filewrapperTemplate.mFilewrapperTemplatePath.string.firstCharacterOrNul == '/' then
          error filewrapperTemplate.mFilewrapperTemplatePath
           : "the path should not begin with a '/'; it is relative to filewrapper path '" + absoluteSourcePath + "'"
        end
        let absoluteTemplatePath = absoluteSourcePath + "/" + filewrapperTemplate.mFilewrapperTemplatePath
      //--- Parse template
        grammar templateGrammar (?let [@templateInstructionAST] resultingInstructionList)
           in @lstring (absoluteTemplatePath, filewrapperTemplate.mFilewrapperTemplatePath.location)
      //--- Build template variable map
        var @templateVariableMap templateVariableMap = @()
        var [@formalInputParameterForGeneration] filewrapperTemplateFormalInputParameters = @()
        for formal in filewrapperTemplate.mFilewrapperTemplateFormalInputParameters do
          let type = ioTypeMap.typeMapEntryForLKey (formal.mFormalArgumentTypeName)
          let @string cppVarName = "in_" + formal.mFormalArgumentName.string.identifierRepresentation
          !?templateVariableMap.insertKey (formal.mFormalArgumentName, type, cppVarName)
          filewrapperTemplateFormalInputParameters ++= @(formal.mFormalTemplateSelector, type, cppVarName, formal.mFormalArgumentName, true)
        end
      //--- Analyze template
        var templateInstructionListForGeneration = [@templateInstructionForGeneration] ()
        let templateAnalysisContext = @templateAnalysisContext (
          inSemanticContext,
          inPredefinedTypes,
          templateVariableMap
        )
        templateInstructionListAnalysis (
          filewrapperNameForUsefulness,
          !?ioUsefulEntitiesGraph,
          templateAnalysisContext,
          !?ioTypeMap,
          resultingInstructionList,
          !?templateInstructionListForGeneration
        )
      //--- Enter in generation list
        filewrapperTemplateListForGeneration ++= @(
          filewrapperTemplate.mFilewrapperTemplateName.string,
          filewrapperTemplateFormalInputParameters,
          templateInstructionListForGeneration
        )
      end
    //---
      ioSemanticDeclarationListForGeneration ++= @filewrapperTypeForGeneration (
        !infoMessage: "filewrapper " + self.mFilewrapperName,
        ioTypeMap.typeMapEntryForLKey (self.mFilewrapperName),
        filewrapperTemplateListForGeneration,
        regularRootFileMap,
        wrapperDirectoryMap
      )
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//   CODE GENERATION
//--------------------------------------------------------------------------------------------------

final class @filewrapperTypeForGeneration : @semanticTypeForGeneration {
  private let [@filewrapperTemplateForGeneration] filewrapperTemplateListForGeneration
  private let @wrapperFileMap regularRootFileMap
  private let @wrapperDirectoryMap wrapperDirectoryMap

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc appendDeclaration1 (?!@stringset _ioInclusionSet,
                                    !@string outHeader) {
    let selfTypeDefinition = self.mSelfTypeEntry.definition
    var regularFileIndexStringList = [@string] ()
    var regularBinaryContentIndexStringList = [@string] ()
    var regularTextContentIndexStringList = [@string] ()
    var directoryIndexStringList = [@string] ()
    recursivlyEnumerateRegularFile (
      self.regularRootFileMap,
      self.wrapperDirectoryMap,
      !?regularFileIndexStringList,
      !?directoryIndexStringList,
      !?regularTextContentIndexStringList,
      !?regularBinaryContentIndexStringList
    )
    outHeader = @filewrapperGenerationTemplate.filewrapperDeclaration (
      regularFileIndexStringList,
      directoryIndexStringList,
      regularTextContentIndexStringList,
      regularBinaryContentIndexStringList,
      selfTypeDefinition.typeName.string
    )
    outHeader += @filewrapperGenerationTemplate.filewrapperTypeHeader1 (
      selfTypeDefinition.typeName.string,
      selfTypeDefinition.typeName.string.identifierRepresentation
    )
    outHeader += @typeGenerationTemplate.unifiedClassBodyForPackage (
      selfTypeDefinition.typeName.string,
      selfTypeDefinition.typeName.string.identifierRepresentation,
      selfTypeDefinition.classFunctionMap,
      selfTypeDefinition.classMethodMap
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc appendSpecificImplementation (let @unifiedTypeMap _inTypeMap,
                                              ?!@stringset ioInclusionSet,
                                              !@string outImplementation) {
    self.mSelfTypeEntry.addHeaderFileName (!?ioInclusionSet)
    outImplementation = ""
  //--- Embedded files
    var @string filewrapperImplementation = ""
    generateWrapperContents (
      self.mSelfTypeEntry.definition.typeName.string,
      "",
      0,
      self.regularRootFileMap,
      self.wrapperDirectoryMap,
      !?filewrapperImplementation
    )
    outImplementation += @filewrapperGenerationTemplate.filewrapperImplementation (
      self.mSelfTypeEntry.definition.typeName.string,
      filewrapperImplementation
    )
  //--- Type
    outImplementation += @filewrapperGenerationTemplate.filewrapperTypeSpecificImplementation (
      self.mSelfTypeEntry.definition.typeName.string,
      self.mSelfTypeEntry.identifierRepresentation
    )
  //--- template generation
    for filewrapperTemplate in self.filewrapperTemplateListForGeneration do
    //--- Build generated code for instruction list
      var @string generatedCodeForInstructionList = ""
      var @uint temporaryVariableIndex = 0
      var @stringset unusedVariableCppNameSet = @()
      unusedVariableCppNameSet ++= gCompilerCppName
      for entry in filewrapperTemplate.mFilewrapperTemplateFormalInputParameters do
        unusedVariableCppNameSet ++= entry.mFormalArgumentCppName
      end
      var @bool useColumnMarker = false
      templateCodeGenerationForListInstruction (
        filewrapperTemplate.mTemplateInstructionListForGeneration,
        !?generatedCodeForInstructionList,
        !?ioInclusionSet,
        !?temporaryVariableIndex,
        !?unusedVariableCppNameSet,
        !?useColumnMarker
      )
   //---
      outImplementation += @filewrapperGenerationTemplate.filewrapperTemplateImplementation (
        self.mSelfTypeEntry.definition.typeName.string,
        filewrapperTemplate.mFilewrapperTemplateName,
        filewrapperTemplate.mFilewrapperTemplateFormalInputParameters,
        unusedVariableCppNameSet,
        useColumnMarker,
        generatedCodeForInstructionList
      )
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

filewrapper @filewrapperGenerationTemplate : "../+generation-templates/type_generation" {

  template filewrapperTypeHeader1 : "GALGAS_filewrapper.h1.galgasTemplate" (
    ?@string TYPE_NAME,
    ?@string TYPE_IDENTIFIER
  )

  template filewrapperTypeSpecificImplementation : "GALGAS_filewrapper.cpp.galgasTemplate" (
    ?@string TYPE_NAME,
    ?@string TYPE_IDENTIFIER
  )

  template filewrapperTemplateImplementation : "filewrapper-type-template.cpp.galgasTemplate" (
    ?@string TYPE_NAME,
    ?@string TEMPLATE_NAME,
    ?[@formalInputParameterForGeneration] FORMAL_ARGUMENT_LIST,
    ?@stringset UNUSED_VAR_SET,
    ?@bool USES_COLUMN_MARKER,
    ?@string GENERATED_INSTRUCTION_STRING
  )

  template filewrapperDeclaration : "filewrapper-contents-declaration.h.galgasTemplate" (
    ?[@string] FILE_INDEX_STRING_LIST,
    ?[@string] DIRECTORY_INDEX_STRING_LIST,
    ?[@string] TEXT_CONTENT_INDEX_STRING_LIST,
    ?[@string] BINARY_CONTENT_INDEX_STRING_LIST,
    ?@string FILEWRAPPER_NAME
  )

  template filewrapperImplementation : "filewrapper-contents-implementation.cpp.galgasTemplate" (
    ?@string FILEWRAPPER_NAME,
    ?@string FILEWRAPPER_IMPLEMENTATION
  )
}

//--------------------------------------------------------------------------------------------------

map @wrapperFileMap { // Key is file name
  public let @string mAbsoluteFilePath
  public let @bool mIsTextFile // true: text file, false: binary file
  public let @uint mWrapperDirectoryIndex
  public let @uint mWrapperFileIndex
  #insertSetter insertKey #errorMessage "INTERNAL ERROR"
  #searchMethod searchKey #errorMessage "INTERNAL ERROR"
}

//--------------------------------------------------------------------------------------------------

map @wrapperDirectoryMap { // Key is directory name
  public let @wrapperFileMap mRegularFileMap
  public let @wrapperDirectoryMap mDirectoryMap
  public let @uint mWrapperDirectoryIndex
  #insertSetter insertKey #errorMessage "INTERNAL ERROR"
  #searchMethod searchKey #errorMessage "INTERNAL ERROR"
}

//--------------------------------------------------------------------------------------------------

private proc generateWrapperContents (let @string inFilewrapperName,
                                      let @string inFilewrapperDirectory,
                                      let @uint inFilewrapperDirectoryIndex,
                                      let @wrapperFileMap inFilewrapperRegularFileMap,
                                      let @wrapperDirectoryMap inFilewrapperDirectoryMap,
                                      ?!@string ioImplementation) {
//--- Generate regular files
  for filewrapperRegularFile in inFilewrapperRegularFileMap do
    if filewrapperRegularFile.mIsTextFile then
      let contents = @string.stringWithContentsOfFile (filewrapperRegularFile.mAbsoluteFilePath)
      ioImplementation += "//--- File '" + inFilewrapperDirectory + "/" + filewrapperRegularFile.lkey + "'\n\n"
      ioImplementation +=  "const char * gWrapperFileContent_"
      ioImplementation += filewrapperRegularFile.mWrapperFileIndex.string
      ioImplementation += "_"
      ioImplementation += inFilewrapperName.identifierRepresentation
      ioImplementation += " = "
      if contents.count > 100 then
        var components = contents.componentsSeparatedByString ("\n")
        !?components.removeLast (?let lastLine)
        for value in components
        before
          ioImplementation += "\n  "
        do
          let s = value + "\n"
          ioImplementation += s.utf8RepresentationEscapingQuestionMark + "\n  "
        end
        if lastLine.count > 0 then
          ioImplementation += lastLine.utf8RepresentationEscapingQuestionMark
        end
      else
        ioImplementation += contents.utf8RepresentationEscapingQuestionMark
      end
      ioImplementation += " ;\n\nconst RegularFileWrapper gWrapperFile_"
      ioImplementation += filewrapperRegularFile.mWrapperFileIndex.string
      ioImplementation += "_"
      ioImplementation += inFilewrapperName.identifierRepresentation
      ioImplementation += " (\n  "
      ioImplementation += filewrapperRegularFile.lkey.string.utf8RepresentationEscapingQuestionMark
      ioImplementation += ",\n  "
      ioImplementation += filewrapperRegularFile.lkey.string.pathExtension.utf8RepresentationEscapingQuestionMark
      ioImplementation += ",\n  true, // Text file\n "
      ioImplementation += contents.count
      ioImplementation += ", // Text length\n  gWrapperFileContent_"
      ioImplementation += filewrapperRegularFile.mWrapperFileIndex.string
      ioImplementation += "_"
      ioImplementation += inFilewrapperName.identifierRepresentation
      ioImplementation += "\n) ;\n\n"
    else
      let @data contents = @data.dataWithContentsOfFile (filewrapperRegularFile.mAbsoluteFilePath)
      ioImplementation += "//--- File '" + inFilewrapperDirectory + "/" + filewrapperRegularFile.lkey + "'\n\n"
      +  "const uint8_t gWrapperFileContent_"
      + filewrapperRegularFile.mWrapperFileIndex.string + "_"
      + inFilewrapperName.identifierRepresentation + " [" + contents.count + "] = {"
      + contents.cStringRepresentation + "} ;\n\n"
      + "const RegularFileWrapper gWrapperFile_" + filewrapperRegularFile.mWrapperFileIndex.string+ "_"
      + inFilewrapperName.identifierRepresentation + " (\n"
      + "  " + filewrapperRegularFile.lkey.string.utf8RepresentationEscapingQuestionMark + ",\n"
      + "  " + filewrapperRegularFile.lkey.string.pathExtension.utf8RepresentationEscapingQuestionMark + ",\n"
      + "  false, // binary file\n"
      + "  " + contents.count + ", // Length\n"
      + "  (const char *) gWrapperFileContent_" + filewrapperRegularFile.mWrapperFileIndex.string + "_" + inFilewrapperName.identifierRepresentation +"\n"
      + ") ;\n\n"
    end
  end
//--- Generate sub-directories
  for filewrapperDirectory in inFilewrapperDirectoryMap do
    generateWrapperContents (
      inFilewrapperName,
      filewrapperDirectory.lkey.string,
      filewrapperDirectory.mWrapperDirectoryIndex,
      filewrapperDirectory.mRegularFileMap,
      filewrapperDirectory.mDirectoryMap,
      !?ioImplementation
    )
  end
//--- Generate all Filewrapper list
  ioImplementation += "//--- All files of '" + inFilewrapperDirectory + "' directory\n\n"
  + "static const RegularFileWrapper * gWrapperAllFiles_"
  + inFilewrapperName.identifierRepresentation + "_" + inFilewrapperDirectoryIndex.string
  + " [" + (inFilewrapperRegularFileMap.count + 1).string + "] = {\n"
  for filewrapperRegularFile in inFilewrapperRegularFileMap do
    ioImplementation += "  & gWrapperFile_" + filewrapperRegularFile.mWrapperFileIndex.string + "_" + inFilewrapperName.identifierRepresentation + ",\n"
  end
  ioImplementation += "  nullptr\n"
  +"} ;\n\n"
//--- Generate all directory wrapper list
  ioImplementation += "//--- All sub-directories of '" + inFilewrapperDirectory + "' directory\n\n"
  + "static const DirectoryWrapper * gWrapperAllDirectories_"
  + inFilewrapperName.identifierRepresentation + "_" + inFilewrapperDirectoryIndex.string
  + " [" + (inFilewrapperDirectoryMap.count + 1).string + "] = {\n"
  for entry in inFilewrapperDirectoryMap do
    ioImplementation += "  & gWrapperDirectory_" + entry.mWrapperDirectoryIndex.string + "_" + inFilewrapperName.identifierRepresentation + ",\n"
  end
  ioImplementation += "  nullptr\n"
  + "} ;\n\n"
//--- Generate directory wrapper
  ioImplementation += "//--- Directory '" + inFilewrapperDirectory + "'\n\n"
  + "const DirectoryWrapper gWrapperDirectory_" + inFilewrapperDirectoryIndex.string + "_"
  + inFilewrapperName.identifierRepresentation + " (\n"
  + "  " + inFilewrapperDirectory.utf8RepresentationEscapingQuestionMark + ",\n"
  + "  " + inFilewrapperRegularFileMap.count.string + ",\n"
  + "  gWrapperAllFiles_" + inFilewrapperName.identifierRepresentation + "_" + inFilewrapperDirectoryIndex.string + ",\n"
  + "  " + inFilewrapperDirectoryMap.count.string + ",\n"
  + "  gWrapperAllDirectories_" + inFilewrapperName.identifierRepresentation + "_" + inFilewrapperDirectoryIndex.string + "\n"
  + ") ;\n\n"
}

//--------------------------------------------------------------------------------------------------

private proc recursivelyEnumerateDirectories (let @string inAbsoluteSourcePath,
                                              let @string inPathInWrapper,
                                              let @wrapperExtensionMap inTextFileExtensionMap,
                                              let @wrapperExtensionMap inBinaryFileExtensionMap,
                                              !@wrapperFileMap outWrapperFileMap,
                                              !@wrapperDirectoryMap outWrapperDirectoryMap,
                                              ?!@uint ioWrapperFileIndex,
                                              ?!@uint ioWrapperDirectoryIndex) {
  let @uint currentDirectoryIndex = ioWrapperDirectoryIndex
  ioWrapperDirectoryIndex += 1
//--- Enumerates regular files
  let [@string] files = inAbsoluteSourcePath.regularFiles (false)
  outWrapperFileMap = @()
  for value in files do
    if inTextFileExtensionMap.contains (value.pathExtension) then
      let @string absoluteFilePath = inAbsoluteSourcePath + "/" + value
      !?outWrapperFileMap.insertKey
        (@lstring (value, @location.here),
        absoluteFilePath,
        true, // Text File
        currentDirectoryIndex,
        ioWrapperFileIndex
      )
      ioWrapperFileIndex += 1
    elsif inBinaryFileExtensionMap.contains (value.pathExtension) then
      let @string absoluteFilePath = inAbsoluteSourcePath + "/" + value
      !?outWrapperFileMap.insertKey
        (@lstring (value, @location.here),
        absoluteFilePath,
        false, // Binary file
        currentDirectoryIndex,
        ioWrapperFileIndex
      )
      ioWrapperFileIndex += 1
    end
  end
//--- Enumerates regular directories
  let [@string] directories = inAbsoluteSourcePath.directories (false)
  outWrapperDirectoryMap = @()
  for value in directories do
    let @uint theDirectoryIndex = ioWrapperDirectoryIndex
    recursivelyEnumerateDirectories (
      inAbsoluteSourcePath + "/" + value,
      inPathInWrapper + value + "/",
      inTextFileExtensionMap,
      inBinaryFileExtensionMap,
      ?let internalWrapperFileMap,
      ?let internalWrapperDirectoryMap,
      !?ioWrapperFileIndex,
      !?ioWrapperDirectoryIndex
    )
    !?outWrapperDirectoryMap.insertKey (
      value.here,
      internalWrapperFileMap,
      internalWrapperDirectoryMap,
      theDirectoryIndex
    )
  end
}

//--------------------------------------------------------------------------------------------------

private proc recursivlyEnumerateRegularFile (let @wrapperFileMap inFilewrapperFileMap,
                                             let @wrapperDirectoryMap inFilewrapperDirectoryMap,
                                             ?![@string] ioRegularFileIndexStringList,
                                             ?![@string] ioDirectoryIndexStringList,
                                             ?![@string] ioRegularTextContentIndexStringList,
                                             ?![@string] ioRegularBinaryContentIndexStringList) {
  ioDirectoryIndexStringList ++= ioDirectoryIndexStringList.count.string
  for filewrapperFile in inFilewrapperFileMap do
    ioRegularFileIndexStringList ++= ioRegularFileIndexStringList.count.string
    if filewrapperFile.mIsTextFile then
      ioRegularTextContentIndexStringList ++= filewrapperFile.mWrapperFileIndex.string
    else
      ioRegularBinaryContentIndexStringList ++= filewrapperFile.mWrapperFileIndex.string
    end
  end
  for filewrapperDirectory in inFilewrapperDirectoryMap do
    recursivlyEnumerateRegularFile (
      filewrapperDirectory.mRegularFileMap,
      filewrapperDirectory.mDirectoryMap,
      !?ioRegularFileIndexStringList,
      !?ioDirectoryIndexStringList,
      !?ioRegularTextContentIndexStringList,
      !?ioRegularBinaryContentIndexStringList
    )
  end
}

