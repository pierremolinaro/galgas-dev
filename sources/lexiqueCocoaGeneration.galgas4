//--------------------------------------------------------------------------------------------------
//   L E X I C A L    E X P R E S S I O N    C O D E    G E N E R A T I O N (SWIFT)
//--------------------------------------------------------------------------------------------------

extension @lexicalExpressionAST {
  abstract func generateSwiftCocoaConditionCode (?let @lexiqueAnalysisContext _inLexiqueAnalysisContext) -> @string
}

//--------------------------------------------------------------------------------------------------

override func @lexicalOrExpressionAST.generateSwiftCocoaConditionCode
  (?let @lexiqueAnalysisContext inLexiqueAnalysisContext
  ) -> @string {
  result = self.mLeftOperand.generateSwiftCocoaConditionCode (inLexiqueAnalysisContext)
  result += " || "
  result += self.mRightOperand.generateSwiftCocoaConditionCode (inLexiqueAnalysisContext)
}

//--------------------------------------------------------------------------------------------------

override func @lexicalCharacterIntervalMatchAST.generateSwiftCocoaConditionCode
  (?let @lexiqueAnalysisContext _inLexiqueAnalysisContext
  ) -> @string {
  result = ""
  result = "self.testForInputFromChar ("
  result += self.mLowerBound.char.u32.string
  result += ", toChar:"
  result += self.mUpperBound.char.u32.string
  result += ")"
}

//--------------------------------------------------------------------------------------------------

override func @lexicalStringMatchAST.generateSwiftCocoaConditionCode
  (?let @lexiqueAnalysisContext _inLexiqueAnalysisContext
  ) -> @string {
  result = "self.testForInputString (" + self.mString.string.utf8Representation
  result += ", advance: true)"
}

//--------------------------------------------------------------------------------------------------

override func @lexicalStringNotMatchAST.generateSwiftCocoaConditionCode
  (?let @lexiqueAnalysisContext _inLexiqueAnalysisContext
  ) -> @string {
  result = "self.notTestForInputString ("
  result += self.mString.string.utf8RepresentationEscapingQuestionMark
  result += ", error: &scanningOk)"
}

//--------------------------------------------------------------------------------------------------

override func @lexicalCharacterMatchAST.generateSwiftCocoaConditionCode
  (?let @lexiqueAnalysisContext _inLexiqueAnalysisContext
  ) -> @string {
  result = "self.testForInputChar ("
  result += self.mCharacter.char.u32.string
  result += ")"
}

//--------------------------------------------------------------------------------------------------

override func @lexicalCharacterSetMatchAST.generateSwiftCocoaConditionCode
            (?let @lexiqueAnalysisContext _inLexiqueAnalysisContext ) -> @string {
  result = "self.testForChar_" +  self.mCharacterSetName.string + " ()"
}

//--------------------------------------------------------------------------------------------------

extension @lexicalRoutineOrFunctionFormalInputArgumentAST {
  abstract func generateSwiftCocoaRoutineOrFunctionArgument () -> @string
}

//--------------------------------------------------------------------------------------------------

override func @lexicalAttributeInputArgumentAST.generateSwiftCocoaRoutineOrFunctionArgument
  () -> @string {
  result = "mLexicalAttribute_" + self.mAttributeName
}

//--------------------------------------------------------------------------------------------------

override func @lexicalCharacterInputArgumentAST.generateSwiftCocoaRoutineOrFunctionArgument
  () -> @string {
  result = self.mCharacter.char.u32.string
}

//--------------------------------------------------------------------------------------------------

override func @lexicalUnsignedInputArgumentAST.generateSwiftCocoaRoutineOrFunctionArgument () -> @string {
  result = self.mUnsigned.bigint.string
}

//--------------------------------------------------------------------------------------------------

override func @lexicalCurrentCharacterInputArgumentAST.generateSwiftCocoaRoutineOrFunctionArgument
  () -> @string {
  result = "self.previousChar"
}

//--------------------------------------------------------------------------------------------------

override func @lexicalFunctionInputArgumentAST.generateSwiftCocoaRoutineOrFunctionArgument
  () -> @string {
  result = "scanner_cocoa_function_" + self.mFunctionName + " ("
  for lexicalActualInputArgument in self.mFunctionActualArgumentList
  do result += lexicalActualInputArgument.generateSwiftCocoaRoutineOrFunctionArgument
  between result += ", "
  end
  result += ")"
}

//--------------------------------------------------------------------------------------------------

extension @lexicalSendDefaultActionAST {
  abstract func generateSwiftCocoaDefaultSendCode(?let @string inScannerClassName) -> @string
}

//--------------------------------------------------------------------------------------------------

override func @lexicalSendTerminalByDefaultAST.generateSwiftCocoaDefaultSendCode
  (?let @string inScannerClassName
  ) -> @string {
  result = "tokenCode = " + inScannerClassName + "_1_" + self.mDefaultSentTerminal.string.identifierRepresentation + " ;\n"
}

//--------------------------------------------------------------------------------------------------

override func @lexicalErrorByDefaultAST.generateSwiftCocoaDefaultSendCode
  (?let @string _inScannerClassName
  ) -> @string {
  result = "scanningOk = false\n"
}

//--------------------------------------------------------------------------------------------------

extension @lexicalInstructionAST {

  abstract func generateSwiftCocoaInstructionCode (?let @string inScannerClassName,
                                                   ?let @lexiqueAnalysisContext inLexiqueAnalysisContext) -> @string
}

//--------------------------------------------------------------------------------------------------
//        L E X I C A L    R U L E    C O D E    G E N E R A T I O N (SWIFT)
//--------------------------------------------------------------------------------------------------

extension @abstractLexicalRuleAST {
  abstract func generateSwiftCocoaCode (?let @string inScannerClassName,
                                        ?let @lexiqueAnalysisContext _inLexiqueAnalysisContext) -> @string
}

//--------------------------------------------------------------------------------------------------

override func @lexicalImplicitRuleAST.generateSwiftCocoaCode
  (?let @string inScannerClassName,
  ?let @lexiqueAnalysisContext inLexiqueAnalysisContext
  ) -> @string {
  inLexiqueAnalysisContext.mLexicalTokenListMap.searchKey (self.mListName, ?*, ?let tokenSortedList, ?*)
  result = ""
  for > token in tokenSortedList do
    result += "if scanningOk && self.testForInputString ("
    result += token.mName.utf8Representation
    result += ", advance: true) {\n"
    result += "  tokenCode = " + inScannerClassName + "_1_" + token.mTerminalName.identifierRepresentation + "\n"
    result += "}else "
  end
}

//--------------------------------------------------------------------------------------------------

override func @lexicalExplicitRuleAST.generateSwiftCocoaCode
  (?let @string inScannerClassName,
  ?let @lexiqueAnalysisContext inLexiqueAnalysisContext
  ) -> @string {
  result = "if scanningOk && ("
  result += self.mLexicalRuleExpression.generateSwiftCocoaConditionCode (inLexiqueAnalysisContext)
  result += ") {\n"
  !?result.incIndentation (2)
  for instruction in self.mInstructionList do
    result += instruction.generateSwiftCocoaInstructionCode (inScannerClassName, inLexiqueAnalysisContext)
  end
  !?result.decIndentation (2)
  result += "}else "
}

//--------------------------------------------------------------------------------------------------

