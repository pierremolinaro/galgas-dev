grammar projectComponentGrammar "LL1" {
  syntax projectComponentSyntax

  <project_component_start_symbol> (!@project outProject)

}

//--------------------------------------------------------------------------------------------------

syntax projectComponentSyntax : projectComponentScanner {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <project_component_start_symbol> (!@project outProject) {
    var targets = @projectTargets ()
    var macAppBundleBaseName = "".nowhere
    var macAppBundleBaseNameDefined = false
    var libpmCustomPath = "".nowhere
    var libpmCustomPathDefined = false
    var macAppCodeSign = "".nowhere
    var macAppCodeSignDefined = false
    var majorVersion = 0
    var minorVersion = 0
    var revision = 0
    var versionDefined = false
    var productName = "".nowhere
    var productNameDefined = false
    var @styleMap lexicalStyleMap = @()
    repeat
//    while
//      $#quietOutputByDefault$
//      generateFeatureList ++= "quietOutputByDefault".here
    while
      $#lexical-style$
      $:$
      $identifier$ (?let @lstring styleName)
      $->$
      $"string"$ (?let @lstring styleComment)
      !?lexicalStyleMap.insert (styleName, styleComment, lexicalStyleMap.count + 1)
    while
      $#productName$
      $:$
      $"string"$ (?let @lstring featureValue)
      if productNameDefined then
        error featureValue : "duplicated attribute"
      end
      productName = featureValue
      productNameDefined = true    
    while
      $#version$
      $:$
      $literalInt$ (?let major)
      $.$
      $literalInt$ (?let minor)
      $.$
      $literalInt$ (?let rev)
      if versionDefined then
        error rev.location.union (major.location) : "duplicated attribute"
      end
      majorVersion = major.bigint.uint
      minorVersion = minor.bigint.uint
      revision = rev.bigint.uint
      versionDefined = true
    while
      $#macSwiftApp$
      if targets.contains (.macSwiftApp) then
        error .here : "duplicated attribute"
      end
      targets |= .macSwiftApp
    while
      $#makefile-macosx$
      if targets.contains (.makefileMacOS) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileMacOS
    while
      $#makefile-unix$
      if targets.contains (.makefileUnix) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileUnix
    while
      $#makefile-x86linux32-on-macosx$
      if targets.contains (.makefileX86Linux32OnMac) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileX86Linux32OnMac
    while
      $#makefile-x86linux64-on-macosx$
      if targets.contains (.makefileX86Linux64OnMac) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileX86Linux64OnMac
    while
      $#makefile-arm64-linux-on-macosx$
      if targets.contains (.makefileARM64LinuxOnMac) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileARM64LinuxOnMac
    while
      $#makefile-win32-on-macosx$
      if targets.contains (.makefileWin32OnMac) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileWin32OnMac
    while
      $#codeblocks-windows$
      if targets.contains (.codeblocksWindows) then
        error .here : "duplicated attribute"
      end
      targets |= .codeblocksWindows
    while
      $#codeblocks-linux32$
      if targets.contains (.codeblocksLinux32) then
        error .here : "duplicated attribute"
      end
      targets |= .codeblocksLinux32
    while
      $#codeblocks-linux64$
      if targets.contains (.codeblocksLinux64) then
        error .here : "duplicated attribute"
      end
      targets |= .codeblocksLinux64
    while
      $#macAppBundleBaseName$
      $:$
      $"string"$ (?let @lstring featureValue)
      if macAppBundleBaseNameDefined then
        error featureValue : "duplicated attribute"
      end
      macAppBundleBaseName = featureValue
      macAppBundleBaseNameDefined = true    
    while
      $#libpmCustomPath$
      $:$
      $"string"$ (?let @lstring featureValue)
      if libpmCustomPathDefined then
        error featureValue : "duplicated attribute"
      end
      libpmCustomPath = featureValue
      libpmCustomPathDefined = true    
    while
      $#macCodeSign$
      $:$
      $"string"$ (?let @lstring featureValue)
      if macAppCodeSignDefined then
        error featureValue : "duplicated attribute"
      end
      macAppCodeSign = featureValue
      macAppCodeSignDefined = true    
    end
    outProject = @(
      !productName: productName,
      !majorVersion: majorVersion,
      !minorVersion: minorVersion,
      !revision: revision,
      !targets: targets,
      !libpmCustomPath: libpmCustomPath,
      !macAppBundleBaseName: macAppBundleBaseName,
      !macAppCodeSign: macAppCodeSign,
      !lexicalStyleMap: lexicalStyleMap
    )
    if not versionDefined then
      error .here : "#version should be defined" spoil outProject
    end
    if not productNameDefined then
      error .here : "#productName should be defined" spoil outProject
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
