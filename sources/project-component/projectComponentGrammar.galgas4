grammar projectComponentGrammar "LL1" {
  syntax projectComponentSyntax

  <project_component_start_symbol> (!@projectSettings outProject)

}

//--------------------------------------------------------------------------------------------------

syntax projectComponentSyntax : projectComponentScanner {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <project_component_start_symbol> (!@projectSettings outProject) {
    var targets = @projectTargets ()
    var macAppBundleBaseName = "".nowhere
    var macAppBundleBaseNameDefined = false
    var libpmCustomPath = "".nowhere
    var libpmCustomPathDefined = false
    var macAppCodeSign = "".nowhere
    var macAppCodeSignDefined = false
    var majorVersion = 0
    var minorVersion = 0
    var revision = 0
    var versionDefined = false
    var productName = "".nowhere
    var productNameDefined = false
    var @lexicalStyleMap lexicalStyleMap = @()
    var [@projectBuildOption] boolBuildOptionArray = @()
    var [@projectBuildOption] stringBuildOptionArray = @()
    var [@projectBuildOption] u32BuildOptionArray = @()
  //--- Predefined options
    boolBuildOptionArray ++= @("display_version".here, @lchar ('\0', .here), "version".here, "Display version".here)
  //---
    boolBuildOptionArray ++= @("display_help".here, @lchar ('\0', .here), "help".here, "Display help".here)
  //---
    stringBuildOptionArray ++= @(
      "emit_issue_json_file".here,
      @lchar ('\0', .here),
      "emit-issue-json-file".here,
      "Emit a JSON file that contains all compilation issues".here
    )
  //---
    boolBuildOptionArray ++= @(
      "outputConcreteSyntaxTree".here,
       @lchar ('\0', .here),
      "output-concrete-syntax-tree".here,
      "Generate the concrete syntax tree, in .dot format (suitable for Graphviz)".here
    )
  //---
    boolBuildOptionArray ++= @(
      "log_file_read".here,
       @lchar ('\0', .here),
      "log-file-read".here,
      "Log every file read".here
    )
  //---
    boolBuildOptionArray ++= @(
      "do_not_generate_any_file".here,
       @lchar ('\0', .here),
      "no-file-generation".here,
      "Do not generate any file".here
    )
  //---
    boolBuildOptionArray ++= @(
      "treat_warnings_as_error".here,
       @lchar ('\0', .here),
      "Werror".here,
      "Treat warnings as errors".here
    )
  //---
    boolBuildOptionArray ++= @(
      "no_color".here,
       @lchar ('\0', .here),
      "no-color".here,
      "Do not issue colored messages (Unix Only)".here
    )
  //---
//    if @application.runningOnWindows then
//      boolBuildOptionArray ++= @(
//        "no_dialog".here,
//         @lchar ('\0', .here),
//        "no-dialog".here,
//        "Do Not Display any dialog when no input file (Windows only)".here
//      )
//    end
  //---
    u32BuildOptionArray ++= @(
      "max_errors".here,
       @lchar ('\0', .here),
      "max-errors".here,
      "Stop after the given number of errors has been reached".here
    )
  //---
    u32BuildOptionArray ++= @(
      "max_warnings".here,
       @lchar ('\0', .here),
      "max-warnings".here,
      "Stop after the given number of warnings has been reached".here
    )
  //---
    stringBuildOptionArray ++= @(
      "outputKeywordList".here,
       @lchar ('\0', .here),
      "output-keyword-list-file".here,
      "Output a Latex file containing keyword list".here
    )
  //---
    stringBuildOptionArray ++= @(
      "mode".here,
       @lchar ('\0', .here),
      "mode".here,
      "'lexical-only', 'syntax-only' or 'latex'".here
    )
  //---
    var @stringset optionInvocationStringSet = @()
    var @stringset optionInvocationCharSet = @()
    var @stringset optionIdentifierSet = @()
    for boolOption in boolBuildOptionArray do
      optionIdentifierSet ++= boolOption.mIdentifier
      optionInvocationStringSet ++= boolOption.mInvocationString
    end
    for u32Option in stringBuildOptionArray do
      optionIdentifierSet ++= u32Option.mIdentifier
      optionInvocationStringSet ++= u32Option.mInvocationString
    end
    for stringOption in stringBuildOptionArray do
      optionIdentifierSet ++= stringOption.mIdentifier
      optionInvocationStringSet ++= stringOption.mInvocationString
    end
  //---
    repeat
//    while
//      $#quietOutputByDefault$
//      generateFeatureList ++= "quietOutputByDefault".here
    while
      $#u32-build-option$
      $identifier$ (?let @lstring optionIdentifier)
      if optionIdentifierSet.contains (optionIdentifier.string) then
        error optionIdentifier : "duplicated option identifier"
      end 
      optionIdentifierSet ++= optionIdentifier.string
      $:$
      let @lchar invocationChar
      select
        $'char'$ (?invocationChar)
      or
        invocationChar = @lchar ('\0', .here)
      end
      let @lstring invocationString
      select
        $"string"$ (?invocationString)
      or
        invocationString = "".here
      end
      $->$
      $"string"$ (?let @lstring explanationString)
      u32BuildOptionArray ++= @(optionIdentifier, invocationChar, invocationString, explanationString)
      if invocationString.string != "" then
        if optionInvocationStringSet.contains (invocationString.string) then
          error invocationString : "Duplicated invocation string"
        end
      end
      optionInvocationStringSet ++= invocationString.string
      if invocationChar.char != '\0' then
        if optionInvocationCharSet.contains (invocationChar.char.string) then
          error invocationChar : "Duplicated invocation character"
        end
        optionInvocationCharSet ++= invocationChar.char.string
      end
      if invocationString.string == "", invocationChar.char == '\0' then
        error optionIdentifier : "both the invocation character and the invocation string must not be empty"
      end
    while
      $#string-build-option$
      $identifier$ (?let @lstring optionIdentifier)
      if optionIdentifierSet.contains (optionIdentifier.string) then
        error optionIdentifier : "duplicated option identifier"
      end 
      optionIdentifierSet ++= optionIdentifier.string
      $:$
      let @lchar invocationChar
      select
        $'char'$ (?invocationChar)
      or
        invocationChar = @lchar ('\0', .here)
      end
      let @lstring invocationString
      select
        $"string"$ (?invocationString)
      or
        invocationString = "".here
      end
      $->$
      $"string"$ (?let @lstring explanationString)
      stringBuildOptionArray ++= @(optionIdentifier, invocationChar, invocationString, explanationString)
      if invocationString.string != "" then
        if optionInvocationStringSet.contains (invocationString.string) then
          error invocationString : "Duplicated invocation string"
        end
      end
      optionInvocationStringSet ++= invocationString.string
      if invocationChar.char != '\0' then
        if optionInvocationCharSet.contains (invocationChar.char.string) then
          error invocationChar : "Duplicated invocation character"
        end
        optionInvocationCharSet ++= invocationChar.char.string
      end
      if invocationString.string == "", invocationChar.char == '\0' then
        error optionIdentifier : "both the invocation character and the invocation string must not be empty"
      end
    while
      $#bool-build-option$
      $identifier$ (?let @lstring optionIdentifier)
      if optionIdentifierSet.contains (optionIdentifier.string) then
        error optionIdentifier : "duplicated option identifier"
      end 
      optionIdentifierSet ++= optionIdentifier.string
      $:$
      let @lchar invocationChar
      select
        $'char'$ (?invocationChar)
      or
        invocationChar = @lchar ('\0', .here)
      end
      let @lstring invocationString
      select
        $"string"$ (?invocationString)
      or
        invocationString = "".here
      end
      $->$
      $"string"$ (?let @lstring explanationString)
      boolBuildOptionArray ++= @(optionIdentifier, invocationChar, invocationString, explanationString)
      if invocationString.string != "" then
        if optionInvocationStringSet.contains (invocationString.string) then
          error invocationString : "Duplicated invocation string"
        end
      end
      optionInvocationStringSet ++= invocationString.string
      if invocationChar.char != '\0' then
        if optionInvocationCharSet.contains (invocationChar.char.string) then
          error invocationChar : "Duplicated invocation character"
        end
        optionInvocationCharSet ++= invocationChar.char.string
      end
      if invocationString.string == "", invocationChar.char == '\0' then
        error optionIdentifier : "both the invocation character and the invocation string must not be empty"
      end
    while
      $#lexical-style$
      $identifier$ (?let @lstring styleName)
      $:$
      $"string"$ (?let @lstring styleComment)
      !?lexicalStyleMap.insert (styleName, styleComment, lexicalStyleMap.count + 1)
    while
      $#productName$
      $:$
      $"string"$ (?let @lstring featureValue)
      if productNameDefined then
        error featureValue : "duplicated attribute"
      end
      productName = featureValue
      productNameDefined = true    
    while
      $#version$
      $:$
      $literalInt$ (?let major)
      $.$
      $literalInt$ (?let minor)
      $.$
      $literalInt$ (?let rev)
      if versionDefined then
        error rev.location.union (major.location) : "duplicated attribute"
      end
      majorVersion = major.bigint.uint
      minorVersion = minor.bigint.uint
      revision = rev.bigint.uint
      versionDefined = true
    while
      $#macSwiftApp$
      if targets.contains (.macSwiftApp) then
        error .here : "duplicated attribute"
      end
      targets |= .macSwiftApp
    while
      $#makefile-macosx$
      if targets.contains (.makefileMacOS) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileMacOS
    while
      $#makefile-unix$
      if targets.contains (.makefileUnix) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileUnix
    while
      $#makefile-x86linux32-on-macosx$
      if targets.contains (.makefileX86Linux32OnMac) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileX86Linux32OnMac
    while
      $#makefile-x86linux64-on-macosx$
      if targets.contains (.makefileX86Linux64OnMac) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileX86Linux64OnMac
    while
      $#makefile-arm64-linux-on-macosx$
      if targets.contains (.makefileARM64LinuxOnMac) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileARM64LinuxOnMac
    while
      $#makefile-win32-on-macosx$
      if targets.contains (.makefileWin32OnMac) then
        error .here : "duplicated attribute"
      end
      targets |= .makefileWin32OnMac
    while
      $#codeblocks-windows$
      if targets.contains (.codeblocksWindows) then
        error .here : "duplicated attribute"
      end
      targets |= .codeblocksWindows
    while
      $#codeblocks-linux32$
      if targets.contains (.codeblocksLinux32) then
        error .here : "duplicated attribute"
      end
      targets |= .codeblocksLinux32
    while
      $#codeblocks-linux64$
      if targets.contains (.codeblocksLinux64) then
        error .here : "duplicated attribute"
      end
      targets |= .codeblocksLinux64
    while
      $#macAppBundleBaseName$
      $:$
      $"string"$ (?let @lstring featureValue)
      if macAppBundleBaseNameDefined then
        error featureValue : "duplicated attribute"
      end
      macAppBundleBaseName = featureValue
      macAppBundleBaseNameDefined = true    
    while
      $#libpmCustomPath$
      $:$
      $"string"$ (?let @lstring featureValue)
      if libpmCustomPathDefined then
        error featureValue : "duplicated attribute"
      end
      libpmCustomPath = featureValue
      libpmCustomPathDefined = true    
    while
      $#macCodeSign$
      $:$
      $"string"$ (?let @lstring featureValue)
      if macAppCodeSignDefined then
        error featureValue : "duplicated attribute"
      end
      macAppCodeSign = featureValue
      macAppCodeSignDefined = true    
    end
    outProject = @(
      !productName: productName,
      !majorVersion: majorVersion,
      !minorVersion: minorVersion,
      !revision: revision,
      !targets: targets,
      !libpmCustomPath: libpmCustomPath,
      !macAppBundleBaseName: macAppBundleBaseName,
      !macAppCodeSign: macAppCodeSign,
      !lexicalStyleMap: lexicalStyleMap,
      !boolBuildOptionArray: boolBuildOptionArray,
      !stringBuildOptionArray: stringBuildOptionArray,
      !u32BuildOptionArray: u32BuildOptionArray
    )
    if not versionDefined then
      error .here : "#version should be defined" spoil outProject
    end
    if not productNameDefined then
      error .here : "#productName should be defined" spoil outProject
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
