//--------------------------------------------------------------------------------------------------
//! CODE GENERATION
//--------------------------------------------------------------------------------------------------

final class @buildOptionForGeneration : @semanticDeclarationWithHeaderForGeneration {
  public let [@projectBuildOption] boolBuildOptionArray #initArgLabel
  public let [@projectBuildOption] u32BuildOptionArray #initArgLabel
  public let [@projectBuildOption] stringBuildOptionArray #initArgLabel

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func isPredefined () -> @bool {
    result = true
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func headerKind () -> @headerKind {
    result = .oneHeader
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc appendDeclaration1 (?!@stringset _ioInclusionSet,
                                    !@string outHeader) {
    outHeader = filewrapper [buildOptionGenerationTemplates.optionHeaderZone3 :
      self.boolBuildOptionArray,
      self.u32BuildOptionArray,
      self.stringBuildOptionArray
    ]
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc appendSpecificImplementation (let @unifiedTypeMap _inTypeMap,
                                              ?!@stringset ioInclusionSet,
                                              !@string outImplementation) {
    ioInclusionSet ++= "build-options"
    outImplementation = filewrapper [buildOptionGenerationTemplates.optionImplementationGalgas3 :
      self.boolBuildOptionArray,
      self.u32BuildOptionArray,
      self.stringBuildOptionArray
    ]
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc appendSpecificFiles (let @string inProductDirectory,
                                     ?!@stringset ioAllProductFileSet,
                                     ?!swift: [@string] ioSwiftAppProductFileList) {
  //--- Generate Cocoa header
    if @application.errorCount == 0 then // , not self.mIsPredefined then
    //--- Generate Swift Cocoa Implementation
      ioAllProductFileSet ++= "build-options-swiftui.swift"
      ioSwiftAppProductFileList ++= "build-options-swiftui.swift"
      @string.generateFileWithPattern (
        !startPath: inProductDirectory,
        !fileName: "build-options-swiftui.swift",
        !lineComment: "//",
        !header: "",
        !defaultUserZone1: "\n\n",
        !generatedZone2: filewrapper [buildOptionGenerationTemplates.optionImplementationSwiftUI :
          self.boolBuildOptionArray,
          self.u32BuildOptionArray,
          self.stringBuildOptionArray
        ],
        !defaultUserZone2: "\n\n",
        !generatedZone3: "\n\n",
        !makeExecutable: false
      )
   end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//         G E N E R A T I O N    T E M P L A T E S
//--------------------------------------------------------------------------------------------------

filewrapper buildOptionGenerationTemplates in "../+generation-templates/option_generation" {
}{
}{
  template optionHeaderZone3 : "build-options-header-zone3.galgasTemplate" (
    ?[@projectBuildOption] BOOL_OPTION_ARRAY,
    ?[@projectBuildOption] UINT_OPTION_ARRAY,
    ?[@projectBuildOption] STRING_OPTION_ARRAY
  )

  template optionImplementationGalgas3 : "build-options-implementation-cpp.galgasTemplate" (
    ?[@projectBuildOption] BOOL_OPTION_ARRAY,
    ?[@projectBuildOption] UINT_OPTION_ARRAY,
    ?[@projectBuildOption] STRING_OPTION_ARRAY
  )

  template optionImplementationSwiftUI : "build-options-implementation-swiftui.galgasTemplate" (
    ?[@projectBuildOption] BOOL_OPTION_ARRAY,
    ?[@projectBuildOption] UINT_OPTION_ARRAY,
    ?[@projectBuildOption] STRING_OPTION_ARRAY
  )
}

//--------------------------------------------------------------------------------------------------
