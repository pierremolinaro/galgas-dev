optionset @projectTargets {
  case makefileUnix
  case makefileMacOS
  case makefileX86Linux32OnMac
  case makefileX86Linux64OnMac
  case makefileARM64LinuxOnMac
  case makefileWin32OnMac
  case macSwiftApp
  case codeblocksWindows
  case codeblocksLinux32
  case codeblocksLinux64
}

//-----------------------------------------------------------------*

map @lexicalStyleMap {
  public let @lstring mComment
  public let @uint mStyleIndex // Always > 0
  #insertSetter insert #errorMessage "the '%K' style is already declared in %L"
  #searchMethod search #errorMessage "the '%K' style is not declared"
}

//--------------------------------------------------------------------------------------------------

struct @projectBuildOption {
  let @lstring mIdentifier
  let @lchar mInvocationChar
  let @lstring mInvocationString
  let @lstring mExplanationString
}

//--------------------------------------------------------------------------------------------------

struct @projectSettings {
  let @string productName #initArgLabel
  let @uint majorVersion #initArgLabel
  let @uint minorVersion #initArgLabel
  let @uint revision #initArgLabel
  let @projectTargets targets #initArgLabel
  let @lstring libpmCustomPath #initArgLabel
  let @lstring macAppBundleBaseName #initArgLabel
  let @lstring macAppCodeSign #initArgLabel
  let @lexicalStyleMap lexicalStyleMap #initArgLabel
  let [@projectBuildOption] boolBuildOptionArray #initArgLabel
  let [@projectBuildOption] stringBuildOptionArray #initArgLabel
  let [@projectBuildOption] u32BuildOptionArray #initArgLabel
}

//--------------------------------------------------------------------------------------------------
