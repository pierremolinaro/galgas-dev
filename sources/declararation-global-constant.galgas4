syntax extension galgas4InstructionsSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  //    GLOBAL CONSTANT DECLARATION
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <declaration> (?!@galgasDeclarationAST ioDeclarations) {
    $let$
    <type_definition> (!?ioDeclarations, ?let resultTypeName)
    $identifier$ (?let functionName) indexing (functionDefinition)
    $=$
    let [@semanticInstructionAST] functionInstructionList
    select
      <expression> (!?ioDeclarations, ?let @semanticExpressionAST expression)
      let assignment = @assignmentInstructionAST (
        .here,
        "result".here,
        .none,
        expression
      )
      functionInstructionList = [assignment]
    or
      ${$
      <semantic_instruction_list> (!?ioDeclarations, ?functionInstructionList)
      $}$
    end
    let endOfFunctionInstructionList = @location.here
    ioDeclarations.mDeclarationList ++= @onceFunctionDeclarationAST (
      !isPredefined: false,
      functionName,
      resultTypeName,
      functionInstructionList,
      endOfFunctionInstructionList,
      false, // Private
      false
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <declaration> (?!@galgasDeclarationAST ioDeclarations) {
    $private$
    $let$
    <type_definition> (!?ioDeclarations, ?let resultTypeName)
    $identifier$ (?let functionName) indexing (functionDefinition)
    $=$
    let [@semanticInstructionAST] functionInstructionList
    select
      <expression> (!?ioDeclarations, ?let @semanticExpressionAST expression)
      let assignment = @assignmentInstructionAST (
        .here,
        "result".here,
        .none,
        expression
      )
      functionInstructionList = [assignment]
    or
      ${$
      <semantic_instruction_list> (!?ioDeclarations, ?functionInstructionList)
      $}$
    end
    let endOfFunctionInstructionList = @location.here
    ioDeclarations.mDeclarationList ++= @onceFunctionDeclarationAST (
      !isPredefined: false,
      functionName,
      resultTypeName,
      functionInstructionList,
      endOfFunctionInstructionList,
      true, // Private
      false
    )
  }

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
// AST
//--------------------------------------------------------------------------------------------------

final class @onceFunctionDeclarationAST : @semanticDeclarationAST {
  private let @lstring mGlobalConstanteName
  private let @lstring mResultTypeName
  private let [@semanticInstructionAST] mFunctionInstructionList
  private let @location mEndOfFunctionInstructionList
  private let @bool mIsPrivate
  private let @bool mIsUsefull

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func keyRepresentation () -> @string {
    result = "once function " + self.mGlobalConstanteName
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  override proc enterDeclarationInSemanticContext (?!@equatableExtensionMap _ioEquatableExtensionMap,
    let @extensionInitializerForBuildingContext _inExtensionInitializerMapForBuildingContext,
    let @extensionMethodMapForBuildingContext _inExtensionMethodMapForBuildingContext,
    let @extensionGetterMapForBuildingContext _inExtensionGetterMapForBuildingContext,
    let @extensionSetterMapForBuildingContext _inExtensionSetterMapForBuildingContext,
                                  ?!@unifiedTypeMap ioTypeMap,
    ?!@semanticContext ioSemanticContext) {
  //--- Result type
    !?ioTypeMap.makeEntry (self.mResultTypeName, ?let @unifiedTypeMapEntry resultType)
  //--- Enter constant in global constant map
//    !?ioSemanticContext.mFunctionMap.insertKey (self.mGlobalConstanteName, @(), resultType, self.mIsPrivate)
    !?ioSemanticContext.mGlobalConstantMap.insert (self.mGlobalConstanteName, resultType, self.mIsPrivate)
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  override proc enterDeclarationInGraph
    (?!@semanticTypePrecedenceGraph _ioSemanticTypePrecedenceGraph,
    ?!@equatableExtensionMap _ioEquatableExtensionMap,
    ?!@extensionInitializerForBuildingContext _ioExtensionInitializerForBuildingContext,
    ?!@extensionMethodMapForBuildingContext _ioExtensionMethodMapForBuildingContext,
    ?!@extensionGetterMapForBuildingContext _ioExtensionGetterMapForBuildingContext,
    ?!@extensionSetterMapForBuildingContext _ioExtensionSetterMapForBuildingContext,
    ?![@semanticDeclarationAST] ioExtensionOverrideDefinitionList) {
    ioExtensionOverrideDefinitionList ++= self
  }
  
  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  
  override proc semanticAnalysis (?![@lstring] ioUsefulnessRootEntities,
                                  ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
    let @string _inProductDirectory,
    let @semanticContext inSemanticContext,
                                  ?!@unifiedTypeMap ioTypeMap,
    let @predefinedTypes inPredefinedTypes,
    ?![@semanticDeclarationForGeneration] ioSemanticDeclarationListForGeneration
) {
  //--- Useful entities graph
    let nameForUsefulness = functionNameForUsefulEntitiesGraph (self.mGlobalConstanteName)
    !?ioUsefulEntitiesGraph.addNode (nameForUsefulness, nameForUsefulness)
    if self.mIsUsefull then
      ioUsefulnessRootEntities ++= nameForUsefulness
    end
  //--- Analyse function body
    let analysisContext = @analysisContext (
      inSemanticContext,
      inPredefinedTypes,
      !selfObjectCppName: "",
      !selfAvailability: .none,
      !selfObjectCppPrefixForAccessingProperty: ""
    )
    analyzeFunctionBody (
      nameForUsefulness,
      !?ioUsefulEntitiesGraph,
      analysisContext,
      !?ioTypeMap,
      [@formalInputParameterAST] (),
      self.mFunctionInstructionList,
      self.mResultTypeName,
      self.mEndOfFunctionInstructionList,
      ?signatureIR: *,
      ?let returnType,
      ?let resultVariableCppName,
      ?let semanticInstructionListForGeneration
    )
  //---
    ioSemanticDeclarationListForGeneration ++= @onceFunctionDeclarationForGeneration (
      !infoMessage: "global constant " + self.mGlobalConstanteName,
      !generateHeader: true,
      !implementationCppFileName: "func-" + self.mGlobalConstanteName.string.fileNameRepresentation,
      self.mGlobalConstanteName.string,
      returnType,
      resultVariableCppName,
      semanticInstructionListForGeneration
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

