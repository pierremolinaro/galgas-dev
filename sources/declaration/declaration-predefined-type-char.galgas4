final class @charPredefinedTypeAST : @predefinedTypeAST {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func getSupportedOperatorFlags () -> @typeFeatures {
    result = .generateDescriptionGetterUtilityMethod | .comparable | .equatable
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getGetterMap (?!@unifiedTypeMap ioUnifiedTypeMap,
                                !@getterMap outMap) {
    commonGetterMapForAllTypes (!?ioUnifiedTypeMap, ?outMap)
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"string",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"utf8Length",
      !returnedTypeName:"uint",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"utf32CharConstantRepresentation",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"uint",
      !returnedTypeName:"uint",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isalnum",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isalpha",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"iscntrl",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isdigit",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"islower",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isupper",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isxdigit",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isUnicodeLetter",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isUnicodeMark",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isUnicodeNumber",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isUnicodeSeparator",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isUnicodeCommand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isUnicodePunctuation",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"isUnicodeSymbol",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"unicodeName",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"unicodeToLower",
      !returnedTypeName:"char",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"unicodeToUpper",
      !returnedTypeName:"char",
      !hasCompilerArgument:false
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getClassFunctionMap (?!@unifiedTypeMap ioUnifiedTypeMap,
                                       !@classFunctionMap outMap) {
    outMap = @()
    enterClassFunctionWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !name:"replacementCharacter",
      !resultTypeName:"char",
      !hasLexiqueArg:false
    )
    enterClassFunctionWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !name:"unicodeCharacterWithUnsigned",
      !argTypeName:"uint",
      !argName:"inValue",
      !resultTypeName:"char",
      !hasLexiqueArg:false
    )
    enterClassFunctionWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !name:"unicodeCharacterFromRawKeyboard",
      !resultTypeName:"char",
      !hasLexiqueArg:true
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func cppDeclarationString () -> @string {
    result = filewrapper [predefinedTypeGenerationTemplate.char_type : ]
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

