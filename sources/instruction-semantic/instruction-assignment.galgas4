//! SYNTAX
//--------------------------------------------------------------------------------------------------

syntax extension galgas4InstructionsSyntax {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <semantic_instruction> (?!@galgasDeclarationAST ioDeclarations,
                               !@semanticInstructionAST outInstruction) {
    $identifier$ (?let mTargetVariableName)
    let @assignmentSupplementAST supplement
    select
      supplement = .none
    or
      $[$
      <non_empty_output_expression_list> (
        !?ioDeclarations,
        ?let [@actualOutputArgumentAST] subcriptsArguments
      )
      supplement = .subcript (!subscriptArgs: subcriptsArguments, !errorLocation: .here)
      $]$
    or
      $.$
      $identifier$ (?let propertyName)
      supplement = .property (!name: propertyName)
    end
    $=$
    <expression> (!?ioDeclarations, ?let @semanticExpressionAST mSourceExpression)
    outInstruction = @assignmentInstructionAST (
      mTargetVariableName.location,
      mTargetVariableName,
      supplement,
      mSourceExpression
     )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  rule <semantic_instruction> (?!@galgasDeclarationAST ioDeclarations,
                               !@semanticInstructionAST outInstruction) {
    $self$
    $.$
    $identifier$ (?let mTargetVariableName)
    let @assignmentSupplementAST supplement
    select
      supplement = .none
    or
      $[$
      <non_empty_output_expression_list> (
        !?ioDeclarations,
        ?let [@actualOutputArgumentAST] subcriptsArguments
      )
      supplement = .subcript (!subscriptArgs: subcriptsArguments, !errorLocation: .here)
      $]$
    or
      $.$
      $identifier$ (?let propertyName)
      supplement = .property (!name: propertyName)
    end
    $=$
    <expression> (!?ioDeclarations, ?let @semanticExpressionAST mSourceExpression)
    outInstruction = @selfPropertyAssignmentInstructionAST (
      mTargetVariableName.location,
      mTargetVariableName,
      supplement,
      mSourceExpression
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! @assignmentInstructionAST
//--------------------------------------------------------------------------------------------------

enum @assignmentSupplementAST {
  case none
  case property (@lstring name)
  case subcript ([@actualOutputArgumentAST] subscriptArgs, @location errorLocation)
}

//--------------------------------------------------------------------------------------------------

final class @assignmentInstructionAST : @semanticInstructionAST {
  private let @lstring mTargetVariableName
  private let @assignmentSupplementAST mSupplement
  private let @semanticExpressionAST mSourceExpression

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterInstructionInSemanticContext (?!@unifiedTypeMap ioTypeMap) {
    self.mSourceExpression.enterExpressionInSemanticContext (!?ioTypeMap)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc analyzeSemanticInstruction (
                        let @lstring inUsefulnessCallerEntityName,
                        ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
                        let @analysisContext inAnalysisContext,
                        ?!@unifiedTypeMap ioTypeMap,
                        ?![@semanticInstructionForGeneration] ioInstructionListForGeneration,
                        ?!@localVarManager ioVariableMap) {
  //--- Get target variable type
    !?ioVariableMap.neutralAccess (self.mTargetVariableName, ?let receiverType, ?*, ?*)
    var targetType = receiverType
    let @assignmentSupplementIR supplementIR
    switch self.mSupplement
    case none :
      supplementIR = .none
    case property (propertyName) :
      supplementIR = .property (!name: propertyName.string)
      let propertyMap = targetType.definition.propertyMap
      propertyMap.searchKey (propertyName, ?let accessControl, ?let isConstant, ?targetType)
      accessControl.checkSetAccess (inAnalysisContext.selfAvailability, propertyName)
      if isConstant then
        error propertyName : "a constant property cannot be modified"
      end
    case subcript (subcriptArgs, errorLocation) :
      let writeSubcriptMap = targetType.definition.writeSubscriptMap
      let lkey = @lstring (subcriptArgs.subcriptSignature, errorLocation)
      writeSubcriptMap.searchKey (lkey, ?let formalArgs, ?targetType)
      var [@collectionValueElementForGeneration] expressionListForGeneration
      if subcriptArgs.count != formalArgs.count then
        error errorLocation : formalArgs.count.string + "arguments are required" spoil expressionListForGeneration
      else
        expressionListForGeneration = []
        for expression in subcriptArgs, formal in formalArgs do
          expression.mExpression.analyzeSemanticExpression (
            !usefulnessCallerEntityName: inUsefulnessCallerEntityName,
            !?ioUsefulEntitiesGraph,
            !inferenceType: formal.mFormalArgumentType,
            inAnalysisContext,
            !?ioTypeMap,
            !?ioVariableMap,
            ?var expressionForGeneration
          )
        //--- Check assignment type compatibility
          checkAssignmentTypeWithImplicitGetterCall (
            formal.mFormalArgumentType,
            expressionForGeneration.mResultType,
            expression.mEndOfExpressionLocation,
            !?expressionForGeneration
          )
          expressionListForGeneration ++= @(expressionForGeneration, expression.mEndOfExpressionLocation)
        end
      end
      supplementIR = .subcript (!expressions: expressionListForGeneration, !subcriptSignature: subcriptArgs.subcriptSignature)
    end
  //--- Analyze source expression
    self.mSourceExpression.analyzeSemanticExpression (
      !usefulnessCallerEntityName: inUsefulnessCallerEntityName,
      !?ioUsefulEntitiesGraph,
      !inferenceType: targetType,
      inAnalysisContext,
      !?ioTypeMap,
      !?ioVariableMap,
      ?@semanticExpressionForGeneration expression
    )
  //--- Check assignment type compatibility
    checkAssignmentTypeWithImplicitGetterCall (
      targetType,
      expression.mResultType,
      self.mInstructionLocation,
      !?expression
    )
  //--- Get target variable
    let @string targetVariableCppName
    let @string nameForCheckingFormalParameterUsing
    switch self.mSupplement
    case none :
      !?ioVariableMap.searchForWriteAccess (
        self.mTargetVariableName,
        ?*,
        ?targetVariableCppName,
        ?nameForCheckingFormalParameterUsing
      )
    case property (*) :
      !?ioVariableMap.searchForReadWriteAccess (
        self.mTargetVariableName,
        ?*,
        ?targetVariableCppName,
        ?nameForCheckingFormalParameterUsing
      )
    case subcript (*, *) :
      !?ioVariableMap.searchForReadWriteAccess (
        self.mTargetVariableName,
        ?*,
        ?targetVariableCppName,
        ?nameForCheckingFormalParameterUsing
      )
    end
  //--- Generate instruction
    ioInstructionListForGeneration ++= @assignmentInstructionForGeneration (
      receiverType,
      targetType,
      targetVariableCppName,
      nameForCheckingFormalParameterUsing,
      supplementIR,
      expression,
      self.mTargetVariableName.location
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! @selfPropertyAssignmentInstructionAST
//--------------------------------------------------------------------------------------------------

final class @selfPropertyAssignmentInstructionAST : @semanticInstructionAST {
  private let @lstring mTargetSelfPropertyName
  private let @assignmentSupplementAST mSupplement
  private let @semanticExpressionAST mSourceExpression

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterInstructionInSemanticContext (?!@unifiedTypeMap ioTypeMap) {
    self.mSourceExpression.enterExpressionInSemanticContext (!?ioTypeMap)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc analyzeSemanticInstruction (
                        let @lstring inUsefulnessCallerEntityName,
                        ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
                        let @analysisContext inAnalysisContext,
                        ?!@unifiedTypeMap ioTypeMap,
                        ?![@semanticInstructionForGeneration] ioInstructionListForGeneration,
                        ?!@localVarManager ioVariableMap) {
    if let selfAvailable = inAnalysisContext.selfAvailability.getAvailable then
      if not selfAvailable.selfMutability.propertiesAreMutable then
        error self.mInstructionLocation : "'self' property not mutable in this context"
      end
      let propertyMap = selfAvailable.type.definition.propertyMap
      propertyMap.searchKey (self.mTargetSelfPropertyName, ?*, ?let isConstant, ?var targetType)
      if isConstant & not selfAvailable.selfMutability.isInitializer then
        error self.mTargetSelfPropertyName : "a constant property cannot be modified"
      end
      let targetVariableCppName = inAnalysisContext.selfObjectCppPrefixForAccessingProperty
         + "mProperty_"+ self.mTargetSelfPropertyName.string.identifierRepresentation
    //--- Get target variable type
      let @assignmentSupplementIR supplementIR
      switch self.mSupplement
      case none :
        supplementIR = .none
      case property (propertyName) :
        supplementIR = .property (!name: propertyName.string)
        let propertyMap = targetType.definition.propertyMap
        propertyMap.searchKey (propertyName, ?let accessControl, ?let isConstant, ?targetType)
        accessControl.checkSetAccess (inAnalysisContext.selfAvailability, propertyName.location)
        if isConstant then
          error propertyName : "a constant property cannot be modified"
        end
      case subcript (subcriptArgs, errorLocation) :
        let writeSubcriptMap = targetType.definition.writeSubscriptMap
        let lkey = @lstring (subcriptArgs.subcriptSignature, errorLocation)
        writeSubcriptMap.searchKey (lkey, ?let formalArgs, ?targetType)
        var [@collectionValueElementForGeneration] expressionListForGeneration
        if subcriptArgs.count != formalArgs.count then
          error errorLocation : formalArgs.count.string + "arguments are required" spoil expressionListForGeneration
        else
          expressionListForGeneration = []
          for expression in subcriptArgs, formal in formalArgs do
            expression.mExpression.analyzeSemanticExpression (
              !usefulnessCallerEntityName: inUsefulnessCallerEntityName,
              !?ioUsefulEntitiesGraph,
              !inferenceType: formal.mFormalArgumentType,
              inAnalysisContext,
              !?ioTypeMap,
              !?ioVariableMap,
              ?var expressionForGeneration
            )
          //--- Check assignment type compatibility
            checkAssignmentTypeWithImplicitGetterCall (
              formal.mFormalArgumentType,
              expressionForGeneration.mResultType,
              expression.mEndOfExpressionLocation,
              !?expressionForGeneration
            )
            expressionListForGeneration ++= @(expressionForGeneration, expression.mEndOfExpressionLocation)
          end
        end
        supplementIR = .subcript (!expressions: expressionListForGeneration, !subcriptSignature: subcriptArgs.subcriptSignature)
      end
    //--- Analyze source expression
      self.mSourceExpression.analyzeSemanticExpression
        (!usefulnessCallerEntityName: inUsefulnessCallerEntityName,
        !?ioUsefulEntitiesGraph,
        !inferenceType: targetType,
        inAnalysisContext,
        !?ioTypeMap,
        !?ioVariableMap,
        ?@semanticExpressionForGeneration expression
      )
    //---
      !?ioVariableMap.searchForWriteAccess
        (@("self." + self.mTargetSelfPropertyName, self.mTargetSelfPropertyName), ?3*
      )
    //--- Check assignment type compatibility
      checkAssignmentTypeWithImplicitGetterCall (targetType, expression.mResultType, self.mInstructionLocation, !?expression)
    //--- Generate instruction
      ioInstructionListForGeneration ++= @assignmentInstructionForGeneration (
        selfAvailable.type,
        targetType,
        targetVariableCppName,
        inAnalysisContext.selfObjectCppName,
        supplementIR,
        expression,
        self.mTargetSelfPropertyName.location
      )
    else
      error self.mInstructionLocation : "'self' not available in this context"
    end
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//! @assignmentInstructionForGeneration
//--------------------------------------------------------------------------------------------------

enum @assignmentSupplementIR {
  case none
  case property (@string name)
  case subcript ([@collectionValueElementForGeneration] expressions, @string subcriptSignature)
}

//--------------------------------------------------------------------------------------------------

class @assignmentInstructionForGeneration : @semanticInstructionForGeneration {
  private let @unifiedTypeMapEntry mReceiverType
  private let @unifiedTypeMapEntry mTargetType
  private let @string mTargetCppName
  private let @string mNameForCheckingFormalParameterUsing
  private let @assignmentSupplementIR mSupplement
  private let @semanticExpressionForGeneration mSourceExpression
  private let @location mSourceLocation

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc generateInstruction (?!@stringset ioInclusionSet,
                                     ?!@uint ioTemporaryVariableIndex,
                                     ?!@stringset ioUnusedVariableCppNameSet,
                                     let @bool _inGenerateSyntaxDirectedTranslationString,
                                     ?!@string ioGeneratedCode) {
    self.mSourceExpression.generateExpression (
      !?ioGeneratedCode,
      !?ioInclusionSet,
      !?ioTemporaryVariableIndex,
      !?ioUnusedVariableCppNameSet,
      ?let sourceVar
    )
    !?ioUnusedVariableCppNameSet.removeKey (self.mNameForCheckingFormalParameterUsing)
  //---
    self.mTargetType.addHeaderFileName (!?ioInclusionSet)
    switch self.mSupplement
    case none :
      ioGeneratedCode += self.mTargetCppName + " = " + sourceVar + " ;\n"
    case property (propertyName) :
      if self.mReceiverType.definition.typeKind.isClassType then
        ioGeneratedCode += self.mTargetCppName + ".setProperty_"
        ioGeneratedCode += propertyName.identifierRepresentation
        ioGeneratedCode += " (" + sourceVar + ") ;\n"
      else
        ioGeneratedCode += self.mTargetCppName + ".mProperty_"
        ioGeneratedCode += propertyName.identifierRepresentation
        ioGeneratedCode += " = " + sourceVar + " ;\n"
      end
    case subcript (expressions, subcriptSignature) :
      var [@string] cppVarNameList = []
      for exp in expressions do
        exp.expression.generateExpression (
          !?ioGeneratedCode,
          !?ioInclusionSet,
          !?ioTemporaryVariableIndex,
          !?ioUnusedVariableCppNameSet,
          ?let cppVarName
        )
        cppVarNameList ++= cppVarName
      end
      cppVarNameList ++= sourceVar
      ioGeneratedCode += self.mTargetCppName + ".writeSubcript_"
      ioGeneratedCode += subcriptSignature.identifierRepresentation
      ioGeneratedCode += " ("
      for cppVar in cppVarNameList do
        ioGeneratedCode += cppVar + ", "
      end
      !?ioUnusedVariableCppNameSet.removeKey (compilerCppName ())
      ioGeneratedCode += compilerCppName () + " COMMA_HERE) ; \n"
    end
    !?ioUnusedVariableCppNameSet.removeKey (self.mTargetCppName)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
