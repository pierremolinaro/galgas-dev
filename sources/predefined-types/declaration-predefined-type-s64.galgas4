final class @s64PredefinedTypeAST : @predefinedTypeAST {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func getSupportedOperatorFlags () -> @typeFeatures {
    result = .infixAddOperator | .infixSubOperator | .infixMulOperator | .infixDivOperator
      | .infixModOperator | .infixShiftOperator | .prefixPlusOperator
      | .prefixMinusOperator | .prefixMinusOperatorNoOVF
      | .infixAndOperator | .infixOrOperator | .infixXorOperator | .prefixTildeOperator
      | .generateDescriptionGetterUtilityMethod | .comparable | .equatable
      | .infixAddOperatorNoOVF | .infixSubOperatorNoOVF | .infixMulOperatorNoOVF | .infixDivOperatorNoOVF
      | .plusAssignOperatorWithExpression | .minusAssignOperatorWithExpression
      | .mulAssignOperatorWithExpression | .divAssignOperatorWithExpression
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getClassFunctionMap (?!@unifiedTypeMap ioUnifiedTypeMap,
                                      !@classFunctionMap outMap ) {
    outMap = @()
    enterClassFunctionWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !name:"max",
      !resultTypeName:"s64",
      !hasLexiqueArg:false
    )
    enterClassFunctionWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !name:"min",
      !resultTypeName:"s64",
      !hasLexiqueArg:false
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getGetterMap (?!@unifiedTypeMap ioUnifiedTypeMap,
                               !@getterMap outMap ) {
    commonGetterMapForAllTypes (!?ioUnifiedTypeMap, ?outMap)
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName: "f64",
      !returnedTypeName: "f64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"u64",
      !returnedTypeName:"u64",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"s32",
      !returnedTypeName:"s32",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"uint",
      !returnedTypeName:"uint",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"bigint",
      !returnedTypeName:"bigint",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"string",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"hexString",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWith2Arguments (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"hexStringSeparatedBy",
      "char",
      "inSeparator",
      "uint",
      "inGroupCount",
      !returnedTypeName:"string",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"xString",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )

    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"canAdd", "s64", "inOperand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"canSubstract", "s64", "inOperand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"canMultiply", "s64", "inOperand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"canDivide", "s64", "inOperand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func cppDeclarationString () -> @string {
    result = @predefinedTypeGenerationTemplate.s64_type ()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

