proc appendPredefinedTypesASTs (?!@galgasDeclarationAST ioDeclarations) {
  ioDeclarations.mDeclarationList ++= @applicationPredefinedTypeAST (!isPredefined: true, "application")
  ioDeclarations.mDeclarationList ++= @bigintPredefinedTypeAST (!isPredefined: true, "bigint")
  ioDeclarations.mDeclarationList ++= @binarysetPredefinedTypeAST (!isPredefined: true, "binaryset")
  ioDeclarations.mDeclarationList ++= @boolPredefinedTypeAST (!isPredefined: true, "bool")
  ioDeclarations.mDeclarationList ++= @charPredefinedTypeAST (!isPredefined: true, "char")
  ioDeclarations.mDeclarationList ++= @dataPredefinedTypeAST (!isPredefined: true, "data")
  ioDeclarations.mDeclarationList ++= @doublePredefinedTypeAST (!isPredefined: true, "double")
  ioDeclarations.mDeclarationList ++= @filewrapperPredefinedTypeAST (!isPredefined: true, "filewrapper")
  ioDeclarations.mDeclarationList ++= @functionPredefinedTypeAST (!isPredefined: true, "function")
  ioDeclarations.mDeclarationList ++= @locationPredefinedTypeAST (!isPredefined: true, "location")
  ioDeclarations.mDeclarationList ++= @objectPredefinedTypeAST (!isPredefined: true, "object")
  ioDeclarations.mDeclarationList ++= @sintPredefinedTypeAST (!isPredefined: true, "sint")
  ioDeclarations.mDeclarationList ++= @sint64PredefinedTypeAST (!isPredefined: true, "sint64")
  ioDeclarations.mDeclarationList ++= @stringPredefinedTypeAST (!isPredefined: true, "string")
  appendPredefinedArrayTypeAST (!?ioDeclarations, "string")
  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "string")
  appendPredefinedArrayTypeAST (!?ioDeclarations, "lstring")
  ioDeclarations.mDeclarationList ++= @uintPredefinedTypeAST (!isPredefined: true, "uint")
  appendPredefinedArrayTypeAST (!?ioDeclarations, "uint")
  ioDeclarations.mDeclarationList ++= @stringsetPredefinedTypeAST (!isPredefined: true, "stringset")
  ioDeclarations.mDeclarationList ++= @timerPredefinedTypeAST (!isPredefined: true, "timer")
  ioDeclarations.mDeclarationList ++= @typePredefinedTypeAST (!isPredefined: true, "type")
  ioDeclarations.mDeclarationList ++= @uint64PredefinedTypeAST (!isPredefined: true, "uint64")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "function")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "luint")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "lstring")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "object")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "string")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "type")
  // appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "uint")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "uint64")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "bigint")
  appendPredefinedListTypeAST (!?ioDeclarations.mDeclarationList, "lbigint")

  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "bool")
  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "bigint")
  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "char")
  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "double")
  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "sint")
  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "sint64")
  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "uint")
  appendStructASTForTypeWithLocation (!?ioDeclarations.mDeclarationList, "uint64")

  appendPredefined2StringListTypeAST (!?ioDeclarations.mDeclarationList)

  appendStructASTForRangeType (!?ioDeclarations.mDeclarationList)
}

//--------------------------------------------------------------------------------------------------
//  A S T   C L A S S    F O R    P R E D E F I N E D   T Y P E S
//--------------------------------------------------------------------------------------------------

abstract class @predefinedTypeAST : @semanticDeclarationAST {
  public let @string mPredefinedTypeName

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  func typeKind () -> @typeKindEnum {
    result = .otherType
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  abstract func cppDeclarationString () -> @string

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  func initializers () -> [@formalInputParameterListAST] {
    result = @()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterDeclarationInGraph (
       ?!@semanticTypePrecedenceGraph ioSemanticTypePrecedenceGraph,
       ?!@equatableExtensionMap _ioEquatableExtensionMap,
       ?!@extensionInitializerForBuildingContext _ioExtensionInitializerForBuildingContext,
       ?!@extensionMethodMapForBuildingContext _ioExtensionMethodMapForBuildingContext,
       ?!@extensionGetterMapForBuildingContext _ioExtensionGetterMapForBuildingContext,
       ?!@extensionSetterMapForBuildingContext _ioExtensionSetterMapForBuildingContext,
       ?![@semanticDeclarationAST] _ioExtensionOverrideDefinitionList ) {
    let key = @lstring ("@" + self.mPredefinedTypeName, .nowhere)
    !?ioSemanticTypePrecedenceGraph.addNode (key, self)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterDeclarationInSemanticContext (
        ?!@equatableExtensionMap _ioEquatableExtensionMap,
        let @extensionInitializerForBuildingContext inExtensionInitializerMapForBuildingContext,
        let @extensionMethodMapForBuildingContext inExtensionMethodMapForBuildingContext,
        let @extensionGetterMapForBuildingContext inExtensionGetterMapForBuildingContext,
        let @extensionSetterMapForBuildingContext inExtensionSetterMapForBuildingContext,
        ?!@unifiedTypeMap ioTypeMap,
        ?!@semanticContext ioSemanticContext) {
    self.getClassFunctionMap (!?ioTypeMap, ?let @classFunctionMap constructorMap)
    self.getGetterMap (!?ioTypeMap, ?var @getterMap getterMap)
    self.getSetterMap (!?ioTypeMap, ?var @setterMap setterMap)
    self.getInstanceMethodMap (!?ioTypeMap, ?var @instanceMethodMap instanceMethodMap)
    self.getClassMethodMap (!?ioTypeMap, ?let @classMethodMap classMethodMap)
    self.getAddAssignArgumentList (!?ioTypeMap, ?let @functionSignature addAssignArgumentList)
    self.getEnumerationList (
      !?ioTypeMap,
      ?let @enumerationDescriptorList enumerationList,
      ?let @string enumeratedTypeName
    )
    !?ioTypeMap.makeEntryFromString (self.mPredefinedTypeName, ?*)
  //--- Enumeration
    let @unifiedTypeMapEntry enumeratedTypeEntry
    if enumeratedTypeName == "" then
      enumeratedTypeEntry = @unifiedTypeMapEntry.null
    else
      !?ioTypeMap.makeEntryFromString (enumeratedTypeName, ?enumeratedTypeEntry)
    end
  //--- Add Extensions
    var @initializerMap initializerMap = @()
    for initializer in self.initializers do
      var @functionSignature formalParameterList = @()
      for argument in initializer do
        formalParameterList ++= @(
          argument.mFormalSelector,
          ioTypeMap.typeMapEntryForLKey (argument.mFormalArgumentTypeName),
          argument.mFormalArgumentName.string,
          argument.mIsConstant
        )
      end
      !?initializerMap.insertKey (initializer.initializerSignature.nowhere, formalParameterList)
    end
    addExtensions (
      inExtensionInitializerMapForBuildingContext,
      inExtensionMethodMapForBuildingContext,
      inExtensionGetterMapForBuildingContext,
      inExtensionSetterMapForBuildingContext,
      !?ioSemanticContext,
      !?ioTypeMap,
      self.mPredefinedTypeName.nowhere,
      !isClass: false,
      !?initializerMap,
      !?getterMap,
      !?setterMap,
      !?instanceMethodMap,
      !acceptSetters: true
    )
  //---
    let typeDefinition = @unifiedTypeDefinition (
      !typeName: @lstring (self.mPredefinedTypeName, .nowhere),
      !isPredefined: self.isPredefined,
      !isConcrete: true,
      !isFinal: true,
      !superType: .null,
      !typeKind: self.typeKind,
      !supportCollectionValue: self.supportsCollectionValue,
      !allTypedPropertyList: @(),
      !propertyMap: @(),
      !currentTypedPropertyList: @(),
      !initializerMap: initializerMap,
      !classFunctionMap: constructorMap,
      !getterMap: getterMap,
      !setterMap: setterMap,
      !instanceMethodMap: instanceMethodMap,
      !classMethodMap: classMethodMap,
      !unwrappedType: .null,
      !readSubscriptMap: @(),
      !enumerationDescriptorList: enumerationList,
      !features: self.getSupportedOperatorFlags,
      !addAssignOperatorArguments: addAssignArgumentList,
      !generateHeaderInSeparateFile: false,
      !typeForEnumeratedElement: enumeratedTypeEntry,
      !headerFileName: "predefined-types",
      !headerKind: .twoHeaders
    )
    !?ioTypeMap.insertType (typeDefinition.typeName, typeDefinition)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc semanticAnalysis (
      ?![@lstring] ioUsefulnessRootEntities,
      ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
      let @string _inProductDirectory,
      let @semanticContext _inSemanticContext,
      ?!@unifiedTypeMap ioTypeMap,
      let @predefinedTypes _inPredefinedTypes,
      ?![@semanticDeclarationForGeneration] ioSemanticDeclarationListForGeneration ) {
   let selfType = ioTypeMap.typeMapEntryForLKey (@(self.mPredefinedTypeName, .here))
  //--- Useful entities graph
    let nameForUsefulness = typeNameForUsefulEntitiesGraph (@(self.mPredefinedTypeName, .here))
    !?ioUsefulEntitiesGraph.addNode (nameForUsefulness, nameForUsefulness)
    ioUsefulnessRootEntities ++= nameForUsefulness
  //--- Useful entities graph for initializer without any argument
    for initializer in selfType.definition.initializerMap do
      let initializerNameForUsefulness = initializerNameForUsefulEntitiesGraph (
        @(self.mPredefinedTypeName, .here),
        initializer.mArgumentTypeList.initializerSignature
      )
      !?ioUsefulEntitiesGraph.addNode (initializerNameForUsefulness, initializerNameForUsefulness)
      ioUsefulnessRootEntities ++= initializerNameForUsefulness
    end
  //---
    ioSemanticDeclarationListForGeneration ++= @primitiveTypeForGeneration (
      !infoMessage: "Predefined type " + self.mPredefinedTypeName,
      selfType,
      self.mPredefinedTypeName,
      self.cppDeclarationString,
      !isPackage: self.typeKind == .packageType
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  proc getClassFunctionMap (?!@unifiedTypeMap _ioUnifiedTypeMap,
                             !@classFunctionMap outClassFunctionMap ) {
    outClassFunctionMap = @()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  proc getGetterMap (?!@unifiedTypeMap _ioUnifiedTypeMap,
                      !@getterMap outGetterMap ) {
    outGetterMap = @()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  proc getSetterMap (?!@unifiedTypeMap _ioUnifiedTypeMap,
                      !@setterMap outSetterMap ) {
    outSetterMap = @()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  proc getInstanceMethodMap (?!@unifiedTypeMap _ioUnifiedTypeMap,
                              !@instanceMethodMap outInstanceMethodMap ) {
    outInstanceMethodMap = @()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  proc getClassMethodMap  (?!@unifiedTypeMap _ioUnifiedTypeMap,
                            !@classMethodMap outClassMethodMap ) {
    outClassMethodMap = @()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  func getSupportedOperatorFlags () -> @typeFeatures {
    result = @()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  func supportsCollectionValue () -> @bool {
    result = false // Does not support collection value
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  proc getAddAssignArgumentList (?!@unifiedTypeMap _ioUnifiedTypeMap,
                                  !@functionSignature outAddAssignArgumentList ) {
    outAddAssignArgumentList = @()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  proc getEnumerationList (?!@unifiedTypeMap _ioUnifiedTypeMap,
                            !@enumerationDescriptorList outEnumerationList,
                            !@string outEnumeratedType) {
    outEnumerationList = @() // Enumeration is not supported
    outEnumeratedType = "" // Enumeration is not supported
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

private proc appendPredefinedListTypeAST (?![@semanticDeclarationAST] ioDeclarationListASTs,
                                          let @string inElementTypeName) {
  var @propertyInCollectionListAST attributeList = @()
  attributeList ++= @(
    !mutability: .mutableProperty,
    inElementTypeName.nowhere,
    "mValue".nowhere,
    .publicAccess,
    !hasSelector: false,
    !initialization: .none
  )
  ioDeclarationListASTs ++= @listDeclarationAST (
    !isPredefined: true,
    (inElementTypeName + "list").nowhere,
    attributeList,
    !usefullList: true,
    !equatable: true
  )
}

//--------------------------------------------------------------------------------------------------

private proc appendPredefinedArrayTypeAST (?!@galgasDeclarationAST ioDeclarations,
                                           let @string inElementTypeName) {
  let arrayTypeName = makeArrayTypeName (inElementTypeName)
  ioDeclarations.implicitTypeDeclarationSet ++= arrayTypeName
  ioDeclarations.mDeclarationList ++= @arrayTypeDeclarationAST (
    !isPredefined: true,
    !arrayTypeName: arrayTypeName.nowhere,
    !elementTypeName: inElementTypeName.nowhere,
    !isUsefull: false,
    !equatable: false
  )
}

//--------------------------------------------------------------------------------------------------

private proc appendPredefined2StringListTypeAST (?![@semanticDeclarationAST] ioDeclarationListASTs) {
  var attributeList = @propertyInCollectionListAST ()
  attributeList ++= @(
    !mutability: .mutableProperty,
    "string".nowhere,
    "mValue0".nowhere,
    .publicAccess,
    !hasSelector: false,
    !initialization: .none
  )
  attributeList ++= @(
    !mutability: .mutableProperty,
    "string".nowhere,
    "mValue1".nowhere,
    .publicAccess,
    !hasSelector: false,
    !initialization: .none
  )

  ioDeclarationListASTs ++= @listDeclarationAST (
    !isPredefined: true,
    @lstring ("2stringlist", @location.here),
    attributeList,
    !usefullList: true,
    !equatable: true
  )
}

//--------------------------------------------------------------------------------------------------

private proc appendStructASTForTypeWithLocation (?![@semanticDeclarationAST] ioDeclarationListASTs,
                                                 let @string inElementTypeName) {
  var attributeList = @propertyInCollectionListAST ()
  attributeList ++= @(
    !mutability: .mutableProperty,
    @lstring (inElementTypeName, @location.here),
    @lstring (inElementTypeName, @location.here),
    .publicAccess,
    !hasSelector: false,
    !initialization: .none
  )
  attributeList ++= @(
    !mutability: .mutableProperty,
    @lstring ("location", @location.here),
    @lstring ("location", @location.here),
    .publicAccess,
    !hasSelector: false,
    !initialization: .none
  )
  let type = @structDeclarationAST (
    !isPredefined: true,
    @lstring ("l" + inElementTypeName, @location.here),
    attributeList,
    !enumeratedElementTypeName: "",
    !comparison: .equatable,
    !isUsefullStruct: true
  )
  ioDeclarationListASTs ++= type
}

//--------------------------------------------------------------------------------------------------

private proc appendStructASTForRangeType (?![@semanticDeclarationAST] ioDeclarationListASTs) {
  var @propertyInCollectionListAST attributeList = @()
  attributeList ++= @(
    !mutability: .mutableProperty,
    @lstring ("uint", @location.here),
    @lstring ("start", @location.here),
    .publicAccess,
    !hasSelector: false,
    !initialization: .none
  )
  attributeList ++= @(
    !mutability: .mutableProperty,
    @lstring ("uint", @location.here),
    @lstring ("length", @location.here),
    .publicAccess,
    !hasSelector: false,
    !initialization: .none
  )
  ioDeclarationListASTs ++= @structDeclarationAST (
    !isPredefined: true,
    @lstring ("range", @location.here),
    attributeList,
    !enumeratedElementTypeName: "uint",
    !comparison: .equatable,
    !isUsefullStruct: true
  )
}

