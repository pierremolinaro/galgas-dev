final class @doublePredefinedTypeAST : @predefinedTypeAST {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func getSupportedOperatorFlags () -> @typeFeatures {
    result = .infixAddOperator | .infixSubOperator | .infixMulOperator | .infixDivOperator
      | .prefixPlusOperator | .prefixMinusOperator | .infixModOperator | .infixDivOperatorNoOVF
      | .generateDescriptionGetterUtilityMethod | .comparable | .equatable
      | .plusAssignOperatorWithExpression | .minusAssignOperatorWithExpression
      | .mulAssignOperatorWithExpression | .divAssignOperatorWithExpression
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getGetterMap (?!@unifiedTypeMap ioUnifiedTypeMap,
                               !@getterMap outMap ) {
    commonGetterMapForAllTypes (!?ioUnifiedTypeMap, ?outMap)
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"string",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"u32",
      !returnedTypeName:"u32",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"s32",
      !returnedTypeName:"s32",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"u64",
      !returnedTypeName:"u64",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"s64",
      !returnedTypeName:"s64",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"cos",
      !returnedTypeName: "f64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"sin",
      !returnedTypeName: "f64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"tan",
      !returnedTypeName: "f64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"log10",
      !returnedTypeName: "f64",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"log2",
      !returnedTypeName: "f64",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"logn",
      !returnedTypeName: "f64",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"exp",
      !returnedTypeName: "f64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"cosDegree",
      !returnedTypeName: "f64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"sinDegree",
      !returnedTypeName: "f64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"tanDegree",
      !returnedTypeName: "f64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"sqrt",
      !returnedTypeName: "f64",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"power", "f64", "inExponant",
      !returnedTypeName: "f64",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"binaryImage",
      !returnedTypeName:"u64",
      !hasCompilerArgument:false
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getClassFunctionMap (?!@unifiedTypeMap ioUnifiedTypeMap,
                                      !@classFunctionMap outMap ) {
    outMap = @()
    enterClassFunctionWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !name:"pi",
      !resultTypeName: "f64",
      !hasLexiqueArg:false
    )
    enterClassFunctionWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !name:"doubleWithBinaryImage",
      !argTypeName:"u64",
      !argName:"inBinaryImage",
      !resultTypeName: "f64",
      !hasLexiqueArg:false
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func cppDeclarationString () -> @string {
    result = @predefinedTypeGenerationTemplate.f64_type ()
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

