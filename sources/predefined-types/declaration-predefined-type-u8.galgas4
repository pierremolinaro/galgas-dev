final class @u8PredefinedTypeAST : @predefinedTypeAST {

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func cppDeclarationString () -> @string {
    result = filewrapper [predefinedTypeGenerationTemplate.u8_type : ]
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func getSupportedOperatorFlags () -> @typeFeatures {
    result = .infixAddOperator | .infixSubOperator | .infixMulOperator | .infixDivOperator
      | .infixModOperator | .infixShiftOperator | .prefixPlusOperator
      | .infixAndOperator | .infixOrOperator | .infixXorOperator | .prefixTildeOperator
      | .generateDescriptionGetterUtilityMethod | .comparable | .equatable
      | .infixAddOperatorNoOVF | .infixSubOperatorNoOVF | .infixMulOperatorNoOVF | .infixDivOperatorNoOVF
      | .plusAssignOperatorWithExpression | .minusAssignOperatorWithExpression
      | .mulAssignOperatorWithExpression | .divAssignOperatorWithExpression
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getClassFunctionMap (?!@unifiedTypeMap ioUnifiedTypeMap,
                                      !@classFunctionMap outMap ) {
    outMap = @()
    enterClassFunctionWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !name: "max",
      !resultTypeName: "u8",
      !hasLexiqueArg:false
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getGetterMap (?!@unifiedTypeMap ioUnifiedTypeMap,
                               !@getterMap outMap ) {
    commonGetterMapForAllTypes (!?ioUnifiedTypeMap, ?outMap)
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"double",
      !returnedTypeName:"double",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"sint",
      !returnedTypeName:"sint",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"s64",
      !returnedTypeName:"s64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"bigint",
      !returnedTypeName:"bigint",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"u64",
      !returnedTypeName:"u64",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"lsbIndex",
      !returnedTypeName:"u8",
      !hasCompilerArgument:true
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"significantBitCount",
      !returnedTypeName:"u8",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"oneBitCount",
      !returnedTypeName:"u8",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"string",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"hexString",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
//    enterBaseFinalGetterWith2Arguments (
//      !?outMap,
//      !?ioUnifiedTypeMap,
//      !getterName:"hexStringSeparatedBy",
//      "char",
//      "inSeparator",
//      "u8",
//      "inGroupCount",
//      !returnedTypeName:"string",
//      !hasCompilerArgument:true
//    )
    enterBaseFinalGetterWithoutArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"xString",
      !returnedTypeName:"string",
      !hasCompilerArgument:false
    )
//    enterBaseFinalGetterWithoutArgument (
//      !?outMap,
//      !?ioUnifiedTypeMap,
//      !getterName:"isUnicodeValueAssigned",
//      !returnedTypeName:"bool",
//      !hasCompilerArgument:false
//    )
//    enterBaseFinalGetterWithArgument (
//      !?outMap,
//      !?ioUnifiedTypeMap,
//      !getterName:"isInRange", "range", "inRange",
//      !returnedTypeName:"bool",
//      !hasCompilerArgument:false
//    )
    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"canAdd", "u8", "inOperand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"canSubstract", "u8", "inOperand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"canMultiply", "u8", "inOperand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
    enterBaseFinalGetterWithArgument (
      !?outMap,
      !?ioUnifiedTypeMap,
      !getterName:"canDivide", "u8", "inOperand",
      !returnedTypeName:"bool",
      !hasCompilerArgument:false
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc getClassMethodMap (?!@unifiedTypeMap _ioUnifiedTypeMap,
                                   !@classMethodMap outClassMethodMap) {
    outClassMethodMap = @()
//    enterClassMethodWithInputArgument (
//      !?outClassMethodMap,
//      !?ioUnifiedTypeMap,
//      !methodName:"setRandomSeed",
//      !argType:"u8",
//      !argName:"inSeed",
//      !compilerArgument:false
//    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

