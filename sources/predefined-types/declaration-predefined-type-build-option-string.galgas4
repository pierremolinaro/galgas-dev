final class @buildOptionInvocationStringDeclarationAST : @semanticDeclarationAST {
  private let @lstring buildOptionStringName #initArgLabel
  private let @string buildOptionValueName #initArgLabel

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override func keyRepresentation () -> @string {
    result = "build option @" + self.buildOptionStringName
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterDeclarationInGraph (
        ?!@semanticTypePrecedenceGraph ioSemanticTypePrecedenceGraph,
        ?!@equatableExtensionMap _ioEquatableExtensionMap,
        ?!@extensionInitializerForBuildingContext _ioExtensionInitializerForBuildingContext,
        ?!@extensionMethodMapForBuildingContext _ioExtensionMethodMapForBuildingContext,
        ?!@extensionGetterMapForBuildingContext _ioExtensionGetterMapForBuildingContext,
        ?!@extensionSetterMapForBuildingContext _ioExtensionSetterMapForBuildingContext,
        ?![@semanticDeclarationAST] _ioExtensionOverrideDefinitionList ) {
    let key = @lstring ("@" + self.buildOptionStringName, self.buildOptionStringName.location)
    !?ioSemanticTypePrecedenceGraph.addNode (key, self)
    let dep = @lstring ("@" + self.buildOptionValueName, self.buildOptionStringName.location)
    !?ioSemanticTypePrecedenceGraph.addEdge (!from: key, !to: dep)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc enterDeclarationInSemanticContext (
        ?!@equatableExtensionMap _ioEquatableExtensionMap,
        let @extensionInitializerForBuildingContext _inExtensionInitializerMapForBuildingContext,
        let @extensionMethodMapForBuildingContext _inExtensionMethodMapForBuildingContext,
        let @extensionGetterMapForBuildingContext _inExtensionGetterMapForBuildingContext,
        let @extensionSetterMapForBuildingContext _inExtensionSetterMapForBuildingContext,
        ?!@unifiedTypeMap ioTypeMap,
        ?!@semanticContext ioSemanticContext) {
  //---
    !?ioTypeMap.makeEntry ("string".nowhere, ?let stringType)
    var @classFunctionMap classFunctionMap = @()
    for boolOption in ioSemanticContext.projectSettings.boolBuildOptionArray do
      !?classFunctionMap.insertKey (boolOption.mIdentifier, [], false, stringType)
    end  
    for stringOption in ioSemanticContext.projectSettings.stringBuildOptionArray do
      !?classFunctionMap.insertKey (stringOption.mIdentifier, [], false, stringType)
    end  
    for u32Option in ioSemanticContext.projectSettings.u32BuildOptionArray do
      !?classFunctionMap.insertKey (u32Option.mIdentifier, [], false, stringType)
    end  
  //---
    let @setterMap setterMap = @()
    let @instanceMethodMap instanceMethodMap = @()
    let @getterMap getterMap = @()
    let @initializerMap initializerMap = @()
    let features = @typeFeatures ()
  //--- Enter type in type map
    let typeDefinition = @unifiedTypeDefinition (
      !typeName: self.buildOptionStringName,
      !isPredefined: self.isPredefined,
      !isConcrete: true,
      !isFinal: true,
      !superType: .null,
      !typeKind: .packageType,
      !supportArrayLiteral: false,
      !allTypedPropertyList: @(),
      !propertyMap: @(),
      !currentTypedPropertyList: @(),
      !initializerMap: initializerMap,
      !classFunctionMap: classFunctionMap,
      !getterMap: getterMap,
      !setterMap: setterMap,
      !instanceMethodMap: instanceMethodMap,
      !classMethodMap: @(),
      !unwrappedType: .null,
      !readSubscriptMap: @(),
      !writeSubscriptMap: @(),
      !enumerationDescriptorList: @(),
      !features: features,
      !generateHeaderInSeparateFile: false,
      !typeForEnumeratedElement: .null,
      !headerFileName: "option-" + self.buildOptionStringName.string.fileNameRepresentation,
      !headerKind: .oneHeader
    )
    !?ioTypeMap.insertType (typeDefinition.typeName, typeDefinition)
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc semanticAnalysis (?![@lstring] ioUsefulnessRootEntities,
                                  ?!@usefulEntitiesGraph ioUsefulEntitiesGraph,
                                  let @string _inProductDirectory,
                                  let @semanticContext inSemanticContext,
                                  ?!@unifiedTypeMap ioTypeMap,
                                  let @predefinedTypes _inPredefinedTypes,
                                  ?![@semanticDeclarationForGeneration] ioSemanticDeclarationListForGeneration) {
  //--- Useful entities graph
    let nameForUsefulness = typeNameForUsefulEntitiesGraph (self.buildOptionStringName)
    !?ioUsefulEntitiesGraph.addNode (nameForUsefulness, nameForUsefulness)
    if self.isPredefined  then
      ioUsefulnessRootEntities ++= nameForUsefulness
    end
  //---
    let selfType = ioTypeMap.typeMapEntryForLKey (self.buildOptionStringName)
    ioSemanticDeclarationListForGeneration ++= @buildOptionStringTypeForGeneration (
      !infoMessage: "build option string " + self.buildOptionStringName,
      selfType,
      !boolBuildOptionArray: inSemanticContext.projectSettings.boolBuildOptionArray,
      !u32BuildOptionArray: inSemanticContext.projectSettings.u32BuildOptionArray,
      !stringBuildOptionArray: inSemanticContext.projectSettings.stringBuildOptionArray
    )
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------
//!  CODE GENERATION
//--------------------------------------------------------------------------------------------------

final class @buildOptionStringTypeForGeneration : @semanticTypeForGeneration {
  public let [@projectBuildOption] boolBuildOptionArray #initArgLabel
  public let [@projectBuildOption] u32BuildOptionArray #initArgLabel
  public let [@projectBuildOption] stringBuildOptionArray #initArgLabel

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc appendDeclaration1 (?!@stringset _ioInclusionSet,
                                    !@string outHeader) {
    let selfTypeDefinition = self.mSelfTypeEntry.definition
    outHeader = filewrapper [buildOptionStringGenerationTemplate.buildOptionTypeHeader1 :
      selfTypeDefinition.typeName.string,
      selfTypeDefinition.typeName.string.identifierRepresentation
    ]
    outHeader += filewrapper [typeGenerationTemplate.unifiedClassBodyForPackage :
      selfTypeDefinition.typeName.string,
      self.mSelfTypeEntry.identifierRepresentation,
      selfTypeDefinition.classFunctionMap,
      selfTypeDefinition.classMethodMap
    ]
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

  override proc appendSpecificImplementation (let @unifiedTypeMap _inTypeMap,
                                              ?!@stringset ioInclusionSet,
                                              !@string outImplementation) {
    self.mSelfTypeEntry.addHeaderFileName (!?ioInclusionSet)
    let selfTypeDefinition = self.mSelfTypeEntry.definition
    outImplementation = filewrapper [buildOptionStringGenerationTemplate.buildOptionTypeSpecificImplementation :
      selfTypeDefinition.typeName.string,
      selfTypeDefinition.typeName.string.identifierRepresentation,
      self.boolBuildOptionArray,
      self.u32BuildOptionArray,
      self.stringBuildOptionArray
    ]
  }

  // - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

}

//--------------------------------------------------------------------------------------------------

filewrapper buildOptionStringGenerationTemplate in "../+generation-templates/type_generation" {
}{
}{
  template buildOptionTypeHeader1 : "buildOptionString.h1.galgasTemplate" (
    ?@string TYPE_NAME,
    ?@string TYPE_IDENTIFIER
  )

  template buildOptionTypeSpecificImplementation : "buildOptionString.cpp.galgasTemplate" (
    ?@string TYPE_NAME,
    ?@string TYPE_IDENTIFIER,
    ?[@projectBuildOption] BOOL_OPTION_ARRAY,
    ?[@projectBuildOption] UINT_OPTION_ARRAY,
    ?[@projectBuildOption] STRING_OPTION_ARRAY
  )
}

