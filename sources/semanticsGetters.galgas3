    !?ioGetterMap.insertOrReplace
      (!@lstring (!inObsoleteGetterName, .here),
      !@methodKind.definedAsMember,
      !@functionSignature (),
      !@location.here,
      !inHasCompilerArgument,
      !returnedTypeIndex,
