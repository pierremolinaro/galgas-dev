//--------------------------------------------------------------------------------------------------

extension @semanticDeclarationAST {
  abstract func keyRepresentation () -> @string
}

//--------------------------------------------------------------------------------------------------

override func @galgas3SyntaxComponentAST.keyRepresentation () -> @string {
  result = "syntax " + self.mSyntaxComponentName
}

//--------------------------------------------------------------------------------------------------

override func @predefinedTypeAST.keyRepresentation () -> @string {
  result = "predefined type @" + self.mPredefinedTypeName
}

//--------------------------------------------------------------------------------------------------

override func @externFunctionDeclarationAST.keyRepresentation () -> @string {
  result = "extern function " + self.mFunctionName
}

//--------------------------------------------------------------------------------------------------
//
//    E N T E R    T Y P E S
//
//--------------------------------------------------------------------------------------------------

proc addExtensions (let @extensionInitializerForBuildingContext inExtensionInitializerMapForBuildingContext,
     let @extensionMethodMapForBuildingContext inExtensionMethodMapForBuildingContext,
     let @extensionGetterMapForBuildingContext inExtensionGetterMapForBuildingContext,
     let @extensionSetterMapForBuildingContext inExtensionSetterMapForBuildingContext,
     ?!@semanticContext _ioSemanticContext,
     ?!@unifiedTypeMap ioTypeMap,
     let @lstring inTypeName,
     ?isClass: let @bool inIsClass,
     ?!@initializerMap ioInitializerMap,
     ?!@getterMap ioGetterMap,
     ?!@setterMap ioSetterMap,
     ?!@instanceMethodMap ioInstanceMethodMap,
     ?acceptSetters: let @bool inAcceptSetters ) {
//-----------------------  Extension getters
  if inExtensionGetterMapForBuildingContext.contains (inTypeName.string) then
    inExtensionGetterMapForBuildingContext.searchKey (inTypeName, ?let extensionGetterMapForType)
    for extensionGetter in extensionGetterMapForType do
      var [@functionSignatureElement] formalArgumentList = @()
      for formalInputArgument in extensionGetter.mInputFormalParameterList do
        !?ioTypeMap.makeEntry (formalInputArgument.mFormalArgumentTypeName, ?let typeIndex)
        formalArgumentList ++= @(
          formalInputArgument.mFormalSelector,
          typeIndex,
          formalInputArgument.mFormalArgumentName.string,
          formalInputArgument.mIsConstant)
      end
      !?ioTypeMap.makeEntry (extensionGetter.mResultTypeName, ?let returnedType)
      if extensionGetter.mQualifier == .isVirtualOverriding then
        if ioGetterMap.contains (extensionGetter.lkey) then
          !?ioGetterMap.setMQualifierForKey (.isVirtualOverriding, extensionGetter.lkey)
        end
      elsif extensionGetter.mQualifier == .isVirtualOverridingAbstract then
        if ioGetterMap.contains (extensionGetter.lkey) then
          !?ioGetterMap.setMQualifierForKey (.isVirtualOverridingAbstract, extensionGetter.lkey)
        end
      elsif inIsClass & (extensionGetter.mQualifier == .isBasic) then
        !?ioGetterMap.insertKey (
          extensionGetter.lkey,
          .definedAsExtension,
          formalArgumentList,
          extensionGetter.lkey.location,
          true,
          returnedType,
          .isVirtual,
          "" // func name is not obsolete, no replacement func
        )
      else
        !?ioGetterMap.insertKey (
          extensionGetter.lkey,
          .definedAsExtension,
          formalArgumentList,
          extensionGetter.lkey.location,
          true,
          returnedType,
          extensionGetter.mQualifier,
          "" // func name is not obsolete, no replacement func
        )
      end
    end
  end
//-----------------------  Extension methods
  if inExtensionMethodMapForBuildingContext.contains (inTypeName.string) then
    inExtensionMethodMapForBuildingContext.searchKey (inTypeName, ?let extensionMethodMapForType)
    for extensionMethod in extensionMethodMapForType do
      var formalArgumentList = [@formalParameterSignatureElement] ()
      for parameter in extensionMethod.mFormalParameterList do
        !?ioTypeMap.makeEntry (
          parameter.mFormalArgumentTypeName,
          ?let @unifiedTypeMapEntry typeIndex
        )
        formalArgumentList ++= @(
          parameter.mFormalSelector,
          typeIndex,
          parameter.mFormalArgumentPassingMode,
          parameter.mFormalArgumentName.string)
      end
      if extensionMethod.mQualifier == .isVirtualOverriding then
        if ioInstanceMethodMap.contains (extensionMethod.lkey) then
          !?ioInstanceMethodMap.setMQualifierForKey (.isVirtualOverriding, extensionMethod.lkey)
        end
      elsif extensionMethod.mQualifier == .isVirtualOverridingAbstract then
        if ioInstanceMethodMap.contains (extensionMethod.lkey) then
          !?ioInstanceMethodMap.setMQualifierForKey (.isVirtualOverridingAbstract, extensionMethod.lkey)
        end
      elsif inIsClass & (extensionMethod.mQualifier == .isBasic) then
        !?ioInstanceMethodMap.insertKey (
          extensionMethod.lkey,
          .definedAsExtension,
          formalArgumentList,
          extensionMethod.lkey.location,
          true,
          .isVirtual,
          "" // No Error message
        )
      else
        !?ioInstanceMethodMap.insertKey (
          extensionMethod.lkey,
          @methodKind.definedAsExtension,
          formalArgumentList,
          extensionMethod.lkey.location,
          true,
          extensionMethod.mQualifier,
          "" // No error message
        )
      end
    end
  end
//-----------------------  Extension setters
  if inExtensionSetterMapForBuildingContext.contains (inTypeName.string) then
    inExtensionSetterMapForBuildingContext.searchKey (inTypeName, ?let extensionSetterMapForType)
    for extensionSetter in extensionSetterMapForType do
      var [@formalParameterSignatureElement] formalArgumentList = @()
      for parameter in extensionSetter.mFormalParameterList do
        !?ioTypeMap.makeEntry (parameter.mFormalArgumentTypeName, ?let typeIndex)
        formalArgumentList ++= @(
          parameter.mFormalSelector,
          typeIndex,
          parameter.mFormalArgumentPassingMode,
          parameter.mFormalArgumentName.string)
      end
      !?ioSetterMap.insertKey (
        extensionSetter.lkey,
        @methodKind.definedAsExtension,
        formalArgumentList,
        true,
        @methodQualifier.isBasic,
        "" // No Error message
      )
      if not inAcceptSetters then
        error extensionSetter.lkey : "a class does not accept any mutating proc; use proc instead"
      end
    end
  end
//-----------------------  Extension initializers
  if inExtensionInitializerMapForBuildingContext.contains (inTypeName.string) then
    inExtensionInitializerMapForBuildingContext.searchKey (inTypeName, ?let initializerMapForType)
    for initializer in initializerMapForType do
      var [@functionSignatureElement] formalArgumentList = @()
      for formal in initializer.mFormalParameterList do
        !?ioTypeMap.makeEntry (formal.mFormalArgumentTypeName, ?let typeIndex)
        formalArgumentList ++= @(formal.mFormalSelector, typeIndex, formal.mFormalArgumentName.string, formal.mIsConstant)
      end
      !?ioInitializerMap.insertKey (initializer.lkey, formalArgumentList)
    end
  end
}

//--------------------------------------------------------------------------------------------------
//! enterInSemanticContext
//--------------------------------------------------------------------------------------------------

override proc @externFunctionDeclarationAST.enterDeclarationInSemanticContext // Handles also function declaration
  (?!@equatableExtensionMap _ioEquatableExtensionMap,
  let @extensionInitializerForBuildingContext _inExtensionInitializerMapForBuildingContext,
  let @extensionMethodMapForBuildingContext _inExtensionMethodMapForBuildingContext,
  let @extensionGetterMapForBuildingContext _inExtensionGetterMapForBuildingContext,
  let @extensionSetterMapForBuildingContext _inExtensionSetterMapForBuildingContext,
                                ?!@unifiedTypeMap ioTypeMap,
  ?!@semanticContext ioSemanticContext ) {
//--- Build signature
  var functionSignature = [@functionSignatureElement] ()
  for formal in self.mFormalArgumentList do
    !?ioTypeMap.makeEntry (formal.mFormalArgumentTypeName, ?let parameterTypeIndex)
    functionSignature ++= @(formal.mFormalSelector, parameterTypeIndex, formal.mFormalArgumentTypeName.string, formal.mIsConstant)
  end
//--- Result type
  !?ioTypeMap.makeEntry  (self.mResultTypeName, ?let resultTypeIndex)
//--- Enter function in routine map
  !?ioSemanticContext.mFunctionMap.insertKey
    (self.mFunctionName,
    functionSignature,
    resultTypeIndex,
    false // Is not internal
  )
}

//--------------------------------------------------------------------------------------------------

override proc @galgas3SyntaxComponentAST.enterDeclarationInSemanticContext
  (?!@equatableExtensionMap _ioEquatableExtensionMap,
  let @extensionInitializerForBuildingContext _inExtensionInitializerMapForBuildingContext,
  let @extensionMethodMapForBuildingContext _inExtensionMethodMapForBuildingContext,
  let @extensionGetterMapForBuildingContext _inExtensionGetterMapForBuildingContext,
  let @extensionSetterMapForBuildingContext _inExtensionSetterMapForBuildingContext,
                                ?!@unifiedTypeMap _ioTypeMap,
  ?!@semanticContext ioSemanticContext
) {
  !?ioSemanticContext.mSyntaxComponentMapForSemanticAnalysis.insertKey
    (self.mSyntaxComponentName,
    self.mLexiqueName,
    self.mNonterminalDeclarationList,
    self.mRuleList,
    self.mHasTranslateFeature
  )
}

//--------------------------------------------------------------------------------------------------

override proc @galgas3GrammarComponentAST.enterDeclarationInSemanticContext
  (?!@equatableExtensionMap _ioEquatableExtensionMap,
  let @extensionInitializerForBuildingContext _inExtensionInitializerMapForBuildingContext,
  let @extensionMethodMapForBuildingContext _inExtensionMethodMapForBuildingContext,
  let @extensionGetterMapForBuildingContext _inExtensionGetterMapForBuildingContext,
  let @extensionSetterMapForBuildingContext _inExtensionSetterMapForBuildingContext,
                                ?!@unifiedTypeMap ioTypeMap,
  ?!@semanticContext ioSemanticContext
) {
//--- Analyze start symbol labels
  var @grammarLabelMap grammarLabelMap = @()
  for startSymbolLabel in self.mStartSymbolLabelList do
  //--- Analyze signature
    var [@formalParameterSignatureElement] formalArgumentList = @()
    for formal in startSymbolLabel.mFormalArgumentList do
      !?ioTypeMap.makeEntry (formal.mFormalArgumentTypeName, ?let argumentType)
      formalArgumentList ++= @(
        formal.mFormalSelector,
        argumentType,
        formal.mFormalArgumentPassingMode,
        formal.mFormalArgumentName.string)
    end
    !?grammarLabelMap.insertKey (
      startSymbolLabel.mLabelName,
      formalArgumentList
    )
  end
//--- Insert grammar in grammar map
  !?ioSemanticContext.mGrammarMap.insertGrammar
    (self.mGrammarComponentName,
    grammarLabelMap,
    self.mHasIndexing.bool,
    self.mHasTranslateFeature
  )
}

