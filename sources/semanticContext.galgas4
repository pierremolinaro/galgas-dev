func @location.sourceFile () -> @string {
  if self.isNowhere then
    result = "SOURCE_FILE (\"\", 0)"
  else
    result = "SOURCE_FILE (" + self.file.lastPathComponent.utf8RepresentationEscapingQuestionMark + ", " + self.startLine + ")"
  end
}

//--------------------------------------------------------------------------------------------------

func @location.commaSourceFile () -> @string {
  result = " COMMA_" + self.sourceFile
}

//--------------------------------------------------------------------------------------------------

let @string gCompilerCppName = "inCompiler"

//--------------------------------------------------------------------------------------------------

let @string gSyntaxDirectedTranslationResultVarName = "ioSyntaxDirectedTranslationResult"

//--------------------------------------------------------------------------------------------------

extension [@semanticInstructionAST] {
 
  proc enterInstructionListInSemanticContext (?!@unifiedTypeMap ioTypeMap) {
    for instruction in self do
      instruction.enterInstructionInSemanticContext (!?ioTypeMap)
    end
  }

}

