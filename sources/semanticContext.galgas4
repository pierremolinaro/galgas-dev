func @location.sourceFile () -> @string {
  if self.isNowhere then
    result = "SOURCE_FILE (\"\", 0)"
  else
    result = "SOURCE_FILE (" + self.file.lastPathComponent.utf8RepresentationEscapingQuestionMark + ", " + self.startLine + ")"
  end
}

//--------------------------------------------------------------------------------------------------

func @location.commaSourceFile () -> @string {
  result = " COMMA_" + self.sourceFile
}

//--------------------------------------------------------------------------------------------------

func %once compilerCppName () ->@string {
  result = "inCompiler"
}

//--------------------------------------------------------------------------------------------------

func %once syntaxDirectedTranslationResultVarName () ->@string {
  result = "ioSyntaxDirectedTranslationResult"
}

//--------------------------------------------------------------------------------------------------

abstract proc @semanticInstructionAST.enterInstructionInSemanticContext (?!@unifiedTypeMap ioTypeMap)

//--------------------------------------------------------------------------------------------------

abstract proc @semanticExpressionAST.enterExpressionInSemanticContext (?!@unifiedTypeMap ioTypeMap)

//--------------------------------------------------------------------------------------------------

proc @semanticInstructionListAST.enterInstructionListInSemanticContext
  (?!@unifiedTypeMap ioTypeMap
) {
  for (mInstruction) in self do
    mInstruction.enterInstructionInSemanticContext (!?ioTypeMap)
  end
}

