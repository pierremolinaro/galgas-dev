//--------------------------------------------------------------------------------------------------

filewrapper generationTemplate in "."
{}{}{
  template svg : "logo-svg.galgasTemplate" (
    ?@string TITLE,
    ?@string DRAWINGS
  )
}

//--------------------------------------------------------------------------------------------------

map @routineMap {
  public let [@instruction] mInstructionList
  #insertSetter insertKey #errorMessage "the '%K' routine has been already declared"
  #searchMethod searchKey #errorMessage "the '%K' routine is not declared"
}

//--------------------------------------------------------------------------------------------------

abstract class @instruction {
}

//--------------------------------------------------------------------------------------------------

abstract proc @instruction.codeDisplay
  (?!@bool ioPenDown,
  ?!@double _ioX,
  ?!@double _ioY,
  ?!@double _ioAngle,
  ?!@string _SVG)

//--------------------------------------------------------------------------------------------------

//list @instructionList {
//  public let @instruction mInstruction
//}

//--------------------------------------------------------------------------------------------------

final class @penUp : @instruction {
}

//--------------------------------------------------------------------------------------------------

override proc @penUp.codeDisplay
  (?!@bool ioPenDown,
  ?!@double _ioX,
  ?!@double _ioY,
  ?!@double _ioAngle,
  ?!@string _SVG
) {
  ioPenDown = false
}

//--------------------------------------------------------------------------------------------------

final class @penDown : @instruction {
}

//--------------------------------------------------------------------------------------------------

override proc @penDown.codeDisplay
  (?!@bool ioPenDown,
  ?!@double _ioX,
  ?!@double _ioY,
  ?!@double _ioAngle,
  ?!@string _SVG
) {
  ioPenDown = true
}

//--------------------------------------------------------------------------------------------------

final class @rotate : @instruction {
  public let @luint mAngle
}

//--------------------------------------------------------------------------------------------------

override proc @rotate.codeDisplay
  (?!@bool _ioPenDown,
  ?!@double _ioX,
  ?!@double _ioY,
  ?!@double ioAngle,
  ?!@string _SVG
) {
  ioAngle = ioAngle + self.mAngle.uint.double
}

//--------------------------------------------------------------------------------------------------

final class @forward : @instruction {
  public let @luint mLength
}

//--------------------------------------------------------------------------------------------------

override proc @forward.codeDisplay
  (?!@bool ioPenDown,
  ?!@double ioX,
  ?!@double ioY,
  ?!@double ioAngle,
  ?!@string SVG
) {
  let @double x = ioX + self.mLength.double () * ioAngle.cosDegree
  let @double y = ioY + self.mLength.double () * ioAngle.sinDegree
  if ioPenDown then
    SVG += "<line x1=\"" + ioX + "\" y1=\"" + ioY + "\" x2=\"" + x + "\" y2=\""
        + y + "\" style=\"stroke:#1F56D2\" stroke-linecap=\"round\" />\n"
  end
  ioX = x
  ioY = y
}

//--------------------------------------------------------------------------------------------------
