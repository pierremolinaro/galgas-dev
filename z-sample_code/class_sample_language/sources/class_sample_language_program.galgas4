

before {
}

case . "classSampleLanguage"
#errorMessage "an '.class_sample_language' source file"
grammar class_sample_language_grammar
?sourceFilePath:@lstring inSourceFile {
//--- Build Abstract Syntax Tree
  grammar class_sample_language_grammar (?let declarationListAST) in inSourceFile
//--- Build dependence graph
  var inheritanceGraph = @inheritanceGraph ()
  for declaration in  declarationListAST do
    declaration.buildGraph (!?inheritanceGraph)
  end
//--- Undefined classes ?
  if inheritanceGraph.undefinedNodeCount > 0 then
    for nodeName in inheritanceGraph.undefinedNodeReferenceList do
      error (nodeName : "the '" + nodeName + "' class is not declared")
    end
  else
  //--- Topologic sort
    inheritanceGraph.topologicalSort
      (?let [@declarationAST] sortedDeclarationListAST,
      ?*,
      ?*,
      ?let circularDefinitionClassNameList
    )
    if circularDefinitionClassNameList.count > 0 then
      for nodeName in  circularDefinitionClassNameList do
        error (nodeName : "the '" + nodeName + "' class is involved in a circular definition")
      end
    else
    //--- Generate code
      var @string codeToGenerate = ""
      for declaration in  sortedDeclarationListAST do
        declaration.generateCode (!?codeToGenerate)
      end
      let @string targetFile = inSourceFile.deletingPathExtension() + ".cpp"
      codeToGenerate.writeToFile (targetFile)
    end
  end
}

after {
}