

extern proc testsuite_hand_coded ()

extension [@string] : #equatable {
}

proc testsuite_list() {
  var strList = [@string] []
  !?strList.append ("a")
  !?strList.append ("b")
  !?strList.append ("c")
  !?strList.append ("d")
  println ("*************************************** begin of list direct access")
  var @string s = strList [0]
  log s
  s = strList [1]
  log s
  s = strList [2]
  log s
  s = strList [3]
  log s
  !?strList.set ("z", !at: 3)
  log strList
  println ("--- test .= operator on list")
  strList += strList
  log s
  println ("*************************************** begin of list compare")
  let aList = [@string] ["az"]
  let bList = [@string] ["az"]
  let @bool comp = aList == bList
  log comp
  println ("*************************************** begin of collection value")
  var s1 = [@string] ["a"]
  !?s1.append ("b")
  var s2 = [@string] ["c"]
  !?s2.append ("d")
  s2 += ["e"]
  let str = s1 + s2
  log str
  let str2 = [@string] ["a", "b", "c", "d", "e"]
  log str2
}

