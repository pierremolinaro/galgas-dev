

//--------------------------------------------------------------------------*

extern @complex {
  "// No Predeclaration\n"
}{
  "  private : bool mIsValid ;\n"
  "  private : double mReal ;\n"
  "  private : double mImaginary ;\n"
}{
  init (@f64 real, @f64 imaginary)
  func real () -> @f64
  func imaginary () -> @f64
}

//--------------------------------------------------------------------------*

proc testsuite_extern_type() {
  println ("*************************************** begin of extern type test")
  let complex = @complex (1.0, -1.0)
  println (complex.description)
  print ("real") ; println (complex.real.description)
  print ("imaginary") ; println (complex.imaginary.description)
}

